      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">InvitationRules</string>
          <string name="Source"><![CDATA[-- Pure invitation state. User IDs are integers (Studio uses negative IDs).
-- All clocks are monotone and supplied by the caller; no Roblox dependencies.
local InvitationRules = {}

local function validId(id)
    return type(id) == "number" and id == id and id ~= math.huge and id ~= -math.huge
        and id ~= 0 and id % 1 == 0
end

local function release(state, invite)
    state.Invites[invite.Id] = nil
    for _, id in ipairs(invite.Members) do
        if state.Reserved[id] == invite.Id then state.Reserved[id] = nil end
    end
end

function InvitationRules.New(cooldownSeconds, expiresSeconds)
    return {
        CooldownSeconds = cooldownSeconds or 15, ExpiresSeconds = expiresSeconds or 25,
        Invites = {}, Reserved = {}, Cooldowns = {}, Serial = 0,
    }
end

function InvitationRules.Get(state, userId)
    local inviteId = state.Reserved[userId]
    return inviteId and state.Invites[inviteId] or nil
end

function InvitationRules.CooldownUntil(state, userId)
    return state.Cooldowns[userId] or 0
end

function InvitationRules.Expire(state, now)
    local expired = {}
    for _, invite in pairs(state.Invites) do
        if now >= invite.ExpiresAt then table.insert(expired, invite) end
    end
    for _, invite in ipairs(expired) do release(state, invite) end
    return #expired
end

function InvitationRules.Create(state, hostId, mode, memberIds, now, available, arenaBusy)
    InvitationRules.Expire(state, now)
    if arenaBusy then return nil, "ArenaBusy" end
    if not validId(hostId) then return nil, "InvalidPlayer" end
    if now < InvitationRules.CooldownUntil(state, hostId) then return nil, "InviteCooldown" end
    local size = mode == "Duel" and 2 or (mode == "Teams" and 4 or nil)
    if not size or type(memberIds) ~= "table" or #memberIds ~= size or memberIds[1] ~= hostId then
        return nil, "InvalidMembers"
    end
    local seen, members = {}, {}
    for index = 1, size do
        local id = memberIds[index]
        if not validId(id) or seen[id] then return nil, "InvalidMembers" end
        if state.Reserved[id] then return nil, "PlayerBusy" end
        if not available(id) then return nil, "PlayerUnavailable" end
        seen[id], members[index] = true, id
    end
    state.Serial += 1
    local invite = {
        Id = "invite:" .. tostring(state.Serial), HostId = hostId, Mode = mode,
        Members = members, Accepted = { [hostId] = true }, ExpiresAt = now + state.ExpiresSeconds,
    }
    state.Invites[invite.Id] = invite
    for _, id in ipairs(members) do state.Reserved[id] = invite.Id end
    state.Cooldowns[hostId] = now + state.CooldownSeconds
    return invite, nil
end

function InvitationRules.Respond(state, userId, inviteId, accept, now)
    if type(inviteId) ~= "string" or #inviteId > 64 or type(accept) ~= "boolean" then
        return nil, "InvalidResponse", false
    end
    local invite = state.Invites[inviteId]
    if not invite or state.Reserved[userId] ~= inviteId or userId == invite.HostId then
        return nil, "UnknownInvite", false
    end
    if now >= invite.ExpiresAt then
        release(state, invite)
        return nil, "Expired", false
    end
    if not accept then
        release(state, invite)
        return invite, "Declined", false
    end
    invite.Accepted[userId] = true
    for _, id in ipairs(invite.Members) do
        if not invite.Accepted[id] then return invite, nil, false end
    end
    -- The caller consumes this result synchronously before yielding. Removing
    -- reservations here prevents an accepted invitation from becoming stale.
    release(state, invite)
    return invite, nil, true
end

function InvitationRules.Cancel(state, hostId, inviteId)
    if type(inviteId) ~= "string" or #inviteId > 64 then return false, "UnknownInvite" end
    local invite = state.Invites[inviteId]
    if not invite or invite.HostId ~= hostId then return false, "UnknownInvite" end
    release(state, invite)
    return true, nil
end

function InvitationRules.RemovePlayer(state, userId)
    local invite = InvitationRules.Get(state, userId)
    if invite then release(state, invite) end
    state.Cooldowns[userId] = nil
    return invite ~= nil
end

function InvitationRules.Clear(state)
    state.Invites, state.Reserved = {}, {}
end

return InvitationRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">MatchRules</string>
          <string name="Source"><![CDATA[-- Portable roster rules: no Roblox globals, clock, or side effects.
local MatchRules = {}

function MatchRules.New(teamOrder, teamSize)
    assert(type(teamOrder) == "table" and #teamOrder >= 2, "At least two teams are required")
    assert(type(teamSize) == "number" and teamSize >= 1 and teamSize % 1 == 0, "Invalid team size")
    local order, teams = {}, {}
    for _, teamId in ipairs(teamOrder) do
        assert(type(teamId) == "string" and not teams[teamId], "Invalid or duplicate team")
        teams[teamId] = true
        table.insert(order, teamId)
    end
    return { TeamOrder = order, TeamSize = teamSize, Members = {}, Teams = teams, Locked = false, Started = false }
end

function MatchRules.Get(roster, id)
    return roster.Members[id]
end

function MatchRules.Add(roster, id, teamId)
    if roster.Locked then return false, "Locked" end
    if id == nil or (type(id) == "number" and id ~= id) then return false, "InvalidId" end
    if roster.Members[id] then return false, "Duplicate" end
    if not roster.Teams[teamId] then return false, "UnknownTeam" end
    local count = 0
    for _, member in pairs(roster.Members) do
        if member.TeamId == teamId then count += 1 end
    end
    if count >= roster.TeamSize then return false, "TeamFull" end
    roster.Members[id] = { Id = id, TeamId = teamId, Ready = false, Eliminated = false }
    return true
end

function MatchRules.Lock(roster)
    if roster.Locked then return false, "AlreadyLocked" end
    local counts = {}
    for _, teamId in ipairs(roster.TeamOrder) do counts[teamId] = 0 end
    for _, member in pairs(roster.Members) do counts[member.TeamId] += 1 end
    for _, teamId in ipairs(roster.TeamOrder) do
        if counts[teamId] ~= roster.TeamSize then return false, "Incomplete" end
    end
    roster.Locked = true
    return true
end

function MatchRules.SetReady(roster, id, ready)
    local member = roster.Members[id]
    if not member then return false, "UnknownMember" end
    if roster.Started then return false, "Started" end
    if member.Eliminated then return false, "Eliminated" end
    member.Ready = ready == true
    return true
end

function MatchRules.IsReady(roster)
    if not roster.Locked then return false end
    for _, member in pairs(roster.Members) do
        if not member.Ready or member.Eliminated then return false end
    end
    return true
end

function MatchRules.Begin(roster)
    if roster.Started then return false, "AlreadyStarted" end
    if not MatchRules.IsReady(roster) then return false, "NotReady" end
    roster.Started = true
    return true
end

function MatchRules.Eliminate(roster, id)
    local member = roster.Members[id]
    if not member then return false, "UnknownMember" end
    if member.Eliminated then return false, "AlreadyEliminated" end
    member.Eliminated = true
    return true
end

function MatchRules.CountAlive(roster)
    local alive = {}
    for _, teamId in ipairs(roster.TeamOrder) do alive[teamId] = 0 end
    for _, member in pairs(roster.Members) do
        if not member.Eliminated then alive[member.TeamId] += 1 end
    end
    return alive
end

function MatchRules.Resolve(roster)
    if not roster.Started then return false, nil end
    local alive = MatchRules.CountAlive(roster)
    local remaining, winner = 0, nil
    for _, teamId in ipairs(roster.TeamOrder) do
        if alive[teamId] > 0 then
            remaining += 1
            winner = teamId
        end
    end
    if remaining > 1 then return false, nil end
    return true, winner
end

return MatchRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ProfileRules</string>
          <string name="Source"><![CDATA[-- Portable, synchronous profile rules. Only the server supplies the catalog,
-- reward values and match IDs; no client amount can enter these functions.
local Rules = {}
local MAX_INTEGER = 2147483647
local REWARD_HISTORY = 100

local function integer(value)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then return 0 end
    return math.max(0, math.min(MAX_INTEGER, math.floor(value)))
end

local function validId(value)
    return type(value) == "string" and #value > 0 and #value <= 128
end

function Rules.New(catalog)
    return {
        Version = 1, Coins = 0, OwnedSwords = { [catalog.DefaultSword] = true },
        EquippedSword = catalog.DefaultSword, FactionId = catalog.DefaultFaction,
        Wins = 0, Losses = 0, RewardedMatches = {}, RewardOrder = {},
    }
end

function Rules.Sanitize(raw, catalog)
    local profile = Rules.New(catalog)
    if type(raw) ~= "table" then return profile end
    profile.Coins, profile.Wins, profile.Losses = integer(raw.Coins), integer(raw.Wins), integer(raw.Losses)
    if type(raw.OwnedSwords) == "table" then
        for id in pairs(catalog.Swords) do
            if raw.OwnedSwords[id] == true then profile.OwnedSwords[id] = true end
        end
    end
    if validId(raw.EquippedSword) and profile.OwnedSwords[raw.EquippedSword] then
        profile.EquippedSword = raw.EquippedSword
    end
    if validId(raw.FactionId) and catalog.Factions[raw.FactionId] then profile.FactionId = raw.FactionId end
    -- Persist a bounded, ordered replay ledger. The service also deduplicates
    -- all matches for the lifetime of its server, without evicting old IDs.
    if type(raw.RewardOrder) == "table" and type(raw.RewardedMatches) == "table" then
        local start = math.max(1, #raw.RewardOrder - REWARD_HISTORY + 1)
        for index = start, #raw.RewardOrder do
            local id = raw.RewardOrder[index]
            if validId(id) and raw.RewardedMatches[id] == true and not profile.RewardedMatches[id] then
                profile.RewardedMatches[id] = true
                table.insert(profile.RewardOrder, id)
            end
        end
    end
    return profile
end

function Rules.Buy(profile, swordId, catalog)
    if not validId(swordId) or not catalog.Swords[swordId] then return false, "UnknownSword" end
    if profile.OwnedSwords[swordId] then return false, "AlreadyOwned" end
    local price = catalog.Swords[swordId].Price
    if type(price) ~= "number" or price < 0 or price % 1 ~= 0 or price > MAX_INTEGER then return false, "InvalidPrice" end
    if profile.Coins < price then return false, "InsufficientCoins" end
    profile.Coins -= price
    profile.OwnedSwords[swordId] = true
    return true
end

function Rules.Equip(profile, swordId, catalog)
    if not validId(swordId) or not catalog.Swords[swordId] then return false, "UnknownSword" end
    if not profile.OwnedSwords[swordId] then return false, "NotOwned" end
    profile.EquippedSword = swordId
    return true
end

function Rules.ChooseFaction(profile, factionId, catalog)
    if not validId(factionId) or not catalog.Factions[factionId] then return false, "UnknownFaction" end
    profile.FactionId = factionId
    return true
end

function Rules.Reward(profile, matchId, outcome, rewards)
    if not validId(matchId) then return false, "InvalidMatch" end
    if outcome ~= "Win" and outcome ~= "Loss" and outcome ~= "Draw" then return false, "InvalidOutcome" end
    local amount = rewards[outcome]
    if type(amount) ~= "number" or amount < 0 or amount % 1 ~= 0 or amount > MAX_INTEGER then return false, "InvalidReward" end
    if profile.RewardedMatches[matchId] then return false, "AlreadyRewarded" end
    profile.Coins = math.min(MAX_INTEGER, profile.Coins + amount)
    if outcome == "Win" then profile.Wins = math.min(MAX_INTEGER, profile.Wins + 1) end
    if outcome == "Loss" then profile.Losses = math.min(MAX_INTEGER, profile.Losses + 1) end
    profile.RewardedMatches[matchId] = true
    table.insert(profile.RewardOrder, matchId)
    if #profile.RewardOrder > REWARD_HISTORY then
        local oldest = table.remove(profile.RewardOrder, 1)
        profile.RewardedMatches[oldest] = nil
    end
    return true
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">WorldRules</string>
          <string name="Source"><![CDATA[-- Pure rules for the original kingdom world. All timing and tuning come from
-- the authoritative server; these values are not verified reference-game data.
local Rules = {}

local function finite(value)
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function quantity(value)
    return finite(value) and value >= 0 and value % 1 == 0
end

local function timestamp(value)
    return finite(value) and value >= 0
end

local function knownKingdom(id, config)
    return type(id) == "string" and config.Kingdoms[id] ~= nil
end

local function worldPlayer(player)
    return type(player) == "table" and quantity(player.Wood) and quantity(player.Ore)
        and (finite(player.LastHarvestAt) or player.LastHarvestAt == -math.huge)
        and (finite(player.LastKingdomAt) or player.LastKingdomAt == -math.huge)
end

local function nodeDefinition(kind, config)
    if kind ~= "Tree" and kind ~= "Mine" then return nil end
    local definition = config.World[kind]
    if type(definition) ~= "table" or not quantity(definition.Hits) or definition.Hits == 0
        or not quantity(definition.Yield) or not finite(definition.RespawnSeconds)
        or definition.RespawnSeconds < 0 then return nil end
    return definition
end

local function validNode(node, config)
    if type(node) ~= "table" then return nil end
    local definition = nodeDefinition(node.Kind, config)
    if not definition or not quantity(node.HitsRemaining) or node.HitsRemaining > definition.Hits
        or not timestamp(node.RespawnAt) then return nil end
    return definition
end

function Rules.NewPlayer()
    return {
        KingdomId = nil, Wood = 0, Ore = 0,
        LastHarvestAt = -math.huge, LastKingdomAt = -math.huge,
    }
end

function Rules.ChooseKingdom(player, kingdomId, config, now)
    if not worldPlayer(player) then return false, "InvalidPlayer" end
    if not timestamp(now) then return false, "InvalidTime" end
    if not knownKingdom(kingdomId, config) then return false, "UnknownKingdom" end
    if player.KingdomId == kingdomId then return false, "AlreadyKingdom" end
    if now - player.LastKingdomAt < config.World.KingdomChangeCooldown then
        return false, "KingdomCooldown"
    end
    player.KingdomId, player.LastKingdomAt = kingdomId, now
    return true
end

function Rules.NewNode(kind, config)
    local definition = nodeDefinition(kind, config)
    if not definition then return nil, "UnknownNodeKind" end
    return { Kind = kind, HitsRemaining = definition.Hits, RespawnAt = 0 }
end

function Rules.CanHarvest(player, node, config, now)
    if not worldPlayer(player) then return false, "InvalidPlayer" end
    if not timestamp(now) then return false, "InvalidTime" end
    if not knownKingdom(player.KingdomId, config) then return false, "ChooseKingdom" end
    local definition = validNode(node, config)
    if not definition then return false, "InvalidNode" end
    if node.HitsRemaining == 0 then return false, "Depleted" end
    if now - player.LastHarvestAt < config.World.HarvestCooldown then
        return false, "HarvestCooldown"
    end
    local resource = node.Kind == "Tree" and "Wood" or "Ore"
    -- Validate both final mutations before accepting the strike. This also
    -- keeps malformed server state from spending a hit and losing its reward.
    if not quantity(player[resource] + definition.Yield)
        or not timestamp(now + definition.RespawnSeconds) then return false, "InvalidPlayer" end
    return true
end

function Rules.Harvest(player, node, config, now)
    local accepted, reason = Rules.CanHarvest(player, node, config, now)
    if not accepted then return false, reason end
    local definition = nodeDefinition(node.Kind, config)
    local depleted = node.HitsRemaining == 1
    local resource = node.Kind == "Tree" and "Wood" or "Ore"
    local amount = depleted and definition.Yield or 0
    -- No yield occurs between the hit, cooldown and reward mutations.
    node.HitsRemaining -= 1
    player.LastHarvestAt = now
    if depleted then
        node.RespawnAt = now + definition.RespawnSeconds
        player[resource] += amount
    end
    return true, { Depleted = depleted, Resource = resource, Amount = amount }
end

function Rules.RefreshNode(node, config, now)
    if not timestamp(now) then return false end
    local definition = validNode(node, config)
    if not definition or node.HitsRemaining ~= 0 or now < node.RespawnAt then return false end
    node.HitsRemaining, node.RespawnAt = definition.Hits, 0
    return true
end

function Rules.NewOutpost()
    return { Owner = nil, Claimant = nil, Progress = 0, Contested = false, Built = false }
end

local function validOutpost(point, config)
    return type(point) == "table" and finite(point.Progress) and point.Progress >= 0 and point.Progress <= 1
        and type(point.Contested) == "boolean" and type(point.Built) == "boolean"
        and (point.Owner == nil or knownKingdom(point.Owner, config))
        and (point.Claimant == nil or knownKingdom(point.Claimant, config))
end

function Rules.StepCapture(point, kingdomCounts, config, dt)
    if not finite(dt) or dt <= 0 or not validOutpost(point, config)
        or type(kingdomCounts) ~= "table" or not finite(config.World.CaptureSeconds)
        or config.World.CaptureSeconds <= 0 then return false end
    local present, onlyKingdom = 0, nil
    for kingdomId, count in pairs(kingdomCounts) do
        if knownKingdom(kingdomId, config) and quantity(count) and count > 0 then
            present += 1
            onlyKingdom = kingdomId
        end
    end
    local owner, claimant, progress = point.Owner, point.Claimant, point.Progress
    local contested, built = point.Contested, point.Built
    point.Contested = present > 1
    if present < 2 then
        local advance = dt / config.World.CaptureSeconds
        if present == 1 and onlyKingdom ~= point.Owner then
            if point.Claimant ~= onlyKingdom then
                point.Claimant, point.Progress = onlyKingdom, 0
            end
            point.Progress = math.min(1, point.Progress + advance)
            if point.Progress >= 1 then
                point.Owner, point.Claimant, point.Progress = onlyKingdom, nil, 0
                point.Built = false
            end
        else
            point.Progress = math.max(0, point.Progress - advance)
            if point.Progress == 0 then point.Claimant = nil end
        end
    end
    return owner ~= point.Owner or claimant ~= point.Claimant or progress ~= point.Progress
        or contested ~= point.Contested or built ~= point.Built
end

function Rules.BuildOutpost(player, point, config)
    if not worldPlayer(player) then return false, "InvalidPlayer" end
    if not validOutpost(point, config) then return false, "InvalidOutpost" end
    if not knownKingdom(player.KingdomId, config) or point.Owner ~= player.KingdomId then
        return false, "NotOwner"
    end
    if point.Built then return false, "AlreadyBuilt" end
    if point.Contested then return false, "Contested" end
    local woodCost, oreCost = config.World.OutpostWoodCost, config.World.OutpostOreCost
    if not quantity(woodCost) or not quantity(oreCost) then return false, "InvalidCost" end
    if player.Wood < woodCost then return false, "InsufficientWood" end
    if player.Ore < oreCost then return false, "InsufficientOre" end
    player.Wood, player.Ore = player.Wood - woodCost, player.Ore - oreCost
    point.Built = true
    return true
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">MedievalServer</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("MedievalShared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Rules = require(Shared:WaitForChild("CombatRules"))

local CombatService = {}
CombatService.__index = CombatService

local function isPlayer(subject)
    return typeof(subject) == "Instance" and subject:IsA("Player")
end

local function finiteVector(vector)
    return typeof(vector) == "Vector3"
        and Rules.IsFinite(vector.X)
        and Rules.IsFinite(vector.Y)
        and Rules.IsFinite(vector.Z)
end

local function horizontalDirection(vector)
    if not finiteVector(vector) then
        return nil
    end
    -- A bound also avoids overflow when normalizing malicious remote input.
    if math.abs(vector.X) > 1000000 or math.abs(vector.Y) > 1000000 or math.abs(vector.Z) > 1000000 then
        return nil
    end
    local flat = Vector3.new(vector.X, 0, vector.Z)
    if flat.Magnitude < 0.001 then
        return nil
    end
    return flat.Unit
end

local function swordPart(model, name, size, color, material)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = model
    return part
end

local function weldTo(part, anchor, frame)
    part.CFrame = anchor.CFrame * frame
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = anchor
    weld.Part1 = part
    weld.Parent = part
    return part
end

local function selectedAppearance(subject)
    local swordId = Catalog.DefaultSword
    local factionId = Catalog.DefaultFaction
    if isPlayer(subject) then
        local equipped = subject:GetAttribute("EquippedSword")
        local faction = subject:GetAttribute("KingdomId") or subject:GetAttribute("FactionId")
        if type(equipped) == "string" and Catalog.Swords[equipped] then
            swordId = equipped
        end
        if type(faction) == "string" and Catalog.Factions[faction] then
            factionId = faction
        end
    end
    return swordId, factionId
end

local function clearAppearance(model)
    -- Motors live under a rig's hand, rather than under the cosmetic model.
    -- Remove them first so no joint retains a destroyed Part1 after a refresh.
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant.Name == "FerSwordGrip" and descendant:IsA("Motor6D") then
            descendant:Destroy()
        end
    end
    for _, child in ipairs(model:GetChildren()) do
        if child.Name == "FerSword" or child.Name == "FerFaction" then
            child:Destroy()
        end
    end
end

local function buildSword(model, swordId)
    local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
    if not hand or not hand:IsA("BasePart") then
        return nil
    end
    local sword = Instance.new("Model")
    sword.Name = "FerSword"
    sword:SetAttribute("SwordId", swordId)
    local cosmetic = Catalog.Swords[swordId]
    local bladeColor = Color3.fromRGB(table.unpack(cosmetic.Blade))
    local guardColor = Color3.fromRGB(table.unpack(cosmetic.Guard))
    local accentColor = Color3.fromRGB(table.unpack(cosmetic.Accent))
    local handle = swordPart(sword, "Grip", Vector3.new(0.23, 0.75, 0.23), accentColor, Enum.Material.Wood)
    local isR6 = hand.Name == "Right Arm"
    local gripFrame = CFrame.new(0, isR6 and -0.85 or -0.15, -0.35) * CFrame.Angles(-math.pi / 2, 0, 0)
    handle.CFrame = hand.CFrame * gripFrame
    for _, specification in ipairs({
        { "Pommel", Vector3.new(0.36, 0.2, 0.36), -0.42, guardColor, Enum.Material.Metal },
        { "Guard", Vector3.new(1.05, 0.16, 0.3), 0.45, guardColor, Enum.Material.Metal },
        { "Blade", Vector3.new(0.36, 2.8, 0.12), 1.9, bladeColor, Enum.Material.Metal },
        { "Tip", Vector3.new(0.24, 0.38, 0.12), 3.48, bladeColor:Lerp(Color3.new(1, 1, 1), 0.2), Enum.Material.Metal },
    }) do
        local part = swordPart(sword, specification[1], specification[2], specification[4], specification[5])
        weldTo(part, handle, CFrame.new(0, specification[3], 0))
    end
    -- Every blade, tip and grip has the same dimensions. These decorations
    -- remain inside the common silhouette and have no hitbox or combat stats.
    local jewel = swordPart(sword, "Emblem", Vector3.new(0.2, 0.3, 0.18), accentColor, Enum.Material.Metal)
    local jewelFrame = CFrame.new(0, 0.52, -0.16)
    if cosmetic.Style == "Cross" then
        local cross = swordPart(sword, "Cross", Vector3.new(0.42, 0.09, 0.08), accentColor, Enum.Material.Metal)
        weldTo(cross, handle, CFrame.new(0, 0.54, -0.23))
    elseif cosmetic.Style == "Fang" then
        jewelFrame = jewelFrame * CFrame.Angles(0, 0, math.pi / 4)
    elseif cosmetic.Style == "Wolf" then
        for _, side in ipairs({ -1, 1 }) do
            local fang = swordPart(sword, "Fang", Vector3.new(0.09, 0.3, 0.08), accentColor, Enum.Material.Metal)
            weldTo(fang, handle, CFrame.new(side * 0.28, 0.55, -0.18) * CFrame.Angles(0, 0, side * 0.35))
        end
    elseif cosmetic.Style == "Eye" then
        jewel.Shape = Enum.PartType.Ball
        jewel.Size = Vector3.new(0.26, 0.26, 0.18)
        jewel.Material = Enum.Material.Neon
    end
    weldTo(jewel, handle, jewelFrame)
    sword.PrimaryPart = handle
    sword.Parent = model
    local joint = Instance.new("Motor6D")
    joint.Name = "FerSwordGrip"
    joint.Part0 = hand
    joint.Part1 = handle
    joint.C0 = gripFrame
    joint.Parent = hand
    return sword, joint, gripFrame
end

local function buildFaction(model, factionId)
    local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
    if not torso or not torso:IsA("BasePart") then
        return nil
    end
    local faction = Catalog.Factions[factionId]
    local armor = Instance.new("Model")
    armor.Name = "FerFaction"
    armor:SetAttribute("FactionId", factionId)
    local color = Color3.fromRGB(table.unpack(faction.Color))
    local trim = Color3.fromRGB(table.unpack(faction.Trim))
    local width = torso.Size.X
    local height = torso.Size.Y
    local front = -torso.Size.Z / 2 - 0.08
    local function detail(name, size, frame, detailColor, material)
        local part = swordPart(armor, name, size, detailColor or trim, material or Enum.Material.Metal)
        weldTo(part, torso, frame)
        return part
    end
    detail("Cuirass", Vector3.new(width * 0.96, height * 0.86, 0.15), CFrame.new(0, 0, front), color)
    detail("Belt", Vector3.new(width, 0.14, 0.17), CFrame.new(0, -height * 0.32, front - 0.06))
    if factionId == "Redcliff" then
        detail("StandardVertical", Vector3.new(0.15, height * 0.65, 0.08), CFrame.new(0, 0.04, front - 0.12))
        detail("StandardHorizontal", Vector3.new(width * 0.55, 0.15, 0.08), CFrame.new(0, height * 0.12, front - 0.12))
    elseif factionId == "Korblox" then
        for _, side in ipairs({ -1, 1 }) do
            detail("IceStripe", Vector3.new(0.13, height * 0.6, 0.08), CFrame.new(side * width * 0.2, 0.02, front - 0.12) * CFrame.Angles(0, 0, side * 0.5))
        end
        detail("Crystal", Vector3.new(0.27, 0.27, 0.12), CFrame.new(0, height * 0.15, front - 0.14) * CFrame.Angles(0, 0, math.pi / 4), trim, Enum.Material.Neon)
    elseif factionId == "Greywolf" then
        detail("WolfBadge", Vector3.new(width * 0.28, height * 0.3, 0.1), CFrame.new(0, height * 0.12, front - 0.12))
        for _, side in ipairs({ -1, 1 }) do
            detail("WolfFang", Vector3.new(0.12, height * 0.23, 0.1), CFrame.new(side * width * 0.12, -height * 0.1, front - 0.12) * CFrame.Angles(0, 0, side * 0.2))
        end
    elseif factionId == "Overseer" then
        local eye = detail("Eye", Vector3.new(width * 0.45, height * 0.25, 0.13), CFrame.new(0, height * 0.12, front - 0.12), trim, Enum.Material.Neon)
        eye.Shape = Enum.PartType.Ball
        local pupil = detail("Pupil", Vector3.new(0.15, height * 0.19, 0.1), CFrame.new(0, height * 0.12, front - 0.2), color)
        pupil.Shape = Enum.PartType.Ball
    end
    armor.Parent = model
    return armor
end

local function buildAppearance(subject, model)
    clearAppearance(model)
    local swordId, factionId = selectedAppearance(subject)
    local sword, joint, grip = buildSword(model, swordId)
    local faction = buildFaction(model, factionId)
    return sword, joint, grip, faction
end

function CombatService.new(remotes)
    return setmetatable({
        _remotes = remotes,
        _states = {},
        _enabled = false,
        OnDeath = nil,
    }, CombatService)
end

function CombatService:DressCharacter(player, model)
    if typeof(model) ~= "Instance" or not model:IsA("Model") then
        return nil, "InvalidCharacter"
    end
    local state = self._states[player]
    if state and state.Model == model then
        return nil, "RegisteredCombatant"
    end
    -- Lobby equipment is visual only. Do not register the character, write
    -- attributes for resources, heal it or change its movement properties.
    return buildAppearance(player, model)
end

function CombatService:_effect(kind, payload)
    self._remotes.Effects:FireAllClients(kind, payload)
end

function CombatService:_sync(state, now)
    if not state.Model.Parent then
        return
    end
    state.Model:SetAttribute("Combatant", true)
    state.Model:SetAttribute("TeamId", state.TeamId)
    state.Model:SetAttribute("Stamina", math.floor(state.Stamina * 10 + 0.5) / 10)
    state.Model:SetAttribute("MaxStamina", Config.Combat.MaxStamina)
    state.Model:SetAttribute("Sprinting", state.Sprinting)
    state.Model:SetAttribute("SpawnProtected", not state.Dead and now < state.SpawnProtectedUntil)
    state.Model:SetAttribute("PotionReadyAt", state.PotionReadyAt or 0)
    state.Model:SetAttribute("PotionCooldown", Config.PotionCooldown)
    local serverNow = Workspace:GetServerTimeNow()
    state.Model:SetAttribute("AttackReadyAt", serverNow + math.max(0, state.LastAttackAt + Config.Combat.AttackCooldown - now))
    local lastCombat = math.max(state.LastDamagedAt, state.LastAttackAt, state.LastWorkAt)
    state.Model:SetAttribute("HealthRegenReadyAt", serverNow + math.max(0, lastCombat + Config.Player.HealthRegenDelay - now))
    for _, size in ipairs(Config.PotionOrder) do
        state.Model:SetAttribute("Potions" .. size, state.Potions[size])
    end
end

function CombatService:_markDead(state)
    if state.Dead then
        return
    end
    state.Dead = true
    state.Sprinting = false
    state.PendingAttack = nil
    self:_sync(state, os.clock())
    local killer = state.LastAttacker
    if killer and os.clock() - (state.LastHitAt or -math.huge) > 10 then
        killer = nil
    end
    self:_effect("Death", { Actor = state.Model, Position = state.Root.Position, TeamId = state.TeamId })
    -- Match callbacks may schedule respawns or end the round. They run outside
    -- the damage iteration, which leaves this service's table stable.
    task.defer(function()
        if self.OnDeath then
            local ok, problem = pcall(self.OnDeath, state, killer)
            if not ok then
                warn("Combat death callback failed: " .. tostring(problem))
            end
        end
    end)
end

function CombatService:Register(subject, model, teamId)
    self:Unregister(subject)
    if typeof(model) ~= "Instance" or not model:IsA("Model") or Config.Teams[teamId] == nil then
        return nil
    end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or not root:IsA("BasePart") or humanoid.Health <= 0 then
        return nil
    end
    local now = os.clock()
    local state = Rules.NewState(Config, now)
    state.Subject = subject
    state.Model = model
    state.Humanoid = humanoid
    state.Root = root
    state.TeamId = teamId
    state.RateTokens = Config.Combat.MaxActionRate
    state.RateUpdatedAt = now
    state.NextAttributeAt = 0
    state.PotionReadyAt = 0
    state.Sword, state.SwordJoint, state.SwordGrip, state.Faction = buildAppearance(subject, model)
    humanoid.MaxHealth = Config.Player.MaxHealth
    humanoid.Health = Config.Player.MaxHealth
    humanoid.WalkSpeed = Config.Player.WalkSpeed
    state.LastObservedHealth = humanoid.Health
    state.DeathConnection = humanoid.Died:Connect(function()
        self:_markDead(state)
    end)
    local previousHealth = humanoid.Health
    state.DamageConnection = humanoid.HealthChanged:Connect(function(health)
        if health < previousHealth then state.LastDamagedAt = os.clock() end
        previousHealth = health
    end)
    self._states[subject] = state
    if isPlayer(subject) then
        subject:SetAttribute("TeamId", teamId)
    end
    self:_sync(state, now)
    return state
end

function CombatService:Unregister(subject)
    local state = self._states[subject]
    if not state then
        return
    end
    self._states[subject] = nil
    if state.DeathConnection then
        state.DeathConnection:Disconnect()
    end
    if state.DamageConnection then state.DamageConnection:Disconnect() end
    if state.SwordTween then
        state.SwordTween:Cancel()
        state.SwordTween = nil
    end
    if state.SwordJoint then
        state.SwordJoint:Destroy()
    end
    if state.Sword then
        state.Sword:Destroy()
    end
    if state.Faction then
        state.Faction:Destroy()
    end
    if state.Model.Parent then
        state.Model:SetAttribute("Combatant", false)
        state.Model:SetAttribute("Sprinting", false)
    end
end

function CombatService:GetState(subject)
    return self._states[subject]
end

function CombatService:GetStates()
    return self._states
end

function CombatService:SetEnabled(enabled)
    self._enabled = enabled == true
    if not self._enabled then
        for _, state in pairs(self._states) do
            state.PendingAttack = nil
            state.Sprinting = false
            if state.Humanoid.Parent and not state.Dead then
                state.Humanoid.WalkSpeed = Config.Player.WalkSpeed
            end
            self:_sync(state, os.clock())
        end
    end
end

function CombatService:_swing(state, side)
    if not state.SwordJoint or not state.SwordJoint.Parent then
        return
    end
    if state.SwordTween then
        state.SwordTween:Cancel()
    end
    -- The same horizontal path and its mirror are the only attacks. Rotation
    -- around the grip's local Z axis sweeps the blade left/right on R6 and R15.
    -- It holds at the finish, which is the next attack's starting position.
    -- Only this Motor6D moves: character locomotion stays entirely available.
    state.SwordJoint.C0 = state.SwordGrip * CFrame.Angles(0, 0, 1.15 * side)
    local finish = state.SwordGrip * CFrame.Angles(0, 0, -1.15 * side)
    state.SwordTween = TweenService:Create(state.SwordJoint, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { C0 = finish })
    state.SwordTween:Play()
end

function CombatService:Act(subject, action, payload)
    local state = self._states[subject]
    if not state then
        return false, "UnknownCombatant"
    end
    local now = os.clock()
    state.RateTokens = math.min(Config.Combat.MaxActionRate, state.RateTokens + (now - state.RateUpdatedAt) * Config.Combat.MaxActionRate)
    state.RateUpdatedAt = now
    if state.RateTokens < 1 then
        return false, "RateLimited"
    end
    state.RateTokens = state.RateTokens - 1
    if type(action) ~= "string" or type(payload) ~= "table" then
        return false, "Malformed"
    end
    if state.Dead or state.Humanoid.Health <= 0 or not state.Model.Parent or not state.Root.Parent then
        return false, "Dead"
    end
    if action == "Sprint" and payload.Active == false then
        state.Sprinting = false
        state.Humanoid.WalkSpeed = Config.Player.WalkSpeed
        self:_sync(state, now)
        return true
    end
    if not self._enabled then
        return false, "Intermission"
    end
    if action == "Attack" then
        local direction = horizontalDirection(payload.Aim)
        if not direction then
            return false, "InvalidAim"
        end
        local allowed, reason = Rules.ConsumeAttack(state, Config, now)
        if not allowed then
            return false, reason
        end
        state.PendingAttack = { At = now + Config.Combat.AttackWindup, Direction = direction }
        self:_swing(state, state.SwingSide)
        self:_effect("Swing", { Actor = state.Model, Position = state.Root.Position, Direction = direction, TeamId = state.TeamId, Side = state.SwingSide })
    elseif action == "Sprint" then
        if type(payload.Active) ~= "boolean" then
            return false, "Malformed"
        end
        if state.Stamina <= 0 then
            return false, "Stamina"
        end
        state.Sprinting = payload.Active
        state.Humanoid.WalkSpeed = state.Sprinting and Config.Player.SprintSpeed or Config.Player.WalkSpeed
    elseif action == "Potion" then
        local consumed, result = Rules.ConsumePotion(state, Config, payload.Size, state.Humanoid.Health, state.Humanoid.MaxHealth, now)
        if not consumed then
            return false, result
        end
        state.Humanoid.Health = result
        state.PotionReadyAt = Workspace:GetServerTimeNow() + Config.PotionCooldown
        self:_effect("Potion", { Actor = state.Model, Position = state.Root.Position, Size = payload.Size, TeamId = state.TeamId })
    else
        return false, "UnknownAction"
    end
    self:_sync(state, now)
    return true
end

function CombatService:HandleAction(player, action, payload)
    return self:Act(player, action, payload)
end

function CombatService:SpendEffort(subject, cost)
    local state = self._states[subject]
    if not self._enabled or not state or state.Dead or state.Humanoid.Health <= 0
        or not state.Model.Parent or not state.Root.Parent then
        return false, "Dead"
    end
    if state.PendingAttack then return false, "Cooldown" end
    local now = os.clock()
    local accepted, reason = Rules.ConsumeEffort(state, Config, now, cost)
    if not accepted then return false, reason end
    self:_swing(state, state.SwingSide)
    self:_effect("Swing", {
        Actor = state.Model, Position = state.Root.Position,
        Direction = state.Root.CFrame.LookVector, TeamId = state.TeamId, Side = state.SwingSide,
    })
    self:_sync(state, now)
    return true
end

function CombatService:_resolveAttack(attacker, direction, now)
    if not self._enabled or attacker.Dead or attacker.Humanoid.Health <= 0 or not attacker.Root.Parent then
        return
    end
    local origin = attacker.Root.Position
    if not finiteVector(origin) then
        return
    end
    local candidates = {}
    for _, target in pairs(self._states) do
        if Rules.CanDamage(attacker, target, now) and target.Model.Parent and target.Root.Parent and target.Humanoid.Health > 0 then
            local offset = target.Root.Position - origin
            if finiteVector(offset) then
                local flat = Vector3.new(offset.X, 0, offset.Z)
                local dot = flat.Magnitude > 0.001 and direction:Dot(flat.Unit) or 1
                local distance = offset.Magnitude
                if Rules.InAttackArc(distance, dot, Config) then
                    candidates[#candidates + 1] = { State = target, Distance = distance }
                end
            end
        end
    end
    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)
    local rayParameters = RaycastParams.new()
    rayParameters.FilterType = Enum.RaycastFilterType.Exclude
    rayParameters.FilterDescendantsInstances = { attacker.Model }
    local eye = origin + Vector3.new(0, 1, 0)
    for _, candidate in ipairs(candidates) do
        local target = candidate.State
        local ray = Workspace:Raycast(eye, target.Root.Position + Vector3.new(0, 1, 0) - eye, rayParameters)
        if not ray or ray.Instance:IsDescendantOf(target.Model) then
            local previousAttacker = target.LastAttacker
            local previousHitAt = target.LastHitAt
            local before = target.Humanoid.Health
            target.LastAttacker = attacker
            target.LastHitAt = now
            target.Humanoid:TakeDamage(Config.Combat.AttackDamage)
            local damage = math.max(0, before - target.Humanoid.Health)
            if damage > 0 then
                -- Record this synchronously; Roblox may defer HealthChanged.
                target.LastDamagedAt = now
                target.LastObservedHealth = target.Humanoid.Health
                self:_effect("Hit", { Actor = attacker.Model, Target = target.Model, Position = target.Root.Position, Damage = damage, TeamId = attacker.TeamId })
                if target.Humanoid.Health <= 0 then
                    self:_markDead(target)
                end
            else
                target.LastAttacker = previousAttacker
                target.LastHitAt = previousHitAt
            end
            -- One accepted swing can hurt only one enemy.
            return
        end
    end
end

function CombatService:Step(dt)
    if not Rules.IsFinite(dt) or dt <= 0 then
        return
    end
    local now = os.clock()
    for _, state in pairs(self._states) do
        if state.Model.Parent and state.Root.Parent and state.Humanoid.Parent then
            if state.Humanoid.Health <= 0 then
                self:_markDead(state)
            elseif not state.Dead then
                if state.Humanoid.Health < state.LastObservedHealth then
                    state.LastDamagedAt = now
                end
                state.LastObservedHealth = state.Humanoid.Health
                if state.PendingAttack and now >= state.PendingAttack.At then
                    local attack = state.PendingAttack
                    state.PendingAttack = nil
                    self:_resolveAttack(state, attack.Direction, now)
                end
                local velocity = state.Root.AssemblyLinearVelocity
                local moving = finiteVector(velocity) and Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 0.75
                local wasSprinting = state.Sprinting
                Rules.TickStamina(state, Config, dt, now, moving)
                local restored = Rules.RecoverHealth(state, Config, dt, now, state.Humanoid.Health, state.Humanoid.MaxHealth)
                if restored > state.Humanoid.Health then state.Humanoid.Health = restored end
                state.LastObservedHealth = state.Humanoid.Health
                if wasSprinting ~= state.Sprinting then
                    state.Humanoid.WalkSpeed = state.Sprinting and Config.Player.SprintSpeed or Config.Player.WalkSpeed
                end
                if now >= state.NextAttributeAt then
                    self:_sync(state, now)
                    state.NextAttributeAt = now + 0.1
                end
            end
        end
    end
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- The only server entry point. No client request supplies damage or inventory.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage:WaitForChild("MedievalShared"):WaitForChild("Config"))
local worldMode = Config.Game.Mode == "Kingdoms"

Players.CharacterAutoLoads = false

local remotesFolder = Instance.new("Folder")
remotesFolder.Name = "MedievalRemotes"
local remotes = {}
for _, name in ipairs({ "Action", "State", "Effects", "Lobby", "Profile", "World" }) do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotesFolder
	remotes[name] = remote
end
remotesFolder.Parent = ReplicatedStorage

local MapBuilder = require(worldMode and script.Parent.WorldMapBuilder or script.Parent.MapBuilder)
local CombatService = require(script.Parent.CombatService)
local SessionService = require(worldMode and script.Parent.WorldService or script.Parent.MatchService)
local ProfileService = require(script.Parent.ProfileService)

local map = MapBuilder.Build()
local combat = CombatService.new(remotes)
local profiles = ProfileService.new(remotes)
local session = SessionService.new(remotes, map, combat, profiles)
local lastReady = {}
local lastFeedback = {}
local buckets = {}
local appearanceConnections = {}
local appearanceQueued = {}
local worldActions = { ChooseKingdom = true, Harvest = true, BuildOutpost = true, SetOutpostSpawn = true }
local feedback = {
	Stamina = "Pas assez d'endurance.",
	FullHealth = "Votre sante est deja au maximum.",
	Empty = "Vous n'avez plus cette potion.",
	Intermission = "Acceptez une demande PvP pour entrer en combat.",
	InsufficientCoins = "Vous n'avez pas assez de pieces.",
	NotOwned = "Achetez cette epee avant de l'equiper.",
	NotLobby = "Cette action est disponible au lobby.",
	ArenaBusy = "L'arene est occupee. Attendez la fin du combat.",
	Busy = "Un des joueurs est deja occupe.",
	Cooldown = "Patientez avant d'envoyer une nouvelle invitation.",
	NotLoaded = "Votre profil est encore en cours de chargement.",
	ProfileUnavailable = "Votre progression n'est pas disponible. Consultez le message du profil.",
	NotInLobby = "Cette action est disponible au lobby.",
	UnknownSword = "Cette epee n'est pas dans la boutique.",
	UnknownFaction = "Choisissez une faction disponible.",
	AlreadyOwned = "Vous possedez deja cette epee.",
	InviteCooldown = "Patientez avant d'envoyer une nouvelle invitation.",
	PlayerBusy = "Ce joueur a deja une invitation en attente.",
	PlayerUnavailable = "Ce joueur n'est pas disponible au lobby.",
	Expired = "Cette invitation a expire.",
	UnknownInvite = "Cette invitation n'est plus disponible.",
	UnknownKingdom = "Choose one of the available kingdoms.",
	AlreadyKingdom = "You already belong to this kingdom.",
	KingdomCooldown = "Wait for the kingdom change cooldown.",
	InCombat = "Rest out of combat before changing kingdom.",
	CombatLocked = "Rest out of combat before changing kingdom.",
	ChooseKingdom = "Choose a kingdom first.",
	HarvestCooldown = "Wait before gathering again.",
	Depleted = "This resource is regrowing. Find another node.",
	OutOfRange = "Move closer to interact.",
	TooFar = "Move closer to interact.",
	Blocked = "There is an obstacle between you and the resource.",
	Obstructed = "There is an obstacle between you and the interaction point.",
	NotOwner = "Your kingdom must control this flag.",
	AlreadyBuilt = "This outpost has already been built.",
	InsufficientWood = "Gather more wood first.",
	InsufficientOre = "Mine more ore first.",
	NotBuilt = "Build this owned outpost before using it as a spawn.",
	Contested = "Clear the enemy from the capture zone first.",
}

local function refreshAppearance(player)
	if appearanceQueued[player] then return end
	appearanceQueued[player] = true
	task.defer(function()
		appearanceQueued[player] = nil
		if player.Parent == Players and player:GetAttribute("Activity") == "Lobby" and player.Character then
			combat:DressCharacter(player, player.Character)
		end
	end)
end

local function addPlayer(player)
	if appearanceConnections[player] then return end
	local connections = {}
	appearanceConnections[player] = connections
	for _, name in ipairs({ "ProfileLoaded", "EquippedSword", "FactionId" }) do
		table.insert(connections, player:GetAttributeChangedSignal(name):Connect(function()
			refreshAppearance(player)
		end))
	end
	profiles:AddPlayer(player)
	session:AddPlayer(player)
end
Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(function(player)
	lastReady[player] = nil
	lastFeedback[player] = nil
	buckets[player] = nil
	appearanceQueued[player] = nil
	for _, connection in ipairs(appearanceConnections[player] or {}) do connection:Disconnect() end
	appearanceConnections[player] = nil
	session:RemovePlayer(player)
	profiles:RemovePlayer(player)
end)
for _, player in ipairs(Players:GetPlayers()) do
	addPlayer(player)
end

remotes.Action.OnServerEvent:Connect(function(player, action, payload)
	if player.Parent ~= Players or type(action) ~= "string" or #action > 24 or (payload ~= nil and type(payload) ~= "table") then
		return
	end
	local now = os.clock()
	local bucket = buckets[player] or { At = now, Tokens = 20 }
	bucket.Tokens = math.min(20, bucket.Tokens + (now - bucket.At) * 12)
	bucket.At = now
	buckets[player] = bucket
	if bucket.Tokens < 1 then return end
	bucket.Tokens -= 1
	if action == "Ready" then
		if now - (lastReady[player] or -math.huge) >= 0.5 then
			lastReady[player] = now
			session:SendState(player)
			if not worldMode then session:SendLobby(player) end
			profiles:SendProfile(player)
		end
	else
		local accepted, reason
		if worldMode and worldActions[action] then
			accepted, reason = session:HandleAction(player, action, payload or {})
		elseif not worldMode and (action == "Invite" or action == "InviteRespond" or action == "InviteCancel") then
			accepted, reason = session:HandleLobbyAction(player, action, payload or {})
		elseif action == "BuySword" or action == "EquipSword" or action == "ChooseFaction" then
			accepted, reason = profiles:HandleAction(player, action, payload or {})
			if accepted then refreshAppearance(player) end
		else
			accepted, reason = combat:HandleAction(player, action, payload or {})
		end
		local text = not accepted and feedback[reason]
		if not accepted and reason == "Cooldown" and (action == "Attack" or action == "Harvest") then
			text = "Wait for your sword swing to recover."
		end
		if not accepted and action == "Potion" and reason == "Cooldown" then
			local state = combat:GetState(player)
			local remaining = state and math.max(0, math.ceil((state.PotionReadyAt or 0) - workspace:GetServerTimeNow())) or 0
			text = string.format("Potion disponible dans %d s.", remaining)
		end
		if text and now - (lastFeedback[player] or -math.huge) >= 1.5 then
			lastFeedback[player] = now
			remotes.Effects:FireClient(player, "Toast", { Text = text })
		end
	end
end)

session:Start()
RunService.Heartbeat:Connect(function(dt)
	combat:Step(dt)
	session:Step(dt)
	profiles:Step(dt)
end)

game:BindToClose(function()
	profiles:Close()
end)

print(worldMode and "[Fer & Fioles] Kingdom world ready: sword combat, resources, flags and outposts."
	or "[Fer & Fioles] Lobby ready: PvP invitations, cosmetics and potions Z/X/C.")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- An original arena and social courtyard built from Roblox primitives.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("MedievalShared"):WaitForChild("Config"))
local Catalog = require(ReplicatedStorage:WaitForChild("MedievalShared"):WaitForChild("Catalog"))

local MapBuilder = {}

local COLORS = {
    Stone = Color3.fromRGB(155, 146, 124),
    StoneLight = Color3.fromRGB(189, 179, 151),
    StoneDark = Color3.fromRGB(107, 105, 94),
    Road = Color3.fromRGB(169, 152, 120),
    Grass = Color3.fromRGB(91, 117, 69),
    Wood = Color3.fromRGB(95, 65, 43),
    Plaster = Color3.fromRGB(225, 207, 168),
    Roof = Color3.fromRGB(113, 68, 57),
    Leaf = Color3.fromRGB(66, 101, 63),
    Gold = Color3.fromRGB(235, 187, 91),
}

function MapBuilder.Build()
    local previous = workspace:FindFirstChild("FerEtFiolesArena")
    if previous then previous:Destroy() end
    local arena = Instance.new("Model")
    arena.Name = "FerEtFiolesArena"

    local function part(name, size, cf, color, material, collidable, shape)
        local object = Instance.new("Part")
        object.Name = name
        object.Anchored = true
        object.Size = size
        object.CFrame = cf
        object.Color = color
        object.Material = material or Enum.Material.Slate
        object.TopSurface = Enum.SurfaceType.Smooth
        object.BottomSurface = Enum.SurfaceType.Smooth
        object.CanCollide = collidable ~= false
        if shape then object.Shape = shape end
        object.Parent = arena
        return object
    end

    local function block(name, size, position, color, material, collidable)
        return part(name, size, CFrame.new(position), color, material, collidable)
    end

    local function disc(name, radius, height, position, color, material, collidable)
        return part(name, Vector3.new(height, radius * 2, radius * 2),
            CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
            color, material, collidable, Enum.PartType.Cylinder)
    end

    local function roof(name, x, z, width, depth, baseHeight, color)
        for _, side in ipairs({ -1, 1 }) do
            local wedge = Instance.new("WedgePart")
            wedge.Name = name
            wedge.Anchored = true
            wedge.Size = Vector3.new(width, 5, depth / 2)
            wedge.CFrame = CFrame.new(x, baseHeight + 2.5, z + side * depth / 4)
                * CFrame.Angles(0, side == 1 and math.pi or 0, 0)
            wedge.Color = color
            wedge.Material = Enum.Material.Slate
            wedge.TopSurface = Enum.SurfaceType.Smooth
            wedge.BottomSurface = Enum.SurfaceType.Smooth
            wedge.Parent = arena
        end
    end

    local function light(position)
        local frame = block("LanternFrame", Vector3.new(1.4, 2.2, 1.4), position,
            COLORS.Wood, Enum.Material.Wood, false)
        local flame = block("LanternGlow", Vector3.new(1, 1.5, 1), position,
            Color3.fromRGB(255, 207, 117), Enum.Material.Neon, false)
        local glow = Instance.new("PointLight")
        glow.Color = Color3.fromRGB(255, 211, 145)
        glow.Brightness = 1.4
        glow.Range = 22
        glow.Shadows = true
        glow.Parent = flame
        return frame
    end

    local function flag(x, z, baseHeight, color, facing)
        block("BannerPole", Vector3.new(0.35, 11, 0.35), Vector3.new(x, baseHeight + 5.5, z),
            COLORS.Wood, Enum.Material.Wood, false)
        local cloth = part("TeamBanner", Vector3.new(0.18, 4, 4.5),
            CFrame.new(x, baseHeight + 8.1, z + 2.15 * facing), color,
            Enum.Material.Fabric, false)
        cloth.CastShadow = false
        block("BannerTrim", Vector3.new(0.24, 0.3, 4.6),
            cloth.Position + Vector3.new(0, -1.85, 0), COLORS.Gold, Enum.Material.Metal, false)
    end

    local function tower(x, z, color)
        disc("TowerFoot", 7.7, 1.4, Vector3.new(x, 0.7, z), COLORS.StoneDark)
        disc("Watchtower", 6.5, 15, Vector3.new(x, 7.5, z), COLORS.Stone)
        disc("TowerCrown", 7.2, 1.5, Vector3.new(x, 15.5, z), COLORS.StoneLight)
        for index = 0, 7 do
            local angle = index * math.pi / 4
            local position = Vector3.new(x + math.cos(angle) * 6.3, 17.3, z + math.sin(angle) * 6.3)
            part("TowerBattlement", Vector3.new(2.5, 3, 2.5),
                CFrame.new(position) * CFrame.Angles(0, -angle, 0), COLORS.StoneLight)
        end
        flag(x, z, 16.3, color, z < 0 and -1 or 1)
    end

    local function house(x, z, color, roofColor)
        block("VillageHouse", Vector3.new(17, 11, 16), Vector3.new(x, 5.5, z),
            color, Enum.Material.Plaster)
        block("HouseFoundation", Vector3.new(18, 1.2, 17), Vector3.new(x, 0.6, z), COLORS.StoneDark)
        roof("PitchedRoof", x, z, 20, 20, 11, roofColor)
        for _, side in ipairs({ -1, 1 }) do
            block("TimberCorner", Vector3.new(0.6, 11, 0.6), Vector3.new(x + side * 8.4, 5.5, z - 8.05),
                COLORS.Wood, Enum.Material.Wood)
            block("Window", Vector3.new(3, 3.5, 0.2), Vector3.new(x + side * 4.6, 7, z - 8.13),
                Color3.fromRGB(84, 116, 120), Enum.Material.Glass, false)
            block("WindowMullion", Vector3.new(0.25, 3.5, 0.3), Vector3.new(x + side * 4.6, 7, z - 8.25),
                COLORS.Wood, Enum.Material.Wood, false)
        end
        block("HouseBeam", Vector3.new(17.5, 0.6, 0.6), Vector3.new(x, 10.2, z - 8.1),
            COLORS.Wood, Enum.Material.Wood)
        block("Door", Vector3.new(3, 5.5, 0.3), Vector3.new(x, 2.75, z - 8.17),
            COLORS.Wood, Enum.Material.Wood)
        block("Chimney", Vector3.new(2.5, 7, 3), Vector3.new(x + 5, 14, z + 3), COLORS.StoneDark)
    end

    local function tree(x, z, scale)
        block("TreeTrunk", Vector3.new(1.7, 9, 1.7) * scale,
            Vector3.new(x, 4.5 * scale, z), COLORS.Wood, Enum.Material.Wood)
        for index = 0, 2 do
            part("TreeCrown", Vector3.new(10 - index * 1.5, 7, 10 - index * 1.5) * scale,
                CFrame.new(x + (index % 2) * scale, (9 + index * 2.6) * scale, z),
                index == 1 and Color3.fromRGB(80, 119, 67) or COLORS.Leaf,
                Enum.Material.Grass, false, Enum.PartType.Ball)
        end
    end

    -- The floor top is exactly y=0. Main paths have no raised lips or steps.
    block("ArenaGround", Vector3.new(184, 4, 164), Vector3.new(0, -2, 0), COLORS.Grass, Enum.Material.Grass)
    block("SurroundingMeadow", Vector3.new(340, 4, 320), Vector3.new(0, -4.1, 0),
        Color3.fromRGB(77, 99, 63), Enum.Material.Grass)
    block("CampRoad", Vector3.new(166, 0.08, 32), Vector3.new(0, 0.04, 0), COLORS.Road, Enum.Material.Cobblestone, false)
    block("VillageRoad", Vector3.new(20, 0.09, 132), Vector3.new(0, 0.05, 0), COLORS.Road, Enum.Material.Cobblestone, false)
    disc("CentralPlazaBorder", 26, 0.1, Vector3.new(0, 0.07, 0), COLORS.StoneDark, Enum.Material.Cobblestone, false)
    disc("CentralPlaza", 24.8, 0.1, Vector3.new(0, 0.13, 0), COLORS.StoneLight, Enum.Material.Cobblestone, false)
    disc("ArenaInsignia", 5.5, 0.12, Vector3.new(0, 0.2, 0), COLORS.Road, Enum.Material.Sandstone, false)
    -- Decorative paving is noncolliding; the single stable floor carries characters.
    for _, x in ipairs({ -36, -18, 18, 36 }) do
        block("RoadInlay", Vector3.new(1, 0.08, 29), Vector3.new(x, 0.13, 0),
            COLORS.StoneLight, Enum.Material.Sandstone, false)
    end

    -- An enclosing wall keeps combatants inside a 180 x 160 play area.
    for _, side in ipairs({ -1, 1 }) do
        block("BoundarySide", Vector3.new(3, 12, 164), Vector3.new(side * 91, 6, 0), COLORS.StoneDark)
        block("BoundaryEnd", Vector3.new(180, 12, 3), Vector3.new(0, 6, side * 81), COLORS.StoneDark)
        block("BoundaryCoping", Vector3.new(4, 0.7, 164), Vector3.new(side * 91, 12.35, 0), COLORS.Stone)
        block("BoundaryCoping", Vector3.new(180, 0.7, 4), Vector3.new(0, 12.35, side * 81), COLORS.Stone)
        for x = -84, 84, 12 do
            block("WallBattlement", Vector3.new(4, 2.5, 3), Vector3.new(x, 13.7, side * 81), COLORS.Stone)
        end
        for z = -68, 68, 12 do
            block("WallBattlement", Vector3.new(3, 2.5, 4), Vector3.new(side * 91, 13.7, z), COLORS.Stone)
        end
    end

    local spawns = { Dawn = {}, Ember = {} }
    for _, teamId in ipairs(Config.TeamOrder) do
        local sign = teamId == "Dawn" and -1 or 1
        local teamColor = Color3.fromRGB(table.unpack(Config.Teams[teamId].Color))
        local x = sign * 73
        for _, z in ipairs({ -8, 0, 8 }) do
            -- R6 HumanoidRootPart center is three studs above the ground.
            table.insert(spawns[teamId], CFrame.lookAt(Vector3.new(x, 3.5, z), Vector3.new(0, 3.5, z)))
        end
        block("CampStone", Vector3.new(25, 0.12, 29), Vector3.new(x, 0.1, 0),
            COLORS.StoneLight, Enum.Material.Cobblestone, false)
        block("SpawnCanopy", Vector3.new(25, 1.3, 32), Vector3.new(x, 13.8, 0),
            COLORS.Wood, Enum.Material.WoodPlanks)
        for _, z in ipairs({ -15, 15 }) do
            block("CanopyPillar", Vector3.new(1.5, 13.5, 1.5), Vector3.new(x - sign * 10.5, 6.75, z),
                COLORS.Wood, Enum.Material.Wood)
            block("CampSideCover", Vector3.new(25, 7, 2), Vector3.new(x, 3.5, z + (z < 0 and -2 or 2)),
                COLORS.Stone)
            light(Vector3.new(x, 10, z))
        end
        block("CampBack", Vector3.new(2, 13, 34), Vector3.new(sign * 86, 6.5, 0), COLORS.Stone)
        for _, z in ipairs({ -17, 17 }) do
            block("GatePillar", Vector3.new(5, 14, 5), Vector3.new(sign * 53, 7, z), COLORS.StoneLight)
            block("GateCapital", Vector3.new(6.5, 1.5, 6.5), Vector3.new(sign * 53, 14.2, z), COLORS.StoneDark)
        end
        block("GateArchLintel", Vector3.new(6, 3, 39), Vector3.new(sign * 53, 16, 0), COLORS.Stone)
        block("GateTeamStripe", Vector3.new(6.1, 1, 36), Vector3.new(sign * 53, 16.2, 0), teamColor, Enum.Material.Fabric, false)
        tower(sign * 55, -30, teamColor)
        tower(sign * 55, 30, teamColor)
        for _, z in ipairs({ -48, 48 }) do
            block("FortCurtain", Vector3.new(4, 9, 21), Vector3.new(sign * 55, 4.5, z), COLORS.Stone)
            house(sign * 75, z, COLORS.Plaster, teamColor:Lerp(COLORS.Roof, 0.55))
        end
        flag(sign * 66, -14, 13.8, teamColor, 1)
        flag(sign * 66, 14, 13.8, teamColor, -1)
    end

    -- The side village offers cover while leaving the complete center lane open.
    for _, position in ipairs({ Vector3.new(-25, 0, -52), Vector3.new(25, 0, -52), Vector3.new(-25, 0, 52), Vector3.new(25, 0, 52) }) do
        house(position.X, position.Z, COLORS.Plaster, COLORS.Roof)
    end
    for _, z in ipairs({ -29, 29 }) do
        for _, x in ipairs({ -27, 27 }) do
            block("LowCover", Vector3.new(11, 3.5, 3), Vector3.new(x, 1.75, z), COLORS.Stone)
            block("CoverCoping", Vector3.new(11.6, 0.5, 3.6), Vector3.new(x, 3.75, z), COLORS.StoneLight)
        end
    end

    -- Braziers flank the plaza without obstructing a spawn-to-center route.
    for _, z in ipairs({ -20, 20 }) do
        disc("BrazierFoot", 2, 1, Vector3.new(0, 0.5, z), COLORS.StoneDark)
        block("BrazierPlinth", Vector3.new(1.6, 3, 1.6), Vector3.new(0, 2, z), COLORS.Stone)
        disc("BrazierBowl", 2.2, 0.7, Vector3.new(0, 3.8, z), COLORS.Wood, Enum.Material.Metal)
        local fire = block("BrazierEmbers", Vector3.new(2.1, 0.35, 2.1), Vector3.new(0, 4.25, z),
            Color3.fromRGB(255, 149, 62), Enum.Material.Neon, false)
        local flame = Instance.new("Fire")
        flame.Size = 3
        flame.Heat = 3
        flame.Color = Color3.fromRGB(255, 174, 68)
        flame.SecondaryColor = Color3.fromRGB(255, 220, 120)
        flame.Parent = fire
        light(Vector3.new(0, 4, z))
    end

    for _, position in ipairs({
        Vector3.new(-42, 0, -66), Vector3.new(42, 0, -66), Vector3.new(-42, 0, 66), Vector3.new(42, 0, 66),
        Vector3.new(-10, 0, -69), Vector3.new(10, 0, 69), Vector3.new(-76, 0, -70), Vector3.new(76, 0, 70),
    }) do
        tree(position.X, position.Z, 0.85 + (math.abs(position.X) % 3) * 0.08)
    end
    for _, position in ipairs({ Vector3.new(-37, 0, -41), Vector3.new(37, 0, 41), Vector3.new(39, 0, -35), Vector3.new(-39, 0, 35) }) do
        for index = 0, 1 do
            block("SupplyCrate", Vector3.new(3, 3, 3), position + Vector3.new(index * 3.2, 1.5, 0),
                COLORS.Wood, Enum.Material.WoodPlanks)
        end
    end

    -- The lobby is a separate, enclosed courtyard. No walkable bridge leads to
    -- the battle arena: MatchService moves only consenting participants there.
    local lobbyCenter = Vector3.new(0, 3, 300)
    local lobbySpawns = {}
    block("LobbyGround", Vector3.new(164, 4, 144), Vector3.new(0, -2, 300),
        COLORS.StoneLight, Enum.Material.Cobblestone)
    block("LobbyFoundation", Vector3.new(172, 8, 152), Vector3.new(0, -8, 300),
        COLORS.StoneDark, Enum.Material.Slate)
    block("LobbyNorthSouthPaving", Vector3.new(25, 0.08, 132), Vector3.new(0, 0.04, 300),
        COLORS.Road, Enum.Material.Sandstone, false)
    block("LobbyEastWestPaving", Vector3.new(154, 0.09, 24), Vector3.new(0, 0.05, 300),
        COLORS.Road, Enum.Material.Sandstone, false)
    disc("LobbyCentralMedallionBorder", 25, 0.1, Vector3.new(0, 0.08, 300),
        COLORS.StoneDark, Enum.Material.Slate, false)
    disc("LobbyCentralMedallion", 23.5, 0.1, Vector3.new(0, 0.14, 300),
        COLORS.StoneLight, Enum.Material.Sandstone, false)
    for _, angle in ipairs({ 0, math.pi / 4, math.pi / 2, math.pi * 3 / 4 }) do
        part("LobbyCompassInlay", Vector3.new(1, 0.08, 39),
            CFrame.new(0, 0.23, 300) * CFrame.Angles(0, angle, 0),
            COLORS.Gold, Enum.Material.Metal, false)
    end

    -- High flat walls have no climbable route. Their coping cannot be reached
    -- with a normal character jump, even from the nearby low decorative seats.
    for _, sign in ipairs({ -1, 1 }) do
        block("LobbyBoundarySide", Vector3.new(3, 18, 144), Vector3.new(sign * 81, 9, 300), COLORS.Stone)
        block("LobbyBoundaryEnd", Vector3.new(160, 18, 3), Vector3.new(0, 9, 300 + sign * 71), COLORS.Stone)
        block("LobbyWallCoping", Vector3.new(4, 1, 144), Vector3.new(sign * 81, 18.5, 300), COLORS.StoneDark)
        block("LobbyWallCoping", Vector3.new(160, 1, 4), Vector3.new(0, 18.5, 300 + sign * 71), COLORS.StoneDark)
        for x = -72, 72, 12 do
            block("LobbyEndBattlement", Vector3.new(4, 3, 3), Vector3.new(x, 20.5, 300 + sign * 71), COLORS.StoneLight)
        end
        for z = 240, 360, 12 do
            block("LobbySideBattlement", Vector3.new(3, 3, 4), Vector3.new(sign * 81, 20.5, z), COLORS.StoneLight)
        end
        for _, z in ipairs({ 233, 367 }) do
            block("LobbyCornerKeep", Vector3.new(10, 24, 10), Vector3.new(sign * 76, 12, z), COLORS.StoneDark)
            block("LobbyCornerCrown", Vector3.new(12, 1.5, 12), Vector3.new(sign * 76, 24.75, z), COLORS.StoneLight)
            for _, offset in ipairs({ -4, 4 }) do
                block("LobbyKeepMerlon", Vector3.new(3, 3, 3),
                    Vector3.new(sign * 76 + offset, 27, z - 4), COLORS.StoneLight)
                block("LobbyKeepMerlon", Vector3.new(3, 3, 3),
                    Vector3.new(sign * 76 + offset, 27, z + 4), COLORS.StoneLight)
            end
        end
    end
    -- A sealed, purely decorative gate faces the distant arena.
    block("LobbySealedGate", Vector3.new(18, 15, 0.5), Vector3.new(0, 7.5, 230.8), COLORS.Wood, Enum.Material.WoodPlanks)
    for _, x in ipairs({ -10.5, 10.5 }) do
        block("LobbyGateColumn", Vector3.new(3, 18, 4), Vector3.new(x, 9, 231), COLORS.StoneLight)
    end
    block("LobbyGateLintel", Vector3.new(24, 3, 4), Vector3.new(0, 17, 231), COLORS.StoneLight)
    for _, x in ipairs({ -5, 0, 5 }) do
        block("LobbyGateIronwork", Vector3.new(0.6, 14, 0.2), Vector3.new(x, 7.5, 231.15), COLORS.StoneDark, Enum.Material.Metal, false)
    end

    local stationPositions = {
        Redcliff = Vector3.new(-54, 0, 262),
        Korblox = Vector3.new(54, 0, 262),
        Greywolf = Vector3.new(-54, 0, 338),
        Overseer = Vector3.new(54, 0, 338),
    }
    for _, factionId in ipairs(Catalog.FactionOrder) do
        local faction = Catalog.Factions[factionId]
        local position = stationPositions[factionId]
        local tint = Color3.fromRGB(table.unpack(faction.Color))
        local trim = Color3.fromRGB(table.unpack(faction.Trim))
        disc("Lobby" .. factionId .. "Medallion", 12, 0.12, position + Vector3.new(0, 0.12, 0), tint,
            Enum.Material.Sandstone, false)
        block("Lobby" .. factionId .. "Canopy", Vector3.new(27, 1, 25), position + Vector3.new(0, 14, 0),
            tint, Enum.Material.Slate)
        block("Lobby" .. factionId .. "CanopyTrim", Vector3.new(28, 0.4, 26), position + Vector3.new(0, 13.3, 0),
            trim, Enum.Material.Metal, false)
        for _, xOffset in ipairs({ -11, 11 }) do
            for _, zOffset in ipairs({ -10, 10 }) do
                block("Lobby" .. factionId .. "Column", Vector3.new(1.5, 13, 1.5),
                    position + Vector3.new(xOffset, 6.5, zOffset), COLORS.StoneLight)
            end
        end
        local outward = position.X < 0 and -1 or 1
        block("Lobby" .. factionId .. "BannerPole", Vector3.new(0.4, 12, 0.4),
            position + Vector3.new(outward * 9, 6, 0), COLORS.Wood, Enum.Material.Wood, false)
        block("Lobby" .. factionId .. "Banner", Vector3.new(0.2, 7, 7),
            position + Vector3.new(outward * 9, 8.5, 0), tint, Enum.Material.Fabric, false)
        block("Lobby" .. factionId .. "BannerStripe", Vector3.new(0.3, 0.6, 7.2),
            position + Vector3.new(outward * 9, 5.5, 0), trim, Enum.Material.Metal, false)
        -- Distinct primitive emblems identify the four original faction stalls.
        local emblem = CFrame.new(position + Vector3.new(outward * 9.2, 9, 0))
        if factionId == "Redcliff" then
            part("LobbyRedcliffCross", Vector3.new(0.2, 3.8, 0.7), emblem, trim, Enum.Material.Metal, false)
            part("LobbyRedcliffCrossArms", Vector3.new(0.2, 0.7, 3), emblem, trim, Enum.Material.Metal, false)
        elseif factionId == "Korblox" then
            for _, side in ipairs({ -1, 1 }) do
                part("LobbyKorbloxFang", Vector3.new(0.3, 3.5, 0.7),
                    emblem * CFrame.new(0, 0, side) * CFrame.Angles(side * 0.3, 0, 0), trim,
                    Enum.Material.Metal, false)
            end
        elseif factionId == "Greywolf" then
            part("LobbyGreywolfDiamond", Vector3.new(0.3, 2.6, 2.6),
                emblem * CFrame.Angles(math.pi / 4, 0, 0), trim, Enum.Material.Metal, false)
        else
            part("LobbyOverseerEye", Vector3.new(0.4, 2.2, 3.8), emblem,
                trim, Enum.Material.Neon, false, Enum.PartType.Ball)
            part("LobbyOverseerPupil", Vector3.new(0.5, 1.6, 0.8), emblem,
                COLORS.StoneDark, Enum.Material.Metal, false)
        end
    end

    -- Five cosmetic display swords. They are scenery; purchases/equipping are
    -- handled by the lobby menu and authoritative profile service, never touch.
    block("LobbySwordShopCounter", Vector3.new(42, 3, 5), Vector3.new(0, 1.5, 353), COLORS.Wood, Enum.Material.WoodPlanks)
    block("LobbySwordShopCanopy", Vector3.new(47, 1.2, 20), Vector3.new(0, 14, 357), COLORS.Roof)
    for _, x in ipairs({ -22, 22 }) do
        block("LobbySwordShopPost", Vector3.new(1.5, 13.5, 1.5), Vector3.new(x, 6.75, 350), COLORS.Wood, Enum.Material.Wood)
        block("LobbySwordShopPost", Vector3.new(1.5, 13.5, 1.5), Vector3.new(x, 6.75, 364), COLORS.Wood, Enum.Material.Wood)
    end
    for index, swordId in ipairs(Catalog.SwordOrder) do
        local sword = Catalog.Swords[swordId]
        local x = (index - 3) * 7.5
        local blade = Color3.fromRGB(table.unpack(sword.Blade))
        local guard = Color3.fromRGB(table.unpack(sword.Guard))
        disc("LobbySword" .. swordId .. "Plinth", 2.5, 0.4, Vector3.new(x, 3.25, 353), COLORS.StoneDark)
        block("LobbySword" .. swordId .. "Grip", Vector3.new(0.35, 1.3, 0.4), Vector3.new(x, 4.1, 353),
            Color3.fromRGB(table.unpack(sword.Accent)), Enum.Material.Wood, false)
        block("LobbySword" .. swordId .. "Guard", Vector3.new(2.3, 0.35, 0.5), Vector3.new(x, 4.8, 353), guard, Enum.Material.Metal, false)
        block("LobbySword" .. swordId .. "Blade", Vector3.new(0.75, 4, 0.2), Vector3.new(x, 6.95, 353), blade, Enum.Material.Metal, false)
        part("LobbySword" .. swordId .. "Tip", Vector3.new(0.55, 0.55, 0.2),
            CFrame.new(x, 9, 353) * CFrame.Angles(0, 0, math.pi / 4), blade, Enum.Material.Metal, false)
    end

    for _, x in ipairs({ -31, 31 }) do
        for _, z in ipairs({ 244, 356 }) do
            block("LobbyStoneSeat", Vector3.new(10, 2, 3), Vector3.new(x, 1, z), COLORS.StoneDark)
            block("LobbySeatTrim", Vector3.new(10.5, 0.3, 3.5), Vector3.new(x, 2.15, z), COLORS.StoneLight)
        end
    end
    for _, x in ipairs({ -31, 31 }) do
        for _, z in ipairs({ 276, 324 }) do
            block("LobbyLampPost", Vector3.new(0.6, 10, 0.6), Vector3.new(x, 5, z), COLORS.Wood, Enum.Material.Wood, false)
            light(Vector3.new(x, 10.5, z))
        end
    end
    -- Characters face the clear central meeting circle at arrival.
    for _, z in ipairs({ 284, 316 }) do
        for _, x in ipairs({ -24, -8, 8, 24 }) do
            table.insert(lobbySpawns, CFrame.lookAt(Vector3.new(x, 3.5, z), Vector3.new(0, 3.5, 300)))
        end
    end

    Lighting.ClockTime = 16.4
    Lighting.Brightness = 2.4
    Lighting.Ambient = Color3.fromRGB(113, 117, 133)
    Lighting.OutdoorAmbient = Color3.fromRGB(137, 143, 156)
    Lighting.GlobalShadows = true
    Lighting.ExposureCompensation = 0.05
    local atmosphere = Lighting:FindFirstChild("MedievalAtmosphere")
    if not atmosphere then
        atmosphere = Instance.new("Atmosphere")
        atmosphere.Name = "MedievalAtmosphere"
        atmosphere.Parent = Lighting
    end
    atmosphere.Density = 0.22
    atmosphere.Offset = 0.1
    atmosphere.Color = Color3.fromRGB(225, 219, 195)
    atmosphere.Decay = Color3.fromRGB(142, 151, 165)
    atmosphere.Glare = 0.12
    atmosphere.Haze = 1.2
    arena.Parent = workspace
    return {
        Model = arena, Spawns = spawns, Center = Vector3.new(0, 3, 0),
        LobbySpawns = lobbySpawns, LobbyCenter = lobbyCenter,
    }
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[-- Human-only, consent-based matches. The lobby is independent of the arena.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MedievalShared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("MatchRules"))
local Invites = require(Shared:WaitForChild("InvitationRules"))

local MatchService = {}
MatchService.__index = MatchService

local function statistic(player, name)
    local folder = player:FindFirstChild("leaderstats")
    return folder and folder:FindFirstChild(name)
end

local function memberName(member)
    return member.Id.DisplayName
end

function MatchService.new(remotes, map, combat, profiles)
    local self = setmetatable({}, MatchService)
    self.Remotes, self.Map, self.Combat, self.Profiles = remotes, map, combat, profiles
    self.Phase, self.Round, self.TimeLeft = "Lobby", 0, nil
    self.Scores = { Dawn = 0, Ember = 0 }
    self.Message = "Invitez des joueurs au combat depuis le lobby."
    self.Roster = nil
    self._players, self._teams, self._spawns, self._subjects = {}, {}, {}, {}
    self._deaths = setmetatable({}, { __mode = "k" })
    self._epoch, self._snapshotElapsed, self._lobbyElapsed = 0, 0, 0
    self._invitations = Invites.New(Config.Invites.CooldownSeconds, Config.Invites.ExpiresSeconds)
    self._started, self._lobbySpawn = false, 0
    for _, teamId in ipairs(Config.TeamOrder) do
        local definition = Config.Teams[teamId]
        local team = Teams:FindFirstChild(definition.Name)
        if not team or not team:IsA("Team") then
            team = Instance.new("Team")
            team.Name, team.Parent = definition.Name, Teams
        end
        team.AutoAssignable = false
        team.TeamColor = BrickColor.new(Color3.fromRGB(table.unpack(definition.Color)))
        self._teams[teamId], self._spawns[teamId] = team, 0
    end
    combat.OnDeath = function(victim, killer) self:_onDeath(victim, killer) end
    return self
end

function MatchService:GetSpawn(teamId)
    if teamId == nil then
        local spawns = self.Map.LobbySpawns
        if spawns and #spawns > 0 then
            self._lobbySpawn = self._lobbySpawn % #spawns + 1
            return spawns[self._lobbySpawn]
        end
        return CFrame.new(self.Map.LobbyCenter or (self.Map.Center + Vector3.new(0, 5, -160)))
    end
    local spawns = self.Map.Spawns[teamId]
    if spawns and #spawns > 0 then
        self._spawns[teamId] = (self._spawns[teamId] or 0) % #spawns + 1
        return spawns[self._spawns[teamId]]
    end
    local direction = teamId == Config.TeamOrder[1] and -1 or 1
    return CFrame.new(self.Map.Center + Vector3.new(direction * 40, 5, 0))
end

function MatchService:_setTeam(player, teamId)
    player.Team, player.Neutral = teamId and self._teams[teamId] or nil, teamId == nil
    player:SetAttribute("TeamId", teamId)
end

function MatchService:_setActivity(player, activity)
    player:SetAttribute("Activity", activity)
    player:SetAttribute("Spectating", false)
    player:SetAttribute("Eliminated", false)
end

function MatchService:_currentRequest(player, record, request)
    if not request or self._players[player] ~= record or player.Parent ~= Players
        or record.Generation ~= request.Generation then return false end
    if request.Kind == "Lobby" then return player:GetAttribute("Activity") == "Lobby" end
    local member = self.Roster == request.Roster and Rules.Get(request.Roster, player)
    return self.Phase == "Preparing" and self._epoch == request.Epoch and self.Round == request.Round
        and member ~= nil and not member.Eliminated
end

function MatchService:_destroyCharacter(player, record)
    -- Only this participant's model is touched. Lobby visitors are never swept.
    record.Model = nil
    if player.Character then player.Character:Destroy() end
end

function MatchService:_load(player, kind)
    local record = self._players[player]
    if not record or player.Parent ~= Players then return false, "UnknownPlayer" end
    local member = self.Roster and Rules.Get(self.Roster, player)
    if kind == "Combat" and (self.Phase ~= "Preparing" or not member or member.Eliminated) then
        return false, "NotPreparing"
    end
    if kind == "Lobby" and player:GetAttribute("Activity") ~= "Lobby" then return false, "NotInLobby" end
    if record.Request or self:_currentRequest(player, record, record.ActiveRequest) then return false, "AlreadyLoading" end
    if kind == "Combat" and member.Ready then return false, "AlreadyLoading" end
    record.Generation += 1
    record.Request = {
        Kind = kind, Generation = record.Generation, Epoch = self._epoch, Round = self.Round,
        Roster = self.Roster, TeamId = member and member.TeamId or nil,
    }
    record.RespawnAt = nil
    if record.LoadRunning then return true end
    record.LoadRunning = true
    task.spawn(function()
        while self._players[player] == record and player.Parent == Players and record.Request do
            local request = record.Request
            record.Request, record.ActiveRequest = nil, request
            local model
            local ok, problem = pcall(function()
                player:LoadCharacterAsync()
                model = player.Character
                -- The CharacterAdded result can belong to an aborted lobby or
                -- preparation. Reject it before waiting for any missing children.
                if not self:_currentRequest(player, record, request) then return end
                if not model then error("Personnage absent.") end
                local humanoid = model:WaitForChild("Humanoid", 10)
                local root = model:WaitForChild("HumanoidRootPart", 10)
                if not self:_currentRequest(player, record, request) then return end
                if not humanoid or not root or model ~= player.Character or humanoid.Health <= 0 then
                    error("Personnage incomplet ou mort pendant le chargement.")
                end
                for _, child in ipairs(model:GetChildren()) do
                    if child:IsA("ForceField") then child:Destroy() end
                end
                model:SetAttribute("Eliminated", false)
                if request.Kind == "Lobby" then
                    model:SetAttribute("Combatant", false)
                    model:SetAttribute("MatchRound", nil)
                    model:PivotTo(self:GetSpawn(nil))
                    humanoid.MaxHealth, humanoid.Health = Config.Player.MaxHealth, Config.Player.MaxHealth
                    humanoid.WalkSpeed = Config.Player.WalkSpeed
                    local shield = Instance.new("ForceField")
                    shield.Name, shield.Visible, shield.Parent = "LobbyProtection", false, model
                    if self.Combat.DressCharacter then self.Combat:DressCharacter(player, model) end
                else
                    model:SetAttribute("MatchRound", request.Round)
                    model:PivotTo(self:GetSpawn(request.TeamId))
                    local state = self.Combat:Register(player, model, request.TeamId)
                    if not state then error("Enregistrement du combattant impossible.") end
                    local currentMember = Rules.Get(request.Roster, player)
                    currentMember.Model, currentMember.Subject = model, player
                    Rules.SetReady(request.Roster, player, true)
                end
                record.Model = model
            end)
            local current = self:_currentRequest(player, record, request)
            if not ok and current then
                warn("Chargement de " .. player.Name .. ": " .. tostring(problem))
                if request.Kind == "Combat" then self._abortReason = "Le chargement d'un joueur a échoué."
                else record.RespawnAt = os.clock() + Config.Game.LobbyRespawnSeconds end
            end
            if not current and model and model.Parent then model:Destroy() end
            record.ActiveRequest = nil
        end
        record.LoadRunning = false
    end)
    return true
end

function MatchService:SpawnPlayer(player)
    return self:_load(player, "Combat")
end

function MatchService:AddPlayer(player)
    if self._players[player] or player.Parent ~= Players then return end
    local record = { Generation = 0, LoadRunning = false }
    self._players[player] = record
    self:_setTeam(player, nil)
    self:_setActivity(player, "Lobby")
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name, stats.Parent = "leaderstats", player
    end
    for _, name in ipairs({ "Kills", "Deaths" }) do
        if not stats:FindFirstChild(name) then
            local value = Instance.new("IntValue")
            value.Name, value.Parent = name, stats
        end
    end
    record.AddedConnection = player.CharacterAdded:Connect(function(model)
        if self._players[player] ~= record then return end
        if self:_currentRequest(player, record, record.ActiveRequest) then return end
        if record.ActiveRequest then model:Destroy(); return end
        local member = self.Roster and Rules.Get(self.Roster, player)
        if member and member.Model ~= model then
            if self.Phase == "Battle" then self:_eliminate(player)
            elseif self.Phase == "Preparing" then self._abortReason = "Un personnage a été remplacé." end
        end
        model:Destroy()
        if player:GetAttribute("Activity") == "Lobby" then
            record.Model, record.RespawnAt = nil, os.clock() + Config.Game.LobbyRespawnSeconds
        end
    end)
    record.RemovingConnection = player.CharacterRemoving:Connect(function(model)
        if self._players[player] ~= record then return end
        local member = self.Roster and Rules.Get(self.Roster, player)
        if member and member.Model == model and not member.Eliminated then
            if self.Phase == "Battle" then self:_eliminate(player)
            elseif self.Phase == "Preparing" then self._abortReason = "Un personnage a disparu pendant la préparation." end
        elseif player:GetAttribute("Activity") == "Lobby" and record.Model == model then
            record.Model, record.RespawnAt = nil, os.clock() + Config.Game.LobbyRespawnSeconds
        end
    end)
    self:_destroyCharacter(player, record)
    self:_load(player, "Lobby")
    self:SendState(player)
    self:SendLobby()
end

function MatchService:RemovePlayer(player)
    local record = self._players[player]
    if not record then return end
    record.Generation += 1
    record.Request = nil
    Invites.RemovePlayer(self._invitations, player.UserId)
    record.AddedConnection:Disconnect()
    record.RemovingConnection:Disconnect()
    self._players[player] = nil
    local member = self.Roster and Rules.Get(self.Roster, player)
    if member then
        self._forfeit = true
        if self.Phase == "Preparing" then
            self:_abortPreparation("Un joueur a quitté la préparation.")
        elseif self.Phase == "Battle" then
            self:_eliminate(player)
            local winner = member.TeamId == Config.TeamOrder[1] and Config.TeamOrder[2] or Config.TeamOrder[1]
            self:_finishBattle(winner, "Combat terminé par forfait.", false)
        end
    end
    self.Combat:Unregister(player)
    self:SendLobby()
end

function MatchService:_playerById(userId)
    for player in pairs(self._players) do
        if player.UserId == userId and player.Parent == Players then return player end
    end
    return nil
end

function MatchService:_available(userId)
    local player = self:_playerById(userId)
    return player ~= nil and player:GetAttribute("Activity") == "Lobby" and player:GetAttribute("ProfileLoaded") == true
end

function MatchService:HandleLobbyAction(player, action, payload)
    if not self._players[player] or player.Parent ~= Players then return false, "UnknownPlayer" end
    if type(payload) ~= "table" then return false, "InvalidPayload" end
    local now, accepted, reason = os.clock(), false, nil
    -- Bound malformed-request spam as well as successful invitations. This
    -- bucket is deliberately separate from the visible 15s invitation cooldown.
    local record = self._players[player]
    record.ActionTokens = math.min(12, (record.ActionTokens or 12) + math.max(0, now - (record.ActionAt or now)) * 6)
    record.ActionAt = now
    if record.ActionTokens < 1 then return false, "RateLimited" end
    record.ActionTokens -= 1
    if action == "Invite" then
        if Config.Game.AllowedModes and not Config.Game.AllowedModes[payload.Mode] then return false, "InvalidMode" end
        if not self:_available(player.UserId) then return false, "PlayerUnavailable" end
        local ids
        if payload.Mode == "Duel" then ids = { player.UserId, payload.OpponentUserId }
        elseif payload.Mode == "Teams" then
            ids = { player.UserId, payload.AllyUserId, payload.OpponentUserId, payload.OpponentAllyUserId }
        end
        local invite
        invite, reason = Invites.Create(self._invitations, player.UserId, payload.Mode, ids, now,
            function(userId) return self:_available(userId) end, self.Phase ~= "Lobby")
        accepted = invite ~= nil
    elseif action == "InviteRespond" then
        local invite, ready
        invite, reason, ready = Invites.Respond(self._invitations, player.UserId, payload.InviteId, payload.Accept, now)
        accepted = invite ~= nil
        if ready then
            if self.Phase ~= "Lobby" then reason, accepted = "ArenaBusy", false
            else
                for _, userId in ipairs(invite.Members) do
                    if not self:_available(userId) then reason, accepted = "PlayerUnavailable", false end
                end
                if accepted then self:_beginPreparing(invite) end
            end
        end
    elseif action == "InviteCancel" then
        accepted, reason = Invites.Cancel(self._invitations, player.UserId, payload.InviteId)
    else
        return false, "UnknownAction"
    end
    self:SendLobby()
    return accepted, reason
end

function MatchService:_eliminate(id)
    if not self.Roster or not Rules.Eliminate(self.Roster, id) then return false end
    local member = Rules.Get(self.Roster, id)
    if member.Model then member.Model:SetAttribute("Eliminated", true) end
    if self._players[id] and id.Parent == Players then
        id:SetAttribute("Eliminated", true)
        id:SetAttribute("Spectating", true)
    end
    return true
end

function MatchService:_onDeath(victim, killer)
    local id = self._subjects[victim.Subject]
    local member = id and self.Roster and Rules.Get(self.Roster, id)
    if not member or member.Model ~= victim.Model or victim.Model:GetAttribute("MatchRound") ~= self.Round then return end
    if self.Phase == "Preparing" then
        self:_eliminate(id)
        self._abortReason = "Un combattant est mort pendant la préparation."
        return
    end
    -- Retain a just-ended roster through Results, so an already-deferred final
    -- death gets its statistics exactly once even after Step resolves the match.
    local trailingDeath = self.Phase == "Results" and self.Roster.Started and member.Eliminated
    if (self.Phase ~= "Battle" and not trailingDeath) or self._deaths[victim.Model] then return end
    self._deaths[victim.Model] = true
    self:_eliminate(id)
    local deaths = self._players[id] and statistic(id, "Deaths")
    if deaths then deaths.Value += 1 end
    local killerId = killer and self._subjects[killer.Subject]
    local killerMember = killerId and Rules.Get(self.Roster, killerId)
    if killerMember and killerMember.Model == killer.Model and killerMember.TeamId ~= member.TeamId then
        local kills = self._players[killerId] and statistic(killerId, "Kills")
        if kills then kills.Value += 1 end
        self.Remotes.Effects:FireAllClients("Killfeed", {
            Killer = memberName(killerMember), Victim = memberName(member), TeamId = killerMember.TeamId,
        })
    end
    self:SendState()
end

function MatchService:_unregisterRoster()
    if not self.Roster then return end
    for id in pairs(self.Roster.Members) do self.Combat:Unregister(id) end
end

function MatchService:_returnLobby(message)
    local oldRoster = self.Roster
    self._epoch += 1
    self.Combat:SetEnabled(false)
    self:_unregisterRoster()
    self.Roster, self._subjects, self._abortReason = nil, {}, nil
    self.Phase, self.TimeLeft, self._deadline, self._battleStartedAt = "Lobby", nil, nil, nil
    self.Winner, self.Message = nil, message or "Invitez des joueurs au combat depuis le lobby."
    if oldRoster then
        for player in pairs(oldRoster.Members) do
            local record = self._players[player]
            if record and player.Parent == Players then
                record.Generation += 1
                record.Request = nil
                self:_setActivity(player, "Lobby")
                self:_setTeam(player, nil)
                self:_destroyCharacter(player, record)
                self:_load(player, "Lobby")
            end
        end
    end
    self:SendState()
    self:SendLobby()
end

function MatchService:_abortPreparation(message)
    self._forfeit = true
    self:_returnLobby(message or "Préparation interrompue. Vous pouvez lancer une nouvelle invitation.")
end

function MatchService:_beginPreparing(invite)
    if self.Phase ~= "Lobby" then return false end
    local roster = Rules.New(Config.TeamOrder, invite.Mode == "Duel" and 1 or 2)
    for index, userId in ipairs(invite.Members) do
        local player = self:_playerById(userId)
        if not player or not self:_available(userId) then return false end
        local teamIndex = invite.Mode == "Duel" and index or (index <= 2 and 1 or 2)
        if not Rules.Add(roster, player, Config.TeamOrder[teamIndex]) then return false end
        Rules.Get(roster, player).IsBot = false
    end
    if not Rules.Lock(roster) then return false end
    self._epoch += 1
    self.Round += 1
    self._matchId = HttpService:GenerateGUID(false)
    self.Phase, self.Winner, self._abortReason, self._forfeit, self._awarded = "Preparing", nil, nil, false, false
    self.Message = "Préparation des combattants…"
    self._deadline, self.TimeLeft = os.clock() + Config.Game.PreparingTimeoutSeconds, Config.Game.PreparingTimeoutSeconds
    self.Roster, self._subjects = roster, {}
    self.Combat:SetEnabled(false)
    -- Other pending groups are released when the sole arena becomes occupied.
    Invites.Clear(self._invitations)
    for player, member in pairs(roster.Members) do
        local record = self._players[player]
        record.Generation += 1
        record.Request = nil
        self:_setActivity(player, "Preparing")
        self:_setTeam(player, member.TeamId)
        self._subjects[player] = player
        self:_destroyCharacter(player, record)
        self:SpawnPlayer(player)
    end
    self:SendState()
    self:SendLobby()
    return true
end

function MatchService:_beginBattle()
    if not Rules.Begin(self.Roster) then return end
    local now = os.clock()
    self.Phase, self.Message = "Battle", "Éliminez l'équipe adverse. Une seule vie par combattant."
    self._battleStartedAt, self._deadline, self.TimeLeft = now, nil, nil
    for player, member in pairs(self.Roster.Members) do
        local state = self.Combat:GetState(member.Subject)
        member.Model:PivotTo(self:GetSpawn(member.TeamId))
        state.Root.AssemblyLinearVelocity, state.Root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        state.SpawnProtectedUntil = now + Config.Game.SpawnProtectionSeconds
        state.PendingAttack, state.NextAttributeAt = nil, 0
        member.Model:SetAttribute("SpawnProtected", true)
        self:_setActivity(player, "Battle")
    end
    self.Combat:SetEnabled(true)
    self:SendState()
    self:SendLobby()
end

function MatchService:_finishBattle(winner, message, reward)
    if self.Phase ~= "Battle" then return end
    self.Phase, self.Winner, self.Message = "Results", winner, message
    self._deadline, self.TimeLeft = os.clock() + Config.Game.ResultSeconds, Config.Game.ResultSeconds
    self.Combat:SetEnabled(false)
    self:_unregisterRoster()
    if winner then self.Scores[winner] += 1 end
    for player in pairs(self.Roster.Members) do
        local record = self._players[player]
        if record and player.Parent == Players then player:SetAttribute("Activity", "Results") end
    end
    if reward and not self._forfeit and not self._awarded and self.Profiles then
        local valid = true
        for player in pairs(self.Roster.Members) do
            if not self._players[player] or player.Parent ~= Players then valid = false end
        end
        if valid then
            self._awarded = true
            self.Profiles:AwardMatch(self._matchId, self.Roster.Members, winner)
        end
    end
    self:SendState()
    self:SendLobby()
end

function MatchService:Start()
    if self._started then return end
    self._started = true
    self.Combat:SetEnabled(false)
    self:SendState()
    self:SendLobby()
end

function MatchService:SendState(player)
    local alive = self.Roster and Rules.CountAlive(self.Roster) or { Dawn = 0, Ember = 0 }
    local roster, participants = {}, {}
    if self.Roster then
        for _, member in pairs(self.Roster.Members) do
            table.insert(participants, member.Id.UserId)
            table.insert(roster, {
                Name = memberName(member), TeamId = member.TeamId, Alive = not member.Eliminated,
                IsBot = false, UserId = member.Id.UserId, Model = member.Model,
            })
        end
    end
    local snapshot = {
        Phase = self.Phase, Round = self.Round,
        TimeLeft = self._deadline and math.max(0, math.ceil(self._deadline - os.clock())) or nil,
        Elapsed = self.Phase == "Battle" and math.floor(os.clock() - self._battleStartedAt) or nil,
        Alive = alive, Scores = { Dawn = self.Scores.Dawn, Ember = self.Scores.Ember },
        TeamSize = self.Roster and self.Roster.TeamSize or Config.Game.TeamSize,
        Winner = self.Winner, Message = self.Message, Roster = roster, Participants = participants,
    }
    if player then
        if player.Parent == Players then self.Remotes.State:FireClient(player, snapshot) end
    else self.Remotes.State:FireAllClients(snapshot) end
end

function MatchService:_invitationSnapshot(invite, offset)
    if not invite then return nil end
    local host = self:_playerById(invite.HostId)
    local snapshot = { Id = invite.Id, HostName = host and host.DisplayName or "Joueur", Mode = invite.Mode,
        ExpiresAt = invite.ExpiresAt + offset, Members = {} }
    for index, userId in ipairs(invite.Members) do
        local player = self:_playerById(userId)
        local teamIndex = invite.Mode == "Duel" and index or (index <= 2 and 1 or 2)
        table.insert(snapshot.Members, { UserId = userId, Name = player and player.DisplayName or "Joueur",
            TeamId = Config.TeamOrder[teamIndex], Accepted = invite.Accepted[userId] == true })
    end
    return snapshot
end

function MatchService:SendLobby(player)
    if not self.Remotes.Lobby then return end
    local players = {}
    for subject in pairs(self._players) do
        if subject.Parent == Players then
            table.insert(players, { UserId = subject.UserId, Name = subject.Name, DisplayName = subject.DisplayName,
                Activity = subject:GetAttribute("Activity"), FactionId = subject:GetAttribute("FactionId"),
                Busy = not self:_available(subject.UserId) or Invites.Get(self._invitations, subject.UserId) ~= nil })
        end
    end
    table.sort(players, function(a, b) return a.UserId < b.UserId end)
    local offset = Workspace:GetServerTimeNow() - os.clock()
    local function send(subject)
        if subject.Parent ~= Players then return end
        local invite = Invites.Get(self._invitations, subject.UserId)
        local own = invite and invite.HostId == subject.UserId
        local snapshot = { Players = players, ArenaBusy = self.Phase ~= "Lobby",
            InviteCooldownUntil = math.max(os.clock(), Invites.CooldownUntil(self._invitations, subject.UserId)) + offset,
            Incoming = not own and self:_invitationSnapshot(invite, offset) or nil,
            Outgoing = own and self:_invitationSnapshot(invite, offset) or nil }
        self.Remotes.Lobby:FireClient(subject, snapshot)
    end
    if player then send(player) else for subject in pairs(self._players) do send(subject) end end
end

function MatchService:Step(dt)
    if not self._started then return end
    local now = os.clock()
    if Invites.Expire(self._invitations, now) > 0 then self:SendLobby() end
    for player, record in pairs(self._players) do
        if player:GetAttribute("Activity") == "Lobby" then
            local model = record.Model
            local humanoid = model and model:FindFirstChildOfClass("Humanoid")
            if model and (not model.Parent or not humanoid or humanoid.Health <= 0 or player.Character ~= model) then
                record.Model, record.RespawnAt = nil, now + Config.Game.LobbyRespawnSeconds
            end
            if not record.Model and not record.Request and not self:_currentRequest(player, record, record.ActiveRequest)
                and (not record.RespawnAt or now >= record.RespawnAt) then self:_load(player, "Lobby") end
        end
    end
    if self.Phase == "Preparing" then
        self.TimeLeft = math.max(0, math.ceil(self._deadline - now))
        for id, member in pairs(self.Roster.Members) do
            if member.Eliminated or not self._players[id] or id.Parent ~= Players then
                self._abortReason = "Un combattant a quitté la préparation."
            elseif member.Ready then
                local state = self.Combat:GetState(member.Subject)
                if not state or state.Dead or not member.Model.Parent or state.Humanoid.Health <= 0 then
                    self._abortReason = "Un combattant n'est plus prêt."
                end
            end
        end
        if self._abortReason then self:_abortPreparation(self._abortReason)
        elseif Rules.IsReady(self.Roster) then self:_beginBattle()
        elseif now >= self._deadline then self:_abortPreparation("Le chargement a pris trop de temps. Réessayez une invitation.") end
    elseif self.Phase == "Battle" then
        for id, member in pairs(self.Roster.Members) do
            if not self._players[id] or id.Parent ~= Players then self._forfeit = true end
            if not member.Eliminated then
                local state = self.Combat:GetState(member.Subject)
                if not state or state.Dead or not member.Model.Parent or state.Humanoid.Health <= 0 or not self._players[id] then
                    self:_eliminate(id)
                end
            end
        end
        local finished, winner = Rules.Resolve(self.Roster)
        if finished then
            local message = winner and (Config.Teams[winner].Name .. " remportent le combat !") or "Double élimination : égalité !"
            self:_finishBattle(winner, message, true)
        end
    elseif self.Phase == "Results" and now >= self._deadline then
        self:_returnLobby()
    end
    self._snapshotElapsed += dt
    self._lobbyElapsed += dt
    if self._snapshotElapsed >= 0.5 then self._snapshotElapsed = 0; self:SendState() end
    if self._lobbyElapsed >= 1 then self._lobbyElapsed = 0; self:SendLobby() end
end

return MatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source"><![CDATA[-- Server-owned cosmetics and currency. DataStore writes use a renewable session
-- lease; a failed/contended load never becomes a writable default profile.
local shared = game:GetService("ReplicatedStorage"):WaitForChild("MedievalShared")
local Config = require(shared.Config)
local Catalog = require(shared.Catalog)
local Rules = require(shared.ProfileRules)

local ProfileService = {}
ProfileService.__index = ProfileService

local function copyOwned(owned)
    local result = {}
    for id, value in pairs(owned) do if value == true then result[id] = true end end
    return result
end

local function finite(value)
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function ProfileService.new(remotes, deps)
    deps = deps or {}
    local studio = deps.IsStudio
    if studio == nil then studio = game:GetService("RunService"):IsStudio() end
    local published = deps.IsPublished
    if published == nil then published = game.GameId ~= 0 end
    local sessionId = deps.SessionId
    if not sessionId then sessionId = game:GetService("HttpService"):GenerateGUID(false) end
    local store = deps.Store
    if store == nil and published then
        local ok, value = pcall(function()
            return game:GetService("DataStoreService"):GetDataStore(Config.Persistence.StoreName)
        end)
        if ok then store = value end
    end
    return setmetatable({
        Remotes = remotes, Store = store, IsStudio = studio, IsPublished = published,
        Clock = deps.Clock or os.clock, Timestamp = deps.Timestamp or os.time,
        Spawn = deps.Spawn or task.spawn, Wait = deps.Wait or task.wait,
        SessionId = sessionId, Counter = 0, Records = {}, AllEntries = {},
        AwardedMatches = {}, Closing = false,
    }, ProfileService)
end

function ProfileService:_current(entry)
    return self.Records[entry.Player] == entry and not entry.Removed
end

function ProfileService:_attributes(entry)
    if not self:_current(entry) then return end
    local player, data = entry.Player, entry.Data
    player:SetAttribute("Coins", data and data.Coins or 0)
    player:SetAttribute("EquippedSword", data and data.EquippedSword or Catalog.DefaultSword)
    player:SetAttribute("FactionId", data and data.FactionId or Catalog.DefaultFaction)
    player:SetAttribute("SaveMode", entry.Mode)
    player:SetAttribute("ProfileLoaded", entry.Loaded == true)
end

function ProfileService:SendProfile(player)
    local entry = self.Records[player]
    if not entry or not self.Remotes.Profile then return end
    local data = entry.Data
    self.Remotes.Profile:FireClient(player, {
        Loaded = entry.Loaded == true, Coins = data and data.Coins or 0,
        OwnedSwords = data and copyOwned(data.OwnedSwords) or {},
        EquippedSword = data and data.EquippedSword or Catalog.DefaultSword,
        FactionId = data and data.FactionId or Catalog.DefaultFaction,
        Wins = data and data.Wins or 0, Losses = data and data.Losses or 0,
        SaveMode = entry.Mode, Message = entry.Message,
    })
end

function ProfileService:_publish(entry)
    if not self:_current(entry) then return end
    self:_attributes(entry)
    self:SendProfile(entry.Player)
end

function ProfileService:_unavailable(entry, message)
    entry.Loaded, entry.Mode, entry.Lost = false, "Unavailable", true
    entry.Message = message
    self:_publish(entry)
end

function ProfileService:_session(entry)
    entry.Data, entry.Loaded, entry.Mode = Rules.New(Catalog), true, "Session"
    entry.Message = "Mode session Studio : pieces et achats non sauvegardes."
    self:_publish(entry)
end

function ProfileService:_leaseValid(entry)
    return not entry.Lost and entry.LeaseUntil ~= nil and self.Timestamp() < entry.LeaseUntil
end

function ProfileService:_usable(entry)
    if not entry or not entry.Loaded or entry.Removed or entry.Closing or self.Closing then return false end
    if entry.Mode == "Persistent" and not self:_leaseValid(entry) then
        self:_unavailable(entry, "Session expiree : reconnectez-vous pour proteger vos donnees.")
        return false
    end
    return entry.Mode == "Persistent" or entry.Mode == "Session"
end

function ProfileService:_load(entry)
    if not self.Store or not self.IsPublished then
        entry.Loading = false
        if self.IsStudio then
            if self:_current(entry) and not self.Closing then self:_session(entry) end
        else
            self:_unavailable(entry, "Sauvegarde indisponible. Reconnectez-vous plus tard.")
        end
        if entry.Removed or self.Closing then self.AllEntries[entry] = nil end
        return
    end
    local result, loaded, busy = nil, false, false
    for attempt = 1, 3 do
        if entry.Removed or self.Closing then break end
        busy = false
        local ok, value = pcall(function()
            return self.Store:UpdateAsync(entry.Key, function(old)
                local now = self.Timestamp()
                local lease = type(old) == "table" and old.Lease or nil
                if type(lease) == "table" and type(lease.Owner) == "string"
                    and lease.Owner ~= entry.Owner and finite(lease.ExpiresAt) and lease.ExpiresAt > now then
                    busy = true
                    return nil
                end
                -- No defaults are written after a failed read. This transform
                -- creates defaults only as part of a successful atomic load.
                local raw = type(old) == "table" and (old.Profile or old) or nil
                return { Version = 1, Profile = Rules.Sanitize(raw, Catalog),
                    Lease = { Owner = entry.Owner, ExpiresAt = now + Config.Persistence.LeaseSeconds } }
            end)
        end)
        if ok then
            result = value
            loaded = type(result) == "table" and type(result.Lease) == "table" and result.Lease.Owner == entry.Owner
            break
        end
        if attempt < 3 then self.Wait(attempt) end
    end
    entry.Loading = false
    if loaded then
        entry.Data = Rules.Sanitize(result.Profile, Catalog)
        entry.LeaseUntil = result.Lease.ExpiresAt
        entry.Loaded, entry.Mode, entry.Lost = true, "Persistent", false
        entry.Message = "Progression sauvegardee entre les sessions."
        entry.LastAttemptAt = self.Clock()
        if not self:_current(entry) or self.Closing then
            entry.Closing = true
            self:_save(entry, true)
        else
            self:_publish(entry)
        end
    elseif entry.Removed or self.Closing then
        self.AllEntries[entry] = nil
    elseif busy then
        self:_unavailable(entry, "Profil deja ouvert sur un autre serveur. Reconnectez-vous dans quelques minutes.")
    elseif self.IsStudio then
        self:_session(entry)
    else
        self:_unavailable(entry, "Chargement impossible : aucun achat ni remplacement de votre sauvegarde.")
    end
end

function ProfileService:AddPlayer(player)
    if self.Closing or self.Records[player] then return end
    self.Counter += 1
    local entry = {
        Player = player, Key = "u_" .. tostring(player.UserId), Owner = self.SessionId .. ":" .. tostring(self.Counter),
        Loaded = false, Loading = true, Mode = "Unavailable", Message = "Chargement de votre progression...",
        Revision = 0, SavedRevision = 0, LastAttemptAt = self.Clock(),
    }
    self.Records[player], self.AllEntries[entry] = entry, true
    self:_publish(entry)
    self.Spawn(function() self:_load(entry) end)
end

function ProfileService:_save(entry, release)
    if release then entry.ReleaseRequested = true end
    if entry.Saving then return end
    if entry.Mode ~= "Persistent" or not entry.Data or entry.Lost then
        if entry.Removed or entry.Closing then self.AllEntries[entry] = nil end
        return
    end
    entry.Saving = true
    entry.LastAttemptAt = self.Clock()
    self.Spawn(function()
        repeat
            -- Capture before yielding. Concurrent purchases update the live
            -- object, never this write; a subsequent release saves the latest.
            local snapshot = Rules.Sanitize(entry.Data, Catalog)
            local revision = entry.Revision
            local releasing = entry.ReleaseRequested == true
            local saved, leaseLost, newLease = false, false, nil
            for attempt = 1, 3 do
                if entry.Lost then leaseLost = true; break end
                local ok, value = pcall(function()
                    return self.Store:UpdateAsync(entry.Key, function(old)
                        local lease = type(old) == "table" and old.Lease or nil
                        local now = self.Timestamp()
                        if entry.Lost or type(lease) ~= "table" or lease.Owner ~= entry.Owner
                            or not finite(lease.ExpiresAt) or lease.ExpiresAt <= now then
                            leaseLost = true
                            return nil
                        end
                        local record = { Version = 1, Profile = snapshot }
                        if not releasing then
                            record.Lease = { Owner = entry.Owner, ExpiresAt = now + Config.Persistence.LeaseSeconds }
                        end
                        return record
                    end)
                end)
                if ok then
                    saved = type(value) == "table" and not leaseLost
                    if saved and not releasing then
                        saved = type(value.Lease) == "table" and value.Lease.Owner == entry.Owner
                        if saved then newLease = value.Lease.ExpiresAt end
                    end
                    break
                end
                if attempt < 3 then self.Wait(attempt) end
            end
            if leaseLost then
                self:_unavailable(entry, "Session transferee ou expiree. Reconnectez-vous pour proteger vos donnees.")
            elseif saved then
                entry.SavedRevision = revision
                if newLease then entry.LeaseUntil = newLease end
                entry.Message = "Progression sauvegardee entre les sessions."
                if releasing then
                    entry.Released = true
                    self.AllEntries[entry] = nil
                end
            else
                entry.Message = "Sauvegarde temporairement indisponible ; nouvelle tentative automatique."
                warn("[Fer & Fioles] Echec de sauvegarde du profil " .. tostring(entry.Player.UserId))
            end
            self:_publish(entry)
            -- A release requested while the previous write was in flight must
            -- run after it, with the newest revision, never race that write.
            -- Even a failed autosave may have an older snapshot than a leave
            -- queued during it. Give that release its own latest-data write.
            if releasing or entry.Lost or not entry.ReleaseRequested then break end
        until false
        entry.Saving = false
        if entry.Removed or entry.Closing then self.AllEntries[entry] = nil end
    end)
end

function ProfileService:RemovePlayer(player)
    local entry = self.Records[player]
    if not entry then return end
    entry.Removed, entry.Closing = true, true
    self.Records[player] = nil
    if not entry.Loading then self:_save(entry, true) end
end

function ProfileService:HandleAction(player, action, payload)
    if action ~= "BuySword" and action ~= "EquipSword" and action ~= "ChooseFaction" then return false, "UnknownAction" end
    if type(payload) ~= "table" then return false, "InvalidPayload" end
    local entry = self.Records[player]
    if not self:_usable(entry) then return false, "ProfileUnavailable" end
    if player:GetAttribute("Activity") ~= "Lobby" then return false, "NotInLobby" end
    local accepted, reason
    if action == "BuySword" then accepted, reason = Rules.Buy(entry.Data, payload.SwordId, Catalog)
    elseif action == "EquipSword" then accepted, reason = Rules.Equip(entry.Data, payload.SwordId, Catalog)
    else accepted, reason = Rules.ChooseFaction(entry.Data, payload.FactionId, Catalog) end
    if accepted then entry.Revision += 1; self:_publish(entry) end
    return accepted, reason
end

function ProfileService:AwardMatch(matchId, roster, winner)
    if type(matchId) ~= "string" or #matchId == 0 or #matchId > 128 then return false, "InvalidMatch" end
    if self.AwardedMatches[matchId] then return false, "AlreadyRewarded" end
    if winner ~= nil and not Config.Teams[winner] then return false, "UnknownTeam" end
    if type(roster) ~= "table" then return false, "InvalidRoster" end
    local members = roster.Members or roster
    local recipients, seen, teams = {}, {}, {}
    for _, member in pairs(members) do
        if type(member) ~= "table" or member.IsBot == true or not Config.Teams[member.TeamId] then return false, "InvalidRoster" end
        local entry = self.Records[member.Id]
        if seen[member.Id] or not self:_usable(entry) then return false, "ProfileUnavailable" end
        seen[member.Id], teams[member.TeamId] = true, true
        if entry.Data.RewardedMatches[matchId] then return false, "AlreadyRewarded" end
        table.insert(recipients, { Entry = entry, Outcome = winner == nil and "Draw" or (member.TeamId == winner and "Win" or "Loss") })
    end
    local teamCount = 0
    for _ in pairs(teams) do teamCount += 1 end
    if #recipients < 2 or teamCount ~= 2 or (winner and not teams[winner]) then return false, "InvalidRoster" end
    -- Validation above and all balance mutations below are synchronous.
    -- There is no remote for awarding coins, and no await between accounts.
    for _, recipient in ipairs(recipients) do
        Rules.Reward(recipient.Entry.Data, matchId, recipient.Outcome, Config.Rewards)
        recipient.Entry.Revision += 1
    end
    self.AwardedMatches[matchId] = true
    for _, recipient in ipairs(recipients) do self:_publish(recipient.Entry) end
    return true
end

function ProfileService:Step(_dt)
    if self.Closing then return end
    local now = self.Clock()
    for _, entry in pairs(self.Records) do
        if entry.Loaded and entry.Mode == "Persistent" then
            if not self:_leaseValid(entry) then
                self:_unavailable(entry, "Session expiree : reconnectez-vous pour proteger vos donnees.")
            elseif not entry.Saving and now - entry.LastAttemptAt >= Config.Persistence.AutosaveSeconds then
                self:_save(entry, false)
            end
        end
    end
end

function ProfileService:Close()
    if self.Closing then return end
    self.Closing = true
    for entry in pairs(self.AllEntries) do
        entry.Closing = true
        if not entry.Loading then self:_save(entry, true) end
    end
    local deadline = self.Clock() + 25
    while next(self.AllEntries) and self.Clock() < deadline do self.Wait(0.05) end
    if next(self.AllEntries) then warn("[Fer & Fioles] Fermeture avant la fin de toutes les sauvegardes ; les baux expireront.") end
end

return ProfileService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">WorldMapBuilder</string>
          <string name="Source"><![CDATA[-- Original, asset-free kingdom battlefield. All tuning remains provisional.
-- Gameplay refs are produced by the same builder used by the static exporter.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("MedievalShared"):WaitForChild("Config"))

local WorldMapBuilder = {}
local C = {
    Grass = Color3.fromRGB(87, 111, 65), Meadow = Color3.fromRGB(73, 95, 58),
    Road = Color3.fromRGB(164, 148, 115), Stone = Color3.fromRGB(151, 145, 125),
    Dark = Color3.fromRGB(89, 94, 89), Light = Color3.fromRGB(190, 181, 152),
    Wood = Color3.fromRGB(99, 69, 43), Leaves = Color3.fromRGB(55, 94, 57),
    LeavesLight = Color3.fromRGB(75, 112, 61), Gold = Color3.fromRGB(223, 180, 94),
    Neutral = Color3.fromRGB(165, 158, 140), Ore = Color3.fromRGB(103, 144, 157),
}

function WorldMapBuilder.Build()
    local previous = workspace:FindFirstChild("FerEtFiolesArena")
    if previous then previous:Destroy() end
    local model = Instance.new("Model")
    model.Name = "FerEtFiolesArena"

    local function group(name, parent)
        local object = Instance.new("Model")
        object.Name, object.Parent = name, parent or model
        return object
    end
    local function part(name, size, frame, color, material, collidable, parent, shape)
        local object = Instance.new("Part")
        object.Name, object.Size, object.CFrame = name, size, frame
        object.Color, object.Material = color, material or Enum.Material.Slate
        object.Anchored, object.CanCollide = true, collidable ~= false
        object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        if shape then object.Shape = shape end
        object.Parent = parent or model
        return object
    end
    local function block(name, size, position, color, material, collidable, parent)
        return part(name, size, CFrame.new(position), color, material, collidable, parent)
    end
    local function disc(name, radius, height, position, color, material, collidable, parent)
        return part(name, Vector3.new(height, radius * 2, radius * 2),
            CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2), color, material,
            collidable, parent, Enum.PartType.Cylinder)
    end
    local function banner(parent, x, z, color, height)
        height = height or 15
        block("FlagPole", Vector3.new(0.45, height, 0.45), Vector3.new(x, height / 2, z),
            C.Wood, Enum.Material.Wood, false, parent)
        local flag = block("Flag", Vector3.new(5.5, 4, 0.2), Vector3.new(x + 2.7, height - 3, z),
            color, Enum.Material.Fabric, false, parent)
        flag.CastShadow = false
        block("FlagFinial", Vector3.new(0.8, 0.8, 0.8), Vector3.new(x, height + 0.4, z),
            C.Gold, Enum.Material.Metal, false, parent)
        return flag
    end
    local function tower(parent, x, z, color)
        disc("Tower", 5.5, 15, Vector3.new(x, 7.5, z), C.Stone, nil, true, parent)
        disc("TowerCrown", 6.1, 1, Vector3.new(x, 15.5, z), C.Light, nil, true, parent)
        for _, offset in ipairs({ Vector3.new(-3.5, 17, -3.5), Vector3.new(3.5, 17, -3.5),
            Vector3.new(-3.5, 17, 3.5), Vector3.new(3.5, 17, 3.5) }) do
            block("Merlon", Vector3.new(2.7, 2.5, 2.7), Vector3.new(x, 0, z) + offset,
                C.Light, nil, true, parent)
        end
        block("TowerPennant", Vector3.new(0.2, 5, 4), Vector3.new(x, 18, z), color,
            Enum.Material.Fabric, false, parent)
    end

    -- One continuous support plane: every battlefield ground top is exactly y=0.
    block("WorldGround", Vector3.new(600, 6, 600), Vector3.new(0, -3, 0), C.Grass, Enum.Material.Grass)
    local paths = group("Roads")
    for _, offset in ipairs({ -220, 0, 220 }) do
        block("WorldRoad", Vector3.new(444, 0.08, 16), Vector3.new(0, 0.045, offset),
            C.Road, Enum.Material.Cobblestone, false, paths)
        block("WorldRoad", Vector3.new(16, 0.08, 444), Vector3.new(offset, 0.045, 0),
            C.Road, Enum.Material.Cobblestone, false, paths)
    end
    disc("Crossroads", 30, 0.1, Vector3.new(0, 0.09, 0), C.Light, Enum.Material.Cobblestone, false, paths)
    disc("CrossroadsCompass", 11, 0.11, Vector3.new(0, 0.16, 0), C.Dark, Enum.Material.Slate, false, paths)
    for _, angle in ipairs({ 0, math.pi / 4, math.pi / 2, math.pi * 3 / 4 }) do
        part("CompassInlay", Vector3.new(0.8, 0.06, 17), CFrame.new(0, 0.25, 0) * CFrame.Angles(0, angle, 0),
            C.Gold, Enum.Material.Metal, false, paths)
    end
    -- Simple high borders protect the walkable world edge; no outside assets.
    for _, sign in ipairs({ -1, 1 }) do
        block("WorldBoundary", Vector3.new(3, 20, 600), Vector3.new(sign * 299, 10, 0), C.Dark)
        block("WorldBoundary", Vector3.new(594, 20, 3), Vector3.new(0, 10, sign * 299), C.Dark)
    end

    local centers = {
        Redcliff = Vector3.new(-220, 0, -220), Korblox = Vector3.new(220, 0, -220),
        Greywolf = Vector3.new(-220, 0, 220), Overseer = Vector3.new(220, 0, 220),
    }
    local spawns = {}
    for _, id in ipairs(Config.KingdomOrder) do
        local center = assert(centers[id], "Missing kingdom map center: " .. id)
        local tint = Color3.fromRGB(table.unpack(Config.Kingdoms[id].Color))
        local base = group(id .. "Keep")
        local sx, sz = center.X < 0 and -1 or 1, center.Z < 0 and -1 or 1
        spawns[id] = {}
        for _, offset in ipairs({ Vector3.new(-9, 3.5, -6), Vector3.new(9, 3.5, -6),
            Vector3.new(-9, 3.5, 6), Vector3.new(9, 3.5, 6) }) do
            local p = center + offset
            table.insert(spawns[id], CFrame.lookAt(p, Vector3.new(0, p.Y, 0)))
        end
        block("KeepCourtyard", Vector3.new(72, 0.08, 72), center + Vector3.new(0, 0.06, 0),
            C.Light, Enum.Material.Cobblestone, false, base)
        -- The inward two sides remain completely open, including the roads.
        block("OuterCurtain", Vector3.new(3, 12, 76), center + Vector3.new(sx * 37, 6, 0), C.Stone, nil, true, base)
        block("OuterCurtain", Vector3.new(76, 12, 3), center + Vector3.new(0, 6, sz * 37), C.Stone, nil, true, base)
        for _, x in ipairs({ -31, 31 }) do
            for _, z in ipairs({ -31, 31 }) do tower(base, center.X + x, center.Z + z, tint) end
        end
        block("SpawnPavilionRoof", Vector3.new(38, 1.2, 34), center + Vector3.new(0, 14.5, 0),
            tint, Enum.Material.Slate, true, base)
        block("PavilionTrim", Vector3.new(39, 0.4, 35), center + Vector3.new(0, 13.8, 0),
            C.Gold, Enum.Material.Metal, false, base)
        for _, x in ipairs({ -18, 18 }) do
            for _, z in ipairs({ -16, 16 }) do
                block("PavilionPost", Vector3.new(1.5, 14, 1.5), center + Vector3.new(x, 7, z),
                    C.Wood, Enum.Material.Wood, true, base)
            end
        end
        banner(base, center.X + sx * 23, center.Z - sz * 15, tint, 18)
        local store = center + Vector3.new(sx * 21, 0, sz * 21)
        block("KeepStorehouse", Vector3.new(13, 10, 13), store + Vector3.new(0, 5, 0), C.Wood,
            Enum.Material.WoodPlanks, true, base)
        block("StorehouseRoof", Vector3.new(16, 1.5, 16), store + Vector3.new(0, 10.8, 0), tint,
            Enum.Material.Slate, true, base)
        block("StorehouseDoor", Vector3.new(3.5, 6, 0.15), store + Vector3.new(0, 3, -6.6), C.Dark,
            Enum.Material.Wood, false, base)
    end

    local nodes = {}
    local forest = group("HarvestForest")
    local treePositions = {
        { -160, -150 }, { -132, -154 }, { -104, -148 }, { -75, -134 },
        { -170, -118 }, { -142, -116 }, { -112, -108 }, { -82, -102 },
        { -164, -80 }, { -136, -72 }, { -106, -66 }, { -76, -62 },
        { -250, -130 }, { 245, -130 }, { -250, 130 }, { 245, 130 },
    }
    for index, p in ipairs(treePositions) do
        local id = string.format("Tree%02d", index)
        local tree = group(id, forest)
        local x, z = p[1], p[2]
        local scale = 0.9 + (index % 3) * 0.1
        block("HarvestTrunk", Vector3.new(2.4, 11, 2.4) * scale, Vector3.new(x, 5.5 * scale, z),
            C.Wood, Enum.Material.Wood, true, tree)
        for crown = 0, 2 do
            part("TreeCrown", Vector3.new(12 - crown * 2, 8, 12 - crown * 2) * scale,
                CFrame.new(x, (11 + crown * 3) * scale, z), crown == 1 and C.LeavesLight or C.Leaves,
                Enum.Material.Grass, false, tree, Enum.PartType.Ball)
        end
        nodes[id] = { Id = id, Kind = "Tree", Position = Vector3.new(x, 2, z), Model = tree }
    end
    local quarry = group("HarvestMines")
    local minePositions = {
        { 90, 70 }, { 118, 68 }, { 148, 74 }, { 176, 80 },
        { 88, 102 }, { 116, 108 }, { 146, 114 }, { 174, 110 },
        { -150, -240 }, { 150, -240 }, { -150, 240 }, { 150, 240 },
    }
    for index, p in ipairs(minePositions) do
        local id = string.format("Mine%02d", index)
        local mine = group(id, quarry)
        local x, z = p[1], p[2]
        part("OreRock", Vector3.new(7, 5, 6), CFrame.new(x, 2.3, z) * CFrame.Angles(0, index * 0.3, 0),
            C.Dark, Enum.Material.Slate, true, mine, Enum.PartType.Ball)
        for vein = 1, 3 do
            block("OreVein", Vector3.new(0.6, 1.3 + vein * 0.2, 2.8),
                Vector3.new(x - 2 + vein, 3.6, z - 2 + vein * 0.5), C.Ore, Enum.Material.Metal, false, mine)
        end
        nodes[id] = { Id = id, Kind = "Mine", Position = Vector3.new(x, 2, z), Model = mine }
    end
    -- The quarry arch is scenery beside the nodes, never a harvest prerequisite.
    for _, x in ipairs({ 190, 210 }) do
        block("QuarryTimber", Vector3.new(2, 15, 2), Vector3.new(x, 7.5, 100), C.Wood, Enum.Material.Wood)
    end
    block("QuarryLintel", Vector3.new(25, 2, 3), Vector3.new(200, 15, 100), C.Wood, Enum.Material.Wood)
    for _, z in ipairs({ 87, 113 }) do
        block("QuarryRockFace", Vector3.new(15, 16, 8), Vector3.new(245, 8, z), C.Dark)
    end

    local outposts = {}
    for _, spec in ipairs({
        { "Westwatch", "Westwatch", -110, 0 }, { "Eastwatch", "Eastwatch", 110, 0 },
        { "Southwatch", "Southwatch", 0, 115 },
    }) do
        local id, name, x, z = spec[1], spec[2], spec[3], spec[4]
        local camp = group(id .. "Outpost")
        disc("CaptureCircle", 18, 0.08, Vector3.new(x, 0.08, z), C.Dark, Enum.Material.Cobblestone, false, camp)
        disc("CaptureInlay", 16.5, 0.09, Vector3.new(x, 0.13, z), C.Road, Enum.Material.Sandstone, false, camp)
        local flag = banner(camp, x + 6, z - 6, C.Neutral, 17)
        local structure = {}
        local function buildPart(name_, size, position, color, material)
            local object = block(name_, size, position, color, material, false, camp)
            object.Transparency = 1
            table.insert(structure, object)
        end
        buildPart("BuiltOutpostRoof", Vector3.new(34, 1.4, 34), Vector3.new(x, 15, z), C.Wood, Enum.Material.WoodPlanks)
        for _, dx in ipairs({ -15, 15 }) do
            for _, dz in ipairs({ -15, 15 }) do
                buildPart("BuiltOutpostPost", Vector3.new(1.7, 14.5, 1.7), Vector3.new(x + dx, 7.25, z + dz),
                    C.Wood, Enum.Material.Wood)
                buildPart("BuiltOutpostCover", Vector3.new(6, 3.5, 3), Vector3.new(x + dx, 1.75, z + dz),
                    C.Stone, Enum.Material.Cobblestone)
            end
        end
        outposts[id] = { Id = id, Name = name, Position = Vector3.new(x, 0, z),
            Model = camp, Flag = flag, Structure = structure }
    end

    -- No walkable connection to combat. Only kingdom selection teleports a player.
    local lobby = group("KingdomSelection")
    local lobbyCenter = Vector3.new(0, 0, 420)
    block("SelectionGround", Vector3.new(136, 6, 128), Vector3.new(0, -3, 420), C.Light,
        Enum.Material.Cobblestone, true, lobby)
    disc("SelectionCompass", 26, 0.1, Vector3.new(0, 0.1, 420), C.Road, Enum.Material.Sandstone, false, lobby)
    for _, sign in ipairs({ -1, 1 }) do
        block("SelectionWall", Vector3.new(3, 20, 128), Vector3.new(sign * 67, 10, 420), C.Stone, nil, true, lobby)
        block("SelectionWall", Vector3.new(130, 20, 3), Vector3.new(0, 10, 420 + sign * 63), C.Stone, nil, true, lobby)
        block("SelectionCoping", Vector3.new(4, 1, 128), Vector3.new(sign * 67, 20.5, 420), C.Dark, nil, true, lobby)
        block("SelectionCoping", Vector3.new(130, 1, 4), Vector3.new(0, 20.5, 420 + sign * 63), C.Dark, nil, true, lobby)
    end
    local selectionPositions = {
        Redcliff = Vector3.new(-45, 0, 392), Korblox = Vector3.new(45, 0, 392),
        Greywolf = Vector3.new(-45, 0, 448), Overseer = Vector3.new(45, 0, 448),
    }
    for _, id in ipairs(Config.KingdomOrder) do
        local p = selectionPositions[id]
        local tint = Color3.fromRGB(table.unpack(Config.Kingdoms[id].Color))
        disc(id .. "SelectionMedallion", 11, 0.1, p + Vector3.new(0, 0.1, 0), tint,
            Enum.Material.Sandstone, false, lobby)
        block(id .. "SelectionCanopy", Vector3.new(25, 1, 25), p + Vector3.new(0, 14, 0), tint,
            Enum.Material.Slate, true, lobby)
        for _, dx in ipairs({ -10, 10 }) do
            for _, dz in ipairs({ -10, 10 }) do
                block("SelectionColumn", Vector3.new(1.4, 13.5, 1.4), p + Vector3.new(dx, 6.75, dz),
                    C.Light, nil, true, lobby)
            end
        end
        banner(lobby, p.X + (p.X < 0 and -1 or 1) * 8, p.Z, tint, 16)
    end
    local lobbySpawns = {}
    for _, z in ipairs({ 404, 436 }) do
        for _, x in ipairs({ -24, -8, 8, 24 }) do
            table.insert(lobbySpawns, CFrame.lookAt(Vector3.new(x, 3.5, z), Vector3.new(0, 3.5, 420)))
        end
    end

    Lighting.ClockTime, Lighting.Brightness = 16.4, 2.4
    Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(113, 117, 133), Color3.fromRGB(137, 143, 156)
    Lighting.GlobalShadows = true
    model.Parent = workspace
    return { Model = model, Spawns = spawns, LobbySpawns = lobbySpawns, LobbyCenter = lobbyCenter,
        Nodes = nodes, Outposts = outposts }
end

return WorldMapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[-- Session-only kingdom warfare. Clients request actions; this service owns all
-- world resources, ownership, placement, character lifetime and proximity checks.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local Workspace = game:GetService("Workspace")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MedievalShared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("WorldRules"))

local WorldService = {}
WorldService.__index = WorldService

local function finite(value)
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end
local function finitePosition(position)
    return typeof(position) == "Vector3" and finite(position.X) and finite(position.Y) and finite(position.Z)
end
local function identifier(value)
    return type(value) == "string" and #value > 0 and #value <= 48
end
local function statistic(player, name)
    local folder = player:FindFirstChild("leaderstats")
    return folder and folder:FindFirstChild(name)
end
local function orderedKeys(values)
    local keys = {}
    for id in pairs(values) do table.insert(keys, id) end
    table.sort(keys)
    return keys
end
local function anchor(model)
    return model and (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true))
end
local function label(model, name, height)
    local part = anchor(model)
    if not part then return nil end
    local gui = Instance.new("BillboardGui")
    gui.Name, gui.Adornee = name, part
    gui.Size, gui.StudsOffset = UDim2.fromOffset(230, 66), Vector3.new(0, height or 5, 0)
    gui.AlwaysOnTop, gui.MaxDistance = false, 100
    local text = Instance.new("TextLabel")
    text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    text.Font, text.TextSize = Enum.Font.GothamBold, 15
    text.TextColor3, text.TextStrokeTransparency = Color3.fromRGB(245, 232, 196), 0.3
    text.TextWrapped, text.Parent = true, gui
    gui.Parent = model
    return text
end

-- Optional clock/scheduler/visual overrides allow deterministic lifecycle tests;
-- production uses the real Roblox character, physics and network APIs.
function WorldService.new(remotes, map, combat, profiles, dependencies)
    local deps = dependencies or {}
    local self = setmetatable({}, WorldService)
    self.Remotes, self.Map, self.Combat, self.Profiles = remotes, map, combat, profiles
    self._clock, self._serverTime = deps.Clock or os.clock, deps.ServerTime or function() return Workspace:GetServerTimeNow() end
    self._spawn = deps.Spawn or task.spawn
    self._visuals = deps.Visuals ~= false
    self._players, self._teams, self._spawnIndices = {}, {}, {}
    self._nodes, self._outposts = {}, {}
    self._deaths = setmetatable({}, { __mode = "k" })
    self._started, self._snapshotElapsed, self._lobbySpawn = false, 0, 0
    for _, id in ipairs(Config.KingdomOrder) do
        local definition = Config.Kingdoms[id]
        local team = Teams:FindFirstChild(definition.Name)
        if not team or not team:IsA("Team") then
            team = Instance.new("Team")
            team.Name, team.Parent = definition.Name, Teams
        end
        team.AutoAssignable = false
        team.TeamColor = BrickColor.new(Color3.fromRGB(table.unpack(definition.Color)))
        self._teams[id] = team
    end
    for id, view in pairs(map.Nodes or {}) do
        local entry = { View = view, State = Rules.NewNode(view.Kind, Config), Parts = {} }
        self._nodes[id] = entry
        if self._visuals and view.Model then
            for _, part in ipairs(view.Model:GetDescendants()) do
                if part:IsA("BasePart") then
                    table.insert(entry.Parts, { Part = part, Transparency = part.Transparency, CanCollide = part.CanCollide, CanQuery = part.CanQuery })
                end
            end
            entry.Label = label(view.Model, "ResourceStatus", 5)
        end
        self:_renderNode(entry)
    end
    for id, view in pairs(map.Outposts or {}) do
        local entry = { View = view, State = Rules.NewOutpost() }
        self._outposts[id] = entry
        if self._visuals then entry.Label = label(view.Model, "OutpostStatus", 10) end
        self:_renderOutpost(entry)
    end
    combat.OnDeath = function(victim, killer) self:_onDeath(victim, killer) end
    return self
end

function WorldService:_renderNode(entry)
    if not self._visuals then return end
    local alive = entry.State.HitsRemaining > 0
    for _, original in ipairs(entry.Parts) do
        original.Part.Transparency = alive and original.Transparency or 1
        original.Part.CanCollide = alive and original.CanCollide or false
        original.Part.CanQuery = alive and original.CanQuery or false
    end
    if entry.Label then
        entry.Label.Text = alive and string.format("%s · %d hits\n[E] Gather", entry.State.Kind, entry.State.HitsRemaining) or "Regrowing…"
    end
end

function WorldService:_renderOutpost(entry)
    if not self._visuals then return end
    local point, view = entry.State, entry.View
    local definition = point.Owner and Config.Kingdoms[point.Owner]
    if view.Flag then view.Flag.Color = Color3.fromRGB(table.unpack(definition and definition.Color or { 178, 169, 141 })) end
    for _, part in ipairs(view.Structure or {}) do
        part.Transparency, part.CanCollide, part.CanQuery = point.Built and 0 or 1, point.Built, point.Built
    end
    if entry.Label then
        local status = point.Contested and "CONTESTED" or (point.Claimant and string.format("%s %d%%", Config.Kingdoms[point.Claimant].Name, math.floor(point.Progress * 100))
            or (point.Built and "Fortified · respawn available" or "Hold the flag · build with wood & ore"))
        entry.Label.Text = view.Name .. " · " .. (definition and definition.Name or "Neutral") .. "\n" .. status
    end
end

function WorldService:_setKingdom(player, kingdomId)
    player.Team, player.Neutral = kingdomId and self._teams[kingdomId] or nil, kingdomId == nil
    player:SetAttribute("KingdomId", kingdomId)
    player:SetAttribute("TeamId", kingdomId)
    player:SetAttribute("Activity", kingdomId and "World" or "Lobby")
    player:SetAttribute("Spectating", false)
    player:SetAttribute("Eliminated", false)
end

function WorldService:_currentRequest(player, record, request)
    return request ~= nil and self._players[player] == record and player.Parent == Players
        and request.Generation == record.Generation and request.KingdomId == record.State.KingdomId
end

function WorldService:GetSpawn(player)
    local record = self._players[player]
    local kingdomId = record and record.State.KingdomId
    if kingdomId then
        local entry = record.SpawnOutpostId and self._outposts[record.SpawnOutpostId]
        if entry and entry.State.Owner == kingdomId and entry.State.Built then
            return entry.View.Spawn or CFrame.new(entry.View.Position + Vector3.new(0, 3.5, 10))
        end
        -- Lost/unbuilt points never permit an enemy spawn, even if selection
        -- happened before ownership changed during an asynchronous load.
        record.SpawnOutpostId = nil
        local spawns = self.Map.Spawns[kingdomId]
        if spawns and #spawns > 0 then
            self._spawnIndices[kingdomId] = (self._spawnIndices[kingdomId] or 0) % #spawns + 1
            return spawns[self._spawnIndices[kingdomId]]
        end
    else
        local spawns = self.Map.LobbySpawns
        if spawns and #spawns > 0 then
            self._lobbySpawn = self._lobbySpawn % #spawns + 1
            return spawns[self._lobbySpawn]
        end
    end
    return CFrame.new(self.Map.LobbyCenter or Vector3.new(0, 3.5, 420))
end

function WorldService:_clearCharacter(player, record, destroy)
    record.Model = nil
    if record.LobbyDeathConnection then record.LobbyDeathConnection:Disconnect(); record.LobbyDeathConnection = nil end
    self.Combat:Unregister(player)
    if destroy and player.Character then player.Character:Destroy() end
end

function WorldService:_scheduleRespawn(player, record)
    record.Generation += 1
    record.Request = nil
    self:_clearCharacter(player, record, false)
    record.RespawnAt = self._clock() + Config.World.RespawnSeconds
end

function WorldService:_load(player)
    local record = self._players[player]
    if not record or player.Parent ~= Players then return false, "UnknownPlayer" end
    if record.Request or self:_currentRequest(player, record, record.ActiveRequest) then return false, "AlreadyLoading" end
    record.Generation += 1
    record.Request = { Generation = record.Generation, KingdomId = record.State.KingdomId }
    record.RespawnAt = nil
    if record.LoadRunning then return true end
    record.LoadRunning = true
    self._spawn(function()
        while self._players[player] == record and player.Parent == Players and record.Request do
            local request = record.Request
            record.Request, record.ActiveRequest = nil, request
            local model
            local ok, problem = pcall(function()
                player:LoadCharacterAsync()
                model = player.Character
                if not self:_currentRequest(player, record, request) then return end
                if not model then error("Character is missing") end
                local humanoid = model:WaitForChild("Humanoid", 10)
                local root = model:WaitForChild("HumanoidRootPart", 10)
                if not self:_currentRequest(player, record, request) then return end
                if model ~= player.Character or not model.Parent or not humanoid or not root or humanoid.Health <= 0 then
                    error("Character is incomplete or died while loading")
                end
                for _, child in ipairs(model:GetChildren()) do if child:IsA("ForceField") then child:Destroy() end end
                model:SetAttribute("Eliminated", false)
                model:SetAttribute("KingdomId", request.KingdomId)
                model:PivotTo(self:GetSpawn(player))
                if request.KingdomId then
                    if not self.Combat:Register(player, model, request.KingdomId) then error("Combat registration failed") end
                else
                    model:SetAttribute("Combatant", false)
                    humanoid.MaxHealth, humanoid.Health, humanoid.WalkSpeed = Config.Player.MaxHealth, Config.Player.MaxHealth, Config.Player.WalkSpeed
                    local shield = Instance.new("ForceField")
                    shield.Name, shield.Visible, shield.Parent = "SelectionProtection", false, model
                    if self.Combat.DressCharacter then self.Combat:DressCharacter(player, model) end
                    record.LobbyDeathConnection = humanoid.Died:Connect(function()
                        if self._players[player] == record and record.Model == model then
                            self:_scheduleRespawn(player, record)
                            self:SendState(player)
                        end
                    end)
                end
                record.Model = model
            end)
            local current = self:_currentRequest(player, record, request)
            if not ok and current then
                warn("World character load for " .. player.Name .. ": " .. tostring(problem))
                self:_scheduleRespawn(player, record)
                if model and model.Parent then model:Destroy() end
            elseif not current and model and model.Parent and record.Model ~= model then
                model:Destroy()
            end
            record.ActiveRequest = nil
        end
        record.LoadRunning = false
        if self._players[player] == record then self:SendState(player) end
    end)
    return true
end

function WorldService:AddPlayer(player)
    if self._players[player] or player.Parent ~= Players then return end
    local record = { State = Rules.NewPlayer(), Generation = 0, LoadRunning = false }
    self._players[player] = record
    self:_setKingdom(player, nil)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then stats = Instance.new("Folder"); stats.Name, stats.Parent = "leaderstats", player end
    for _, name in ipairs({ "Kills", "Deaths" }) do
        if not stats:FindFirstChild(name) then
            local value = Instance.new("IntValue")
            value.Name, value.Parent = name, stats
        end
    end
    record.AddedConnection = player.CharacterAdded:Connect(function(model)
        if self._players[player] ~= record then return end
        if self:_currentRequest(player, record, record.ActiveRequest) then return end
        if record.ActiveRequest then model:Destroy(); return end
        -- CharacterAutoLoads is disabled. A replaced character cannot inherit a
        -- previous registration, inventory privileges or delayed death callback.
        if record.Model then self:_scheduleRespawn(player, record) end
        model:Destroy()
        record.RespawnAt = record.RespawnAt or self._clock() + Config.World.RespawnSeconds
    end)
    record.RemovingConnection = player.CharacterRemoving:Connect(function(model)
        if self._players[player] == record and record.Model == model then
            self:_scheduleRespawn(player, record)
        end
    end)
    self:_clearCharacter(player, record, true)
    self:_load(player)
    self:SendState()
end

function WorldService:RemovePlayer(player)
    local record = self._players[player]
    if not record then return end
    record.Generation += 1
    record.Request = nil
    record.AddedConnection:Disconnect()
    record.RemovingConnection:Disconnect()
    self:_clearCharacter(player, record, false)
    self._players[player] = nil
    self:SendState()
end

function WorldService:_alive(player)
    local record = self._players[player]
    local state = self.Combat:GetState(player)
    if not record or not record.State.KingdomId or player:GetAttribute("Activity") ~= "World" then return nil, "ChooseKingdom" end
    if not state or state.Dead or record.Model ~= state.Model or player.Character ~= state.Model or not state.Model.Parent
        or state.Humanoid.Health <= 0 or state.Humanoid.Parent ~= state.Model or state.Root.Parent ~= state.Model or not finitePosition(state.Root.Position)
        or state.TeamId ~= record.State.KingdomId then return nil, "Dead" end
    return state
end

function WorldService:_inReach(state, view, distance)
    if not finitePosition(view.Position) or (state.Root.Position - view.Position).Magnitude > distance then return false, "TooFar" end
    local target = view.Position + (view.Kind and Vector3.zero or Vector3.new(0, 2, 0))
    local parameters = RaycastParams.new()
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = { state.Model }
    parameters.RespectCanCollide = false
    local result = Workspace:Raycast(state.Root.Position, target - state.Root.Position, parameters)
    if result and (not view.Model or not result.Instance:IsDescendantOf(view.Model)) then return false, "Obstructed" end
    return true
end

function WorldService:HandleAction(player, action, payload)
    local record = self._players[player]
    if not record then return false, "UnknownPlayer" end
    if type(payload) ~= "table" then return false, "Malformed" end
    local now = self._clock()
    if action == "ChooseKingdom" then
        if not identifier(payload.KingdomId) then return false, "Malformed" end
        if record.State.KingdomId then
            local state, reason = self:_alive(player)
            if not state then return false, reason end
            local lastCombat = math.max(state.LastDamagedAt or -math.huge, state.LastAttackAt or -math.huge, state.LastWorkAt or -math.huge)
            if state.PendingAttack or now - lastCombat < Config.World.KingdomChangeSafeSeconds then return false, "CombatLocked" end
        end
        local accepted, reason = Rules.ChooseKingdom(record.State, payload.KingdomId, Config, now)
        if not accepted then return false, reason end
        record.Generation += 1
        record.Request, record.SpawnOutpostId = nil, nil
        self:_setKingdom(player, record.State.KingdomId)
        self:_clearCharacter(player, record, true)
        self:_load(player)
        self:SendState()
        return true
    end
    local state, reason = self:_alive(player)
    if not state then return false, reason end
    if action == "Harvest" then
        if not identifier(payload.NodeId) then return false, "Malformed" end
        local entry = self._nodes[payload.NodeId]
        if not entry then return false, "UnknownNode" end
        local allowed, failure = Rules.CanHarvest(record.State, entry.State, Config, now)
        if not allowed then return false, failure end
        allowed, failure = self:_inReach(state, entry.View, Config.World.HarvestRange)
        if not allowed then return false, failure end
        allowed, failure = self.Combat:SpendEffort(player, Config.World.HarvestStaminaCost)
        if not allowed then return false, failure end
        -- No yield between the rule check, stamina spend and authoritative hit.
        local accepted, result = Rules.Harvest(record.State, entry.State, Config, now)
        if not accepted then return false, result end
        self:_renderNode(entry)
        self:SendState()
        return true
    elseif action == "BuildOutpost" then
        if not identifier(payload.OutpostId) then return false, "Malformed" end
        local entry = self._outposts[payload.OutpostId]
        if not entry then return false, "UnknownOutpost" end
        local allowed, failure = self:_inReach(state, entry.View, Config.World.BuildRange)
        if not allowed then return false, failure end
        local accepted, buildReason = Rules.BuildOutpost(record.State, entry.State, Config)
        if not accepted then return false, buildReason end
        self:_renderOutpost(entry)
        self:SendState()
        return true
    elseif action == "SetOutpostSpawn" then
        if type(payload.OutpostId) ~= "string" or #payload.OutpostId > 48 then return false, "Malformed" end
        if payload.OutpostId == "" then record.SpawnOutpostId = nil
        else
            local entry = self._outposts[payload.OutpostId]
            if not entry then return false, "UnknownOutpost" end
            if entry.State.Owner ~= record.State.KingdomId then return false, "NotOwner" end
            if not entry.State.Built then return false, "NotBuilt" end
            record.SpawnOutpostId = payload.OutpostId
        end
        self:SendState(player)
        return true
    end
    return false, "UnknownAction"
end

function WorldService:_onDeath(victim, killer)
    local player = victim.Subject
    local record = self._players[player]
    if not record or record.Model ~= victim.Model or self._deaths[victim.Model] or not record.State.KingdomId then return end
    self._deaths[victim.Model] = true
    local deaths = statistic(player, "Deaths")
    if deaths then deaths.Value += 1 end
    if killer and killer.Subject ~= player then
        local killerRecord = self._players[killer.Subject]
        if killerRecord and killerRecord.Model == killer.Model and killer.TeamId ~= victim.TeamId then
            local kills = statistic(killer.Subject, "Kills")
            if kills then kills.Value += 1 end
            if self.Remotes.Effects then self.Remotes.Effects:FireAllClients("Killfeed", {
                Killer = killer.Subject.DisplayName, Victim = player.DisplayName, TeamId = killer.TeamId,
            }) end
        end
    end
    self:_scheduleRespawn(player, record)
    self:SendState()
end

function WorldService:Start()
    if self._started then return end
    self._started = true
    self.Combat:SetEnabled(true)
    self:SendState()
end

function WorldService:SendState(player)
    local now = self._clock()
    local offset = self._serverTime() - now
    local kingdoms, outposts, nodes = {}, {}, {}
    local counts = {}
    for _, record in pairs(self._players) do
        local id = record.State.KingdomId
        if id then counts[id] = (counts[id] or 0) + 1 end
    end
    for _, id in ipairs(Config.KingdomOrder) do
        local definition = Config.Kingdoms[id]
        table.insert(kingdoms, { Id = id, Name = definition.Name, Color = definition.Color, Players = counts[id] or 0 })
    end
    for _, id in ipairs(orderedKeys(self._outposts)) do
        local entry = self._outposts[id]
        local point = entry.State
        table.insert(outposts, { Id = id, Name = entry.View.Name, Owner = point.Owner, Claimant = point.Claimant,
            Progress = point.Progress, Contested = point.Contested, Built = point.Built, Position = entry.View.Position })
    end
    for _, id in ipairs(orderedKeys(self._nodes)) do
        local entry = self._nodes[id]
        table.insert(nodes, { Id = id, Kind = entry.State.Kind, Position = entry.View.Position, HitsRemaining = entry.State.HitsRemaining,
            RespawnAt = entry.State.RespawnAt > 0 and entry.State.RespawnAt + offset or 0 })
    end
    local function send(subject, record)
        if subject.Parent ~= Players then return end
        self.Remotes.World:FireClient(subject, { KingdomId = record.State.KingdomId,
            KingdomChangeReadyAt = record.State.KingdomId and math.max(now, record.State.LastKingdomAt + Config.World.KingdomChangeCooldown) + offset or 0,
            Inventory = { Wood = record.State.Wood, Ore = record.State.Ore }, Kingdoms = kingdoms, Outposts = outposts, Nodes = nodes,
            SpawnOutpostId = record.SpawnOutpostId, RespawnAt = record.RespawnAt and record.RespawnAt + offset or nil })
    end
    if player then
        if self._players[player] then send(player, self._players[player]) end
    else
        for subject, record in pairs(self._players) do send(subject, record) end
    end
end

function WorldService:Step(dt)
    if not self._started or not finite(dt) or dt < 0 then return end
    local now, changed = self._clock(), false
    for player, record in pairs(self._players) do
        local model = record.Model
        if model then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            local root = model:FindFirstChild("HumanoidRootPart")
            local state = self.Combat:GetState(player)
            if record.State.KingdomId and state and state.Model == model
                and (state.Dead or (humanoid and humanoid.Health <= 0)) then
                -- Combat reports deaths through a deferred callback. The world
                -- may step first, so account for this same death now; the model
                -- identity/death guard rejects the delayed duplicate callback.
                local killer = state.LastAttacker
                if killer and now - (state.LastHitAt or -math.huge) > 10 then killer = nil end
                self:_onDeath(state, killer)
            elseif not model.Parent or player.Character ~= model or not humanoid or not root or humanoid.Health <= 0
                or (record.State.KingdomId and (not state or state.Model ~= model or state.Root ~= root or state.Humanoid ~= humanoid)) then
                self:_scheduleRespawn(player, record)
                changed = true
            end
        end
        if not record.Model and not record.Request and not self:_currentRequest(player, record, record.ActiveRequest)
            and (not record.RespawnAt or now >= record.RespawnAt) then self:_load(player) end
    end
    for _, entry in pairs(self._nodes) do
        if Rules.RefreshNode(entry.State, Config, now) then self:_renderNode(entry); changed = true end
    end
    for _, entry in pairs(self._outposts) do
        local counts = {}
        for player, record in pairs(self._players) do
            local state = self:_alive(player)
            if state and (state.Root.Position - entry.View.Position).Magnitude <= Config.World.CaptureRadius then
                local kingdom = record.State.KingdomId
                counts[kingdom] = (counts[kingdom] or 0) + 1
            end
        end
        if Rules.StepCapture(entry.State, counts, Config, dt) then self:_renderOutpost(entry); changed = true end
    end
    self._snapshotElapsed += dt
    self._snapshotDirty = self._snapshotDirty or changed
    -- Capture progress changes every heartbeat. Bound full-world snapshots to
    -- five per second while a point changes, and once per second when idle.
    if (self._snapshotDirty and self._snapshotElapsed >= 0.2) or self._snapshotElapsed >= 1 then
        self._snapshotElapsed, self._snapshotDirty = 0, false
        self:SendState()
    end
end

return WorldService
]]></string>
        </Properties>
