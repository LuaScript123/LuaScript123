        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">CameraLock</string>
            <string name="Source"><![CDATA[-- Keep Roblox's camera controller; Ctrl only adds the PvP shoulder offset and facing.
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")

local CameraLock = {}
CameraLock.__index = CameraLock

function CameraLock.new(player)
	local self = setmetatable({
		Player = player, Enabled = false, MenuOpen = false, Spectating = false,
		WindowFocused = true, RobloxMenuOpen = false, Applied = false,
		Humanoid = nil, SavedOffset = Vector3.zero, SavedAutoRotate = true,
		Connections = {},
	}, CameraLock)
	local function connect(signal, callback)
		table.insert(self.Connections, signal:Connect(callback))
	end
	connect(UserInputService.InputBegan, function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() or self.MenuOpen or self.RobloxMenuOpen then return end
		if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then self:Toggle() end
	end)
	connect(UserInputService.WindowFocusReleased, function()
		self.WindowFocused = false
		self:_release()
	end)
	connect(UserInputService.WindowFocused, function() self.WindowFocused = true end)
	connect(UserInputService.TextBoxFocused, function() self:_release() end)
	connect(GuiService.MenuOpened, function()
		self.RobloxMenuOpen = true
		self:_release()
	end)
	connect(GuiService.MenuClosed, function() self.RobloxMenuOpen = false end)
	connect(player.CharacterRemoving, function() self:_release() end)
	self.Binding = "FerEtFiolesControlLock_" .. player.UserId
	RunService:BindToRenderStep(self.Binding, Enum.RenderPriority.Camera.Value + 1, function() self:_step() end)
	return self
end

function CameraLock:_release()
	if self.Applied then
		local humanoid = self.Humanoid
		if humanoid and humanoid.Parent then
			humanoid.CameraOffset = self.SavedOffset
			humanoid.AutoRotate = self.SavedAutoRotate
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = self.SavedMouseIcon
	end
	self.Applied = false
	self.Humanoid = nil
end

function CameraLock:_step()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local active = self.Enabled and self.WindowFocused and not self.MenuOpen and not self.RobloxMenuOpen
		and not self.Spectating and not UserInputService:GetFocusedTextBox()
		and humanoid and humanoid.Health > 0 and root and camera
		and camera.CameraType == Enum.CameraType.Custom and camera.CameraSubject == humanoid
	if not active then self:_release() return end
	if self.Humanoid ~= humanoid then
		self:_release()
		self.Humanoid = humanoid
		self.SavedOffset = humanoid.CameraOffset
		self.SavedAutoRotate = humanoid.AutoRotate
		self.SavedMouseIcon = UserInputService.MouseIconEnabled
	end
	self.Applied = true
	humanoid.CameraOffset = self.SavedOffset + Vector3.new(1.75, 0.25, 0)
	humanoid.AutoRotate = false
	if UserInputService.MouseEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end
	local direction = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	if direction.Magnitude > 0.001 and not root.Anchored then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + direction.Unit)
	end
end

function CameraLock:Toggle()
	self.Enabled = not self.Enabled
	if not self.Enabled then self:_release() end
	return self.Enabled
end

function CameraLock:SetMenuOpen(open)
	self.MenuOpen = open == true
	if self.MenuOpen then self:_release() end
end

function CameraLock:SetSpectating(spectating)
	self.Spectating = spectating == true
	if self.Spectating then self:_release() end
end

function CameraLock:Destroy()
	self:_release()
	RunService:UnbindFromRenderStep(self.Binding)
	for _, connection in ipairs(self.Connections) do connection:Disconnect() end
end

return CameraLock
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[-- HUD and input only. Combat, healing, inventory and stamina remain authoritative on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("MedievalShared")
local Config = require(shared:WaitForChild("Config"))
local worldMode = Config.Game.Mode == "Kingdoms"
local Catalog = require(shared:WaitForChild("Catalog"))
local LobbyUI = require(script.Parent:WaitForChild("LobbyUI"))
local CameraLock = require(script.Parent:WaitForChild("CameraLock"))
local remotes = ReplicatedStorage:WaitForChild("MedievalRemotes")
local Action = remotes:WaitForChild("Action")
local State = remotes:WaitForChild("State")
local Effects = remotes:WaitForChild("Effects")
local Lobby = remotes:WaitForChild("Lobby")
local Profile = remotes:WaitForChild("Profile")
local World = remotes:WaitForChild("World")

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local palette = {
	Panel = Color3.fromRGB(25, 29, 34), Inset = Color3.fromRGB(13, 17, 21),
	Text = Color3.fromRGB(245, 236, 217), Muted = Color3.fromRGB(177, 181, 184),
	Gold = Color3.fromRGB(222, 181, 99), Stroke = Color3.fromRGB(101, 91, 72),
	Health = Color3.fromRGB(117, 192, 140), Danger = Color3.fromRGB(229, 105, 91),
}

local function rgb(values)
	return Color3.fromRGB(values[1], values[2], values[3])
end

local function create(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties) do object[key] = value end
	object.Parent = parent
	return object
end

local function corners(parent, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function outline(parent, color, transparency)
	return create("UIStroke", {
		Color = color or palette.Stroke, Thickness = 1,
		Transparency = transparency or 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function panel(parent, properties)
	properties.BackgroundColor3 = properties.BackgroundColor3 or palette.Panel
	properties.BackgroundTransparency = properties.BackgroundTransparency or 0.08
	properties.BorderSizePixel = 0
	local object = create("Frame", properties, parent)
	corners(object, 10)
	outline(object)
	return object
end

local function label(parent, text, properties)
	properties = properties or {}
	properties.Text = text
	properties.BackgroundTransparency = 1
	properties.BorderSizePixel = 0
	properties.Font = properties.Font or Enum.Font.GothamMedium
	properties.TextColor3 = properties.TextColor3 or palette.Text
	properties.TextSize = properties.TextSize or 14
	properties.TextXAlignment = properties.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", properties, parent)
end

local function button(parent, text, properties)
	properties.Text = text
	properties.Font = Enum.Font.GothamBold
	properties.TextSize = properties.TextSize or 14
	properties.TextColor3 = palette.Text
	properties.BackgroundColor3 = properties.BackgroundColor3 or palette.Panel
	properties.BackgroundTransparency = 0.06
	properties.BorderSizePixel = 0
	properties.AutoButtonColor = true
	local object = create("TextButton", properties, parent)
	corners(object, 10)
	outline(object)
	return object
end

