  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">MedievalServer</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[-- Local R6 guards fill the LOCKED preparation roster. Step never creates a bot.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Config = require(ReplicatedStorage:WaitForChild("MedievalShared"):WaitForChild("Config"))

local BotService = {}
BotService.__index = BotService

local function bodyPart(model, name, size, position, color, collidable)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = CFrame.new(position)
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.CanCollide = collidable == true
    part.Massless = name ~= "HumanoidRootPart"
    part.Parent = model
    return part
end

local function joint(parent, name, part0, part1, offset0, offset1)
    local motor = Instance.new("Motor6D")
    motor.Name = name
    motor.Part0 = part0
    motor.Part1 = part1
    motor.C0 = CFrame.new(offset0)
    motor.C1 = CFrame.new(offset1)
    motor.Parent = parent
    return motor
end

local function createRig(teamId)
    local definition = Config.Teams[teamId]
    local color = Color3.fromRGB(table.unpack(definition.Color))
    local steel = Color3.fromRGB(95, 105, 113)
    local skin = Color3.fromRGB(218, 179, 139)
    local model = Instance.new("Model")
    model.Name = "Garde_" .. teamId
    model:SetAttribute("IsBot", true)
    model:SetAttribute("TeamId", teamId)

    local root = bodyPart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.zero, steel, false)
    root.Transparency = 1
    local torso = bodyPart(model, "Torso", Vector3.new(2, 2, 1), Vector3.zero, color, true)
    local head = bodyPart(model, "Head", Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0), skin, false)
    local leftArm = bodyPart(model, "Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0), steel, false)
    local rightArm = bodyPart(model, "Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0), steel, false)
    local leftLeg = bodyPart(model, "Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0), steel, false)
    local rightLeg = bodyPart(model, "Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0), steel, false)
    joint(root, "RootJoint", root, torso, Vector3.zero, Vector3.zero)
    joint(torso, "Neck", torso, head, Vector3.new(0, 1, 0), Vector3.new(0, -0.5, 0))
    joint(torso, "Left Shoulder", torso, leftArm, Vector3.new(-1.5, 0.5, 0), Vector3.new(0, 0.5, 0))
    joint(torso, "Right Shoulder", torso, rightArm, Vector3.new(1.5, 0.5, 0), Vector3.new(0, 0.5, 0))
    joint(torso, "Left Hip", torso, leftLeg, Vector3.new(-0.5, -1, 0), Vector3.new(0, 1, 0))
    joint(torso, "Right Hip", torso, rightLeg, Vector3.new(0.5, -1, 0), Vector3.new(0, 1, 0))
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Head
    mesh.Scale = Vector3.new(1.1, 1.1, 1.1)
    mesh.Parent = head
    local helmet = bodyPart(model, "Helmet", Vector3.new(2.15, 0.5, 1.15), Vector3.new(0, 1.95, 0), steel, false)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = head
    weld.Part1 = helmet
    weld.Parent = helmet

    local humanoid = Instance.new("Humanoid")
    humanoid.Name = "Humanoid"
    humanoid.DisplayName = "Garde " .. definition.Name
    humanoid.RigType = Enum.HumanoidRigType.R6
    humanoid.MaxHealth = Config.Player.MaxHealth
    humanoid.Health = Config.Player.MaxHealth
    humanoid.WalkSpeed = Config.Player.WalkSpeed
    humanoid.HipHeight = 0
    humanoid.BreakJointsOnDeath = false
    humanoid.NameDisplayDistance = 45
    humanoid.HealthDisplayDistance = 45
    humanoid.Parent = model
    model.PrimaryPart = root
    return model, humanoid, root
end

function BotService.new(map, combat, match)
    local self = setmetatable({}, BotService)
    self.Map = map
    self.Combat = combat
    self.Match = match
    self._round = match.Round
    self._slots = {}
    self._destroyed = false
    match:SetBotService(self)
    return self
end

function BotService:_remove(slot)
    if slot.Model then
        self.Combat:Unregister(slot.Model)
        slot.Model:Destroy()
    end
    slot.Model = nil
    slot.Humanoid = nil
    slot.Root = nil
    slot.Target = nil
    slot.Dead = false
end

function BotService:Cleanup()
    for _, slot in pairs(self._slots) do
        self:_remove(slot)
    end
    self._slots = {}
end

function BotService:Prepare(roster, round, epoch)
    if self._destroyed then error("Bot service has been destroyed") end
    self:Cleanup()
    self._round, self._epoch = round, epoch
    local index = 0
    for id, member in pairs(roster.Members) do
        if member.IsBot then
            index += 1
            local slot = { Id = id, TeamId = member.TeamId, Side = index % 2 == 0 and -1 or 1 }
            self._slots[id] = slot
            self:_spawn(slot, os.clock())
        end
    end
end

function BotService:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    self:Cleanup()
end

function BotService:_spawn(slot, now)
    local model, humanoid, root = createRig(slot.TeamId)
    model:SetAttribute("MatchRound", self.Match.Round)
    model.Name = "Garde_" .. slot.Id
    model:PivotTo(self.Match:GetSpawn(slot.TeamId))
    model.Parent = Workspace
    slot.Model = model
    slot.Humanoid = humanoid
    slot.Root = root
    root:SetNetworkOwner(nil)
    slot.Dead = false
    slot.NextThink = 0
    slot.NextAttack = now + 1
    slot.NextPotion = now + 1
    slot.NextJump = now + 1
    slot.LastPosition = root.Position
    slot.LastProgress = now
    slot.RaycastParams = RaycastParams.new()
    slot.RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    slot.RaycastParams.FilterDescendantsInstances = { model }
    slot.RaycastParams.RespectCanCollide = true
    if not self.Match:RegisterBot(slot.Id, model, slot.TeamId, self._round, self._epoch) then
        self:_remove(slot)
        error("Bot registration rejected for a stale or invalid preparation")
    end
end

function BotService:_target(slot)
    local nearest = nil
    local bestDistance = math.huge
    for _, state in pairs(self.Combat:GetStates()) do
        if state.TeamId ~= slot.TeamId and not state.Dead and state.Humanoid.Health > 0
            and state.Root.Parent and state.Model.Parent then
            local distance = (state.Root.Position - slot.Root.Position).Magnitude
            if distance < bestDistance then
                nearest = state
                bestDistance = distance
            end
        end
    end
    return nearest
end

function BotService:_think(slot, now)
    if self.Match.Phase ~= "Battle" then
        slot.Humanoid:MoveTo(slot.Root.Position)
        self.Combat:Act(slot.Model, "Sprint", { Active = false })
        return
    end
    local ownState = self.Combat:GetState(slot.Model)
    if not ownState or ownState.Dead then
        return
    end
    local target = self:_target(slot)
    slot.Target = target
    if not target then
        slot.Humanoid:MoveTo(slot.Root.Position)
        self.Combat:Act(slot.Model, "Sprint", { Active = false })
        return
    end

    if now >= slot.NextPotion then
        local missing = slot.Humanoid.MaxHealth - slot.Humanoid.Health
        for _, size in ipairs({ "Large", "Medium", "Small" }) do
            if missing >= Config.Potions[size].Heal - 5
                and (slot.Model:GetAttribute("Potions" .. size) or 0) > 0 then
                self.Combat:Act(slot.Model, "Potion", { Size = size })
                slot.NextPotion = now + Config.PotionCooldown + 0.1
                break
            end
        end
    end

    local offset = target.Root.Position - slot.Root.Position
    local planar = Vector3.new(offset.X, 0, offset.Z)
    local distance = planar.Magnitude
    if distance < 0.05 then
        return
    end
    local direction = planar.Unit
    self.Combat:Act(slot.Model, "Sprint", { Active = distance > 24 and ownState.Stamina > 30 })

    if (slot.Root.Position - slot.LastPosition).Magnitude >= 2 then
        slot.LastPosition = slot.Root.Position
        slot.LastProgress = now
    end
    local obstruction = Workspace:Raycast(slot.Root.Position + Vector3.new(0, 0.5, 0), direction * math.min(distance, 7), slot.RaycastParams)
    local blocked = obstruction and not obstruction.Instance:IsDescendantOf(target.Model)
    local goal = target.Root.Position - direction * 4
    if blocked or now - slot.LastProgress > 1.5 then
        if now - slot.LastProgress > 1.5 then
            slot.Side *= -1
            slot.LastProgress = now
        end
        local sideways = Vector3.new(-direction.Z, 0, direction.X) * slot.Side
        if Workspace:Raycast(slot.Root.Position, sideways * 7, slot.RaycastParams) then
            slot.Side *= -1
            sideways *= -1
        end
        goal = slot.Root.Position + sideways * 10 + direction * 3
        if now >= slot.NextJump then
            slot.Humanoid.Jump = true
            slot.NextJump = now + 1.2
        end
    end
    if distance > 5 or blocked then
        slot.Humanoid:MoveTo(goal)
    else
        slot.Humanoid:MoveTo(slot.Root.Position)
        slot.Root.CFrame = CFrame.lookAt(slot.Root.Position, slot.Root.Position + direction)
    end
    if distance <= Config.Combat.AttackRange - 0.5 and math.abs(offset.Y) < 5 and not blocked and now >= slot.NextAttack then
        self.Combat:Act(slot.Model, "Attack", { Aim = direction })
        slot.NextAttack = now + Config.Combat.AttackCooldown + 0.14
    end
end

function BotService:Step(_dt)
    if self._destroyed then
        return
    end
    local now = os.clock()
    for _, slot in pairs(self._slots) do
        -- Death is irreversible for this slot; no stock refill, replacement,
        -- despawn-on-human-arrival, or delayed respawn can occur in Battle.
        if slot.Model and (not slot.Model.Parent or slot.Humanoid.Health <= 0) then slot.Dead = true end
        if slot.Model and not slot.Dead and now >= slot.NextThink then
            slot.NextThink = now + 0.2
            if self._round == self.Match.Round then self:_think(slot, now) end
        end
    end
end

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("MedievalShared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("CombatRules"))

local CombatService = {}
CombatService.__index = CombatService

local function isPlayer(subject)
    return typeof(subject) == "Instance" and subject:IsA("Player")
end

local function finiteVector(vector)
    return typeof(vector) == "Vector3"
        and Rules.IsFinite(vector.X)
        and Rules.IsFinite(vector.Y)
        and Rules.IsFinite(vector.Z)
end

local function horizontalDirection(vector)
    if not finiteVector(vector) then
        return nil
    end
    -- A bound also avoids overflow when normalizing malicious remote input.
    if math.abs(vector.X) > 1000000 or math.abs(vector.Y) > 1000000 or math.abs(vector.Z) > 1000000 then
        return nil
    end
    local flat = Vector3.new(vector.X, 0, vector.Z)
    if flat.Magnitude < 0.001 then
        return nil
    end
    return flat.Unit
end

local function swordPart(model, name, size, color, material)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Material = material
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = model
    return part
end

local function buildSword(model)
    local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
    if not hand or not hand:IsA("BasePart") then
        return nil
    end
    local sword = Instance.new("Model")
    sword.Name = "FerSword"
    local handle = swordPart(sword, "Grip", Vector3.new(0.23, 0.75, 0.23), Color3.fromRGB(81, 51, 33), Enum.Material.Wood)
    local isR6 = hand.Name == "Right Arm"
    local gripFrame = CFrame.new(0, isR6 and -0.85 or -0.15, -0.35) * CFrame.Angles(-math.pi / 2, 0, 0)
    handle.CFrame = hand.CFrame * gripFrame
    for _, specification in ipairs({
        { "Pommel", Vector3.new(0.36, 0.2, 0.36), -0.42, Color3.fromRGB(209, 171, 89), Enum.Material.Metal },
        { "Guard", Vector3.new(1.05, 0.16, 0.3), 0.45, Color3.fromRGB(209, 171, 89), Enum.Material.Metal },
        { "Blade", Vector3.new(0.36, 2.8, 0.12), 1.9, Color3.fromRGB(201, 217, 229), Enum.Material.Metal },
        { "Tip", Vector3.new(0.24, 0.38, 0.12), 3.48, Color3.fromRGB(228, 237, 242), Enum.Material.Metal },
    }) do
        local part = swordPart(sword, specification[1], specification[2], specification[4], specification[5])
        part.CFrame = handle.CFrame * CFrame.new(0, specification[3], 0)
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = part
        weld.Parent = part
    end
    sword.PrimaryPart = handle
    sword.Parent = model
    local joint = Instance.new("Motor6D")
    joint.Name = "FerSwordGrip"
    joint.Part0 = hand
    joint.Part1 = handle
    joint.C0 = gripFrame
    joint.Parent = hand
    return sword, joint, gripFrame
end

function CombatService.new(remotes)
    return setmetatable({
        _remotes = remotes,
        _states = {},
        _enabled = false,
        OnDeath = nil,
    }, CombatService)
end

function CombatService:_effect(kind, payload)
    self._remotes.Effects:FireAllClients(kind, payload)
end

function CombatService:_sync(state, now)
    if not state.Model.Parent then
        return
    end
    state.Model:SetAttribute("Combatant", true)
    state.Model:SetAttribute("TeamId", state.TeamId)
    state.Model:SetAttribute("Stamina", math.floor(state.Stamina * 10 + 0.5) / 10)
    state.Model:SetAttribute("MaxStamina", Config.Combat.MaxStamina)
    state.Model:SetAttribute("Sprinting", state.Sprinting)
    state.Model:SetAttribute("SpawnProtected", not state.Dead and now < state.SpawnProtectedUntil)
    state.Model:SetAttribute("PotionReadyAt", state.PotionReadyAt or 0)
    state.Model:SetAttribute("PotionCooldown", Config.PotionCooldown)
    for _, size in ipairs(Config.PotionOrder) do
        state.Model:SetAttribute("Potions" .. size, state.Potions[size])
    end
end

function CombatService:_markDead(state)
    if state.Dead then
        return
    end
    state.Dead = true
    state.Sprinting = false
    state.PendingAttack = nil
    self:_sync(state, os.clock())
    local killer = state.LastAttacker
    if killer and os.clock() - (state.LastHitAt or -math.huge) > 10 then
        killer = nil
    end
    self:_effect("Death", { Actor = state.Model, Position = state.Root.Position, TeamId = state.TeamId })
    -- Match callbacks may schedule respawns or end the round. They run outside
    -- the damage iteration, which leaves this service's table stable.
    task.defer(function()
        if self.OnDeath then
            local ok, problem = pcall(self.OnDeath, state, killer)
            if not ok then
                warn("Combat death callback failed: " .. tostring(problem))
            end
        end
    end)
end

function CombatService:Register(subject, model, teamId)
    self:Unregister(subject)
    if typeof(model) ~= "Instance" or not model:IsA("Model") or Config.Teams[teamId] == nil then
        return nil
    end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or not root:IsA("BasePart") or humanoid.Health <= 0 then
        return nil
    end
    local now = os.clock()
    local state = Rules.NewState(Config, now)
    state.Subject = subject
    state.Model = model
    state.Humanoid = humanoid
    state.Root = root
    state.TeamId = teamId
    state.RateTokens = Config.Combat.MaxActionRate
    state.RateUpdatedAt = now
    state.NextAttributeAt = 0
    state.PotionReadyAt = 0
    state.Sword, state.SwordJoint, state.SwordGrip = buildSword(model)
    humanoid.MaxHealth = Config.Player.MaxHealth
    humanoid.Health = Config.Player.MaxHealth
    humanoid.WalkSpeed = Config.Player.WalkSpeed
    state.DeathConnection = humanoid.Died:Connect(function()
        self:_markDead(state)
    end)
    self._states[subject] = state
    if isPlayer(subject) then
        subject:SetAttribute("TeamId", teamId)
    end
    self:_sync(state, now)
    return state
end

function CombatService:Unregister(subject)
    local state = self._states[subject]
    if not state then
        return
    end
    self._states[subject] = nil
    if state.DeathConnection then
        state.DeathConnection:Disconnect()
    end
    if state.SwordTween then
        state.SwordTween:Cancel()
    end
    if state.SwordJoint then
        state.SwordJoint:Destroy()
    end
    if state.Sword then
        state.Sword:Destroy()
    end
    if state.Model.Parent then
        state.Model:SetAttribute("Combatant", false)
        state.Model:SetAttribute("Sprinting", false)
    end
end

function CombatService:GetState(subject)
    return self._states[subject]
end

function CombatService:GetStates()
    return self._states
end

function CombatService:SetEnabled(enabled)
    self._enabled = enabled == true
    if not self._enabled then
        for _, state in pairs(self._states) do
            state.PendingAttack = nil
            state.Sprinting = false
            if state.Humanoid.Parent and not state.Dead then
                state.Humanoid.WalkSpeed = Config.Player.WalkSpeed
            end
            self:_sync(state, os.clock())
        end
    end
end

function CombatService:_swing(state)
    if not state.SwordJoint or not state.SwordJoint.Parent then
        return
    end
    if state.SwordTween then
        state.SwordTween:Cancel()
    end
    -- Animate only the held sword. Neither locomotion nor the rig's animation
    -- controller is locked during attacks.
    state.SwordJoint.C0 = state.SwordGrip * CFrame.Angles(0, -1.15, 0.25)
    state.SwordTween = TweenService:Create(state.SwordJoint, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = state.SwordGrip })
    state.SwordTween:Play()
end

function CombatService:Act(subject, action, payload)
    local state = self._states[subject]
    if not state then
        return false, "UnknownCombatant"
    end
    local now = os.clock()
    state.RateTokens = math.min(Config.Combat.MaxActionRate, state.RateTokens + (now - state.RateUpdatedAt) * Config.Combat.MaxActionRate)
    state.RateUpdatedAt = now
    if state.RateTokens < 1 then
        return false, "RateLimited"
    end
    state.RateTokens = state.RateTokens - 1
    if type(action) ~= "string" or type(payload) ~= "table" then
        return false, "Malformed"
    end
    if state.Dead or state.Humanoid.Health <= 0 or not state.Model.Parent or not state.Root.Parent then
        return false, "Dead"
    end
    if action == "Sprint" and payload.Active == false then
        state.Sprinting = false
        state.Humanoid.WalkSpeed = Config.Player.WalkSpeed
        self:_sync(state, now)
        return true
    end
    if not self._enabled then
        return false, "Intermission"
    end
    if action == "Attack" then
        local direction = horizontalDirection(payload.Aim)
        if not direction then
            return false, "InvalidAim"
        end
        local allowed, reason = Rules.ConsumeAttack(state, Config, now)
        if not allowed then
            return false, reason
        end
        state.PendingAttack = { At = now + Config.Combat.AttackWindup, Direction = direction }
        self:_swing(state)
        self:_effect("Swing", { Actor = state.Model, Position = state.Root.Position, Direction = direction, TeamId = state.TeamId })
    elseif action == "Sprint" then
        if type(payload.Active) ~= "boolean" then
            return false, "Malformed"
        end
        if state.Stamina <= 0 then
            return false, "Stamina"
        end
        state.Sprinting = payload.Active
        state.Humanoid.WalkSpeed = state.Sprinting and Config.Player.SprintSpeed or Config.Player.WalkSpeed
    elseif action == "Potion" then
        local consumed, result = Rules.ConsumePotion(state, Config, payload.Size, state.Humanoid.Health, state.Humanoid.MaxHealth, now)
        if not consumed then
            return false, result
        end
        state.Humanoid.Health = result
        state.PotionReadyAt = Workspace:GetServerTimeNow() + Config.PotionCooldown
        self:_effect("Potion", { Actor = state.Model, Position = state.Root.Position, Size = payload.Size, TeamId = state.TeamId })
    else
        return false, "UnknownAction"
    end
    self:_sync(state, now)
    return true
end

function CombatService:HandleAction(player, action, payload)
    return self:Act(player, action, payload)
end

function CombatService:_resolveAttack(attacker, direction, now)
    if not self._enabled or attacker.Dead or attacker.Humanoid.Health <= 0 or not attacker.Root.Parent then
        return
    end
    local origin = attacker.Root.Position
    if not finiteVector(origin) then
        return
    end
    local candidates = {}
    for _, target in pairs(self._states) do
        if Rules.CanDamage(attacker, target, now) and target.Model.Parent and target.Root.Parent and target.Humanoid.Health > 0 then
            local offset = target.Root.Position - origin
            if finiteVector(offset) then
                local flat = Vector3.new(offset.X, 0, offset.Z)
                local dot = flat.Magnitude > 0.001 and direction:Dot(flat.Unit) or 1
                local distance = offset.Magnitude
                if Rules.InAttackArc(distance, dot, Config) then
                    candidates[#candidates + 1] = { State = target, Distance = distance }
                end
            end
        end
    end
    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)
    local rayParameters = RaycastParams.new()
    rayParameters.FilterType = Enum.RaycastFilterType.Exclude
    rayParameters.FilterDescendantsInstances = { attacker.Model }
    local eye = origin + Vector3.new(0, 1, 0)
    for _, candidate in ipairs(candidates) do
        local target = candidate.State
        local ray = Workspace:Raycast(eye, target.Root.Position + Vector3.new(0, 1, 0) - eye, rayParameters)
        if not ray or ray.Instance:IsDescendantOf(target.Model) then
            local previousAttacker = target.LastAttacker
            local previousHitAt = target.LastHitAt
            local before = target.Humanoid.Health
            target.LastAttacker = attacker
            target.LastHitAt = now
            target.Humanoid:TakeDamage(Config.Combat.AttackDamage)
            local damage = math.max(0, before - target.Humanoid.Health)
            if damage > 0 then
                self:_effect("Hit", { Actor = attacker.Model, Target = target.Model, Position = target.Root.Position, Damage = damage, TeamId = attacker.TeamId })
                if target.Humanoid.Health <= 0 then
                    self:_markDead(target)
                end
            else
                target.LastAttacker = previousAttacker
                target.LastHitAt = previousHitAt
            end
            -- One accepted swing can hurt only one enemy.
            return
        end
    end
end

function CombatService:Step(dt)
    if not Rules.IsFinite(dt) or dt <= 0 then
        return
    end
    local now = os.clock()
    for _, state in pairs(self._states) do
        if state.Model.Parent and state.Root.Parent and state.Humanoid.Parent then
            if state.Humanoid.Health <= 0 then
                self:_markDead(state)
            elseif not state.Dead then
                if state.PendingAttack and now >= state.PendingAttack.At then
                    local attack = state.PendingAttack
                    state.PendingAttack = nil
                    self:_resolveAttack(state, attack.Direction, now)
                end
                local velocity = state.Root.AssemblyLinearVelocity
                local moving = finiteVector(velocity) and Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 0.75
                local wasSprinting = state.Sprinting
                Rules.TickStamina(state, Config, dt, now, moving)
                if wasSprinting ~= state.Sprinting then
                    state.Humanoid.WalkSpeed = state.Sprinting and Config.Player.SprintSpeed or Config.Player.WalkSpeed
                end
                if now >= state.NextAttributeAt then
                    self:_sync(state, now)
                    state.NextAttributeAt = now + 0.1
                end
            end
        end
    end
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- The only server entry point. No client request supplies damage or inventory.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

Players.CharacterAutoLoads = false

local remotesFolder = Instance.new("Folder")
remotesFolder.Name = "MedievalRemotes"
local remotes = {}
for _, name in ipairs({ "Action", "State", "Effects" }) do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotesFolder
	remotes[name] = remote
end
remotesFolder.Parent = ReplicatedStorage

local MapBuilder = require(script.Parent.MapBuilder)
local CombatService = require(script.Parent.CombatService)
local MatchService = require(script.Parent.MatchService)
local BotService = require(script.Parent.BotService)

local map = MapBuilder.Build()
local combat = CombatService.new(remotes)
local match = MatchService.new(remotes, map, combat)
local bots = BotService.new(map, combat, match)
local lastReady = {}
local lastFeedback = {}
local feedback = {
	Stamina = "Pas assez d'endurance.",
	FullHealth = "Votre sante est deja au maximum.",
	Empty = "Vous n'avez plus cette potion.",
	Intermission = "Le combat commence a la prochaine manche.",
}

Players.PlayerAdded:Connect(function(player)
	match:AddPlayer(player)
end)
Players.PlayerRemoving:Connect(function(player)
	lastReady[player] = nil
	lastFeedback[player] = nil
	match:RemovePlayer(player)
end)
for _, player in ipairs(Players:GetPlayers()) do
	match:AddPlayer(player)
end

remotes.Action.OnServerEvent:Connect(function(player, action, payload)
	if type(action) ~= "string" or #action > 20 or (payload ~= nil and type(payload) ~= "table") then
		return
	end
	if action == "Ready" then
		local now = os.clock()
		if now - (lastReady[player] or -math.huge) >= 0.5 then
			lastReady[player] = now
			match:SendState(player)
		end
	else
		local accepted, reason = combat:HandleAction(player, action, payload or {})
		local text = not accepted and feedback[reason]
		if not accepted and action == "Potion" and reason == "Cooldown" then
			local state = combat:GetState(player)
			local remaining = state and math.max(0, math.ceil((state.PotionReadyAt or 0) - workspace:GetServerTimeNow())) or 0
			text = string.format("Potion disponible dans %d s.", remaining)
		end
		local now = os.clock()
		if text and now - (lastFeedback[player] or -math.huge) >= 1.5 then
			lastFeedback[player] = now
			remotes.Effects:FireClient(player, "Toast", { Text = text })
		end
	end
end)

match:Start()
RunService.Heartbeat:Connect(function(dt)
	combat:Step(dt)
	match:Step(dt)
	bots:Step(dt)
end)

game:BindToClose(function()
	bots:Destroy()
end)

print("[Fer & Fioles] Serveur pret : epee, endurance, potions Z/X/C.")
]]></string>
        </Properties>
