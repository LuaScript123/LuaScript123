      </Properties>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Intentionally replaces Roblox's default Health script.
-- CombatService owns delayed health regeneration, potions and respawn resets.
-- Do not run Roblox's default regeneration alongside that authoritative timer.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
