      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">CombatRules</string>
          <string name="Source"><![CDATA[-- Pure Lua: no Roblox globals. The server supplies its own monotonic clock.
local Rules = {}

function Rules.IsFinite(value)
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

function Rules.Clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

function Rules.NewState(config, now)
    local potions = {}
    for size, potion in pairs(config.Potions) do
        potions[size] = potion.Count
    end
    return {
        Stamina = config.Combat.MaxStamina,
        Sprinting = false,
        Dead = false,
        SpawnProtectedUntil = now + config.Game.SpawnProtectionSeconds,
        LastAttackAt = -math.huge,
        LastSpendAt = now,
        LastPotionAt = -math.huge,
        NextSwingSide = 1,
        SwingSide = nil,
        Potions = potions,
    }
end

function Rules.ConsumeAttack(state, config, now)
    if state.Dead then
        return false, "Dead"
    end
    if now - state.LastAttackAt < config.Combat.AttackCooldown then
        return false, "Cooldown"
    end
    if state.Stamina < config.Combat.AttackCost then
        return false, "Stamina"
    end
    state.Stamina = math.max(0, state.Stamina - config.Combat.AttackCost)
    state.LastAttackAt = now
    state.LastSpendAt = now
    -- Only accepted attacks advance the two mirrored sword animations.
    state.SwingSide = state.NextSwingSide
    state.NextSwingSide = -state.SwingSide
    -- Taking an offensive action ends the attacker's own protection.
    state.SpawnProtectedUntil = 0
    return true
end

function Rules.TickStamina(state, config, dt, now, moving)
    if state.Dead or not Rules.IsFinite(dt) or dt <= 0 then
        return
    end
    if state.Sprinting and state.Stamina <= 0 then
        state.Sprinting = false
    end
    if state.Sprinting and moving then
        state.Stamina = math.max(0, state.Stamina - config.Combat.SprintDrainPerSecond * dt)
        state.LastSpendAt = now
        if state.Stamina <= 0 then
            state.Sprinting = false
        end
    else
        -- Count only the portion of this step after the regeneration delay.
        local regenerationBegins = state.LastSpendAt + config.Combat.StaminaRegenDelay
        local regenerationTime = math.min(dt, math.max(0, now - regenerationBegins))
        state.Stamina = math.min(config.Combat.MaxStamina, state.Stamina + config.Combat.StaminaRegenPerSecond * regenerationTime)
    end
end

function Rules.ConsumePotion(state, config, size, health, maxHealth, now)
    if state.Dead then
        return false, "Dead"
    end
    if type(size) ~= "string" or config.Potions[size] == nil then
        return false, "InvalidPotion"
    end
    if not Rules.IsFinite(health) or not Rules.IsFinite(maxHealth) or health <= 0 or maxHealth <= 0 then
        return false, "InvalidHealth"
    end
    if health >= maxHealth then
        return false, "FullHealth"
    end
    if now - state.LastPotionAt < config.PotionCooldown then
        return false, "Cooldown"
    end
    if (state.Potions[size] or 0) <= 0 then
        return false, "Empty"
    end
    local newHealth = math.min(maxHealth, health + config.Potions[size].Heal)
    state.Potions[size] = state.Potions[size] - 1
    state.LastPotionAt = now
    return true, newHealth
end

function Rules.InAttackArc(distance, dot, config)
    if not Rules.IsFinite(distance) or not Rules.IsFinite(dot) or distance < 0 then
        return false
    end
    return distance <= config.Combat.AttackRange and dot >= math.cos(math.rad(config.Combat.AttackArc * 0.5))
end

function Rules.CanDamage(attacker, target, now)
    return attacker ~= target
        and not attacker.Dead
        and not target.Dead
        and attacker.TeamId ~= target.TeamId
        and now >= target.SpawnProtectedUntil
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Portable tuning shared by the authoritative server and the HUD.
local Config = {}
Config.Game = {
    Name = "Fer & Fioles",
    TeamSize = 2,
    FillWithBots = false,
    IntermissionSeconds = 8,
    PreparingTimeoutSeconds = 20,
    SpawnProtectionSeconds = 3,
    ResultSeconds = 6,
    LobbyRespawnSeconds = 3,
    AllowedModes = { Duel = true, Teams = true },
}
Config.Invites = { CooldownSeconds = 15, ExpiresSeconds = 25 }
Config.Rewards = { Win = 50, Loss = 10, Draw = 10 }
Config.Persistence = { StoreName = "FerEtFiolesProfiles_v1", AutosaveSeconds = 60, LeaseSeconds = 180 }
Config.Teams = {
    Dawn = { Name = "Bleus", Color = { 75, 151, 222 } },
    Ember = { Name = "Rouges", Color = { 218, 91, 65 } },
}
Config.TeamOrder = { "Dawn", "Ember" }
Config.Player = { MaxHealth = 100, WalkSpeed = 16, SprintSpeed = 24 }
Config.Combat = {
    MaxStamina = 100, AttackCost = 10, AttackDamage = 25, AttackRange = 8, AttackArc = 110,
    AttackWindup = 0.08, AttackCooldown = 0.45, SprintDrainPerSecond = 1,
    StaminaRegenPerSecond = 5, StaminaRegenDelay = 1.5, MaxActionRate = 30,
}
Config.Potions = {
    Small = { Name = "Petite", Key = "Z", Heal = 20, Count = 3, Color = { 102, 211, 135 } },
    Medium = { Name = "Moyenne", Key = "X", Heal = 45, Count = 2, Color = { 82, 174, 233 } },
    Large = { Name = "Grosse", Key = "C", Heal = 75, Count = 1, Color = { 187, 120, 235 } },
}
Config.PotionOrder = { "Small", "Medium", "Large" }
-- One shared cooldown: drinking any size locks all three potions for 60s.
Config.PotionCooldown = 60
return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">InvitationRules</string>
          <string name="Source"><![CDATA[-- Pure invitation state. User IDs are integers (Studio uses negative IDs).
-- All clocks are monotone and supplied by the caller; no Roblox dependencies.
local InvitationRules = {}

local function validId(id)
    return type(id) == "number" and id == id and id ~= math.huge and id ~= -math.huge
        and id ~= 0 and id % 1 == 0
end

local function release(state, invite)
    state.Invites[invite.Id] = nil
    for _, id in ipairs(invite.Members) do
        if state.Reserved[id] == invite.Id then state.Reserved[id] = nil end
    end
end

function InvitationRules.New(cooldownSeconds, expiresSeconds)
    return {
        CooldownSeconds = cooldownSeconds or 15, ExpiresSeconds = expiresSeconds or 25,
        Invites = {}, Reserved = {}, Cooldowns = {}, Serial = 0,
    }
end

function InvitationRules.Get(state, userId)
    local inviteId = state.Reserved[userId]
    return inviteId and state.Invites[inviteId] or nil
end

function InvitationRules.CooldownUntil(state, userId)
    return state.Cooldowns[userId] or 0
end

function InvitationRules.Expire(state, now)
    local expired = {}
    for _, invite in pairs(state.Invites) do
        if now >= invite.ExpiresAt then table.insert(expired, invite) end
    end
    for _, invite in ipairs(expired) do release(state, invite) end
    return #expired
end

function InvitationRules.Create(state, hostId, mode, memberIds, now, available, arenaBusy)
    InvitationRules.Expire(state, now)
    if arenaBusy then return nil, "ArenaBusy" end
    if not validId(hostId) then return nil, "InvalidPlayer" end
    if now < InvitationRules.CooldownUntil(state, hostId) then return nil, "InviteCooldown" end
    local size = mode == "Duel" and 2 or (mode == "Teams" and 4 or nil)
    if not size or type(memberIds) ~= "table" or #memberIds ~= size or memberIds[1] ~= hostId then
        return nil, "InvalidMembers"
    end
    local seen, members = {}, {}
    for index = 1, size do
        local id = memberIds[index]
        if not validId(id) or seen[id] then return nil, "InvalidMembers" end
        if state.Reserved[id] then return nil, "PlayerBusy" end
        if not available(id) then return nil, "PlayerUnavailable" end
        seen[id], members[index] = true, id
    end
    state.Serial += 1
    local invite = {
        Id = "invite:" .. tostring(state.Serial), HostId = hostId, Mode = mode,
        Members = members, Accepted = { [hostId] = true }, ExpiresAt = now + state.ExpiresSeconds,
    }
    state.Invites[invite.Id] = invite
    for _, id in ipairs(members) do state.Reserved[id] = invite.Id end
    state.Cooldowns[hostId] = now + state.CooldownSeconds
    return invite, nil
end

function InvitationRules.Respond(state, userId, inviteId, accept, now)
    if type(inviteId) ~= "string" or #inviteId > 64 or type(accept) ~= "boolean" then
        return nil, "InvalidResponse", false
    end
    local invite = state.Invites[inviteId]
    if not invite or state.Reserved[userId] ~= inviteId or userId == invite.HostId then
        return nil, "UnknownInvite", false
    end
    if now >= invite.ExpiresAt then
        release(state, invite)
        return nil, "Expired", false
    end
    if not accept then
        release(state, invite)
        return invite, "Declined", false
    end
    invite.Accepted[userId] = true
    for _, id in ipairs(invite.Members) do
        if not invite.Accepted[id] then return invite, nil, false end
    end
    -- The caller consumes this result synchronously before yielding. Removing
    -- reservations here prevents an accepted invitation from becoming stale.
    release(state, invite)
    return invite, nil, true
end

function InvitationRules.Cancel(state, hostId, inviteId)
    if type(inviteId) ~= "string" or #inviteId > 64 then return false, "UnknownInvite" end
    local invite = state.Invites[inviteId]
    if not invite or invite.HostId ~= hostId then return false, "UnknownInvite" end
    release(state, invite)
    return true, nil
end

function InvitationRules.RemovePlayer(state, userId)
    local invite = InvitationRules.Get(state, userId)
    if invite then release(state, invite) end
    state.Cooldowns[userId] = nil
    return invite ~= nil
end

function InvitationRules.Clear(state)
    state.Invites, state.Reserved = {}, {}
end

return InvitationRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">MatchRules</string>
          <string name="Source"><![CDATA[-- Portable roster rules: no Roblox globals, clock, or side effects.
local MatchRules = {}

function MatchRules.New(teamOrder, teamSize)
    assert(type(teamOrder) == "table" and #teamOrder >= 2, "At least two teams are required")
    assert(type(teamSize) == "number" and teamSize >= 1 and teamSize % 1 == 0, "Invalid team size")
    local order, teams = {}, {}
    for _, teamId in ipairs(teamOrder) do
        assert(type(teamId) == "string" and not teams[teamId], "Invalid or duplicate team")
        teams[teamId] = true
        table.insert(order, teamId)
    end
    return { TeamOrder = order, TeamSize = teamSize, Members = {}, Teams = teams, Locked = false, Started = false }
end

function MatchRules.Get(roster, id)
    return roster.Members[id]
end

function MatchRules.Add(roster, id, teamId)
    if roster.Locked then return false, "Locked" end
    if id == nil or (type(id) == "number" and id ~= id) then return false, "InvalidId" end
    if roster.Members[id] then return false, "Duplicate" end
    if not roster.Teams[teamId] then return false, "UnknownTeam" end
    local count = 0
    for _, member in pairs(roster.Members) do
        if member.TeamId == teamId then count += 1 end
    end
    if count >= roster.TeamSize then return false, "TeamFull" end
    roster.Members[id] = { Id = id, TeamId = teamId, Ready = false, Eliminated = false }
    return true
end

function MatchRules.Lock(roster)
    if roster.Locked then return false, "AlreadyLocked" end
    local counts = {}
    for _, teamId in ipairs(roster.TeamOrder) do counts[teamId] = 0 end
    for _, member in pairs(roster.Members) do counts[member.TeamId] += 1 end
    for _, teamId in ipairs(roster.TeamOrder) do
        if counts[teamId] ~= roster.TeamSize then return false, "Incomplete" end
    end
    roster.Locked = true
    return true
end

function MatchRules.SetReady(roster, id, ready)
    local member = roster.Members[id]
    if not member then return false, "UnknownMember" end
    if roster.Started then return false, "Started" end
    if member.Eliminated then return false, "Eliminated" end
    member.Ready = ready == true
    return true
end

function MatchRules.IsReady(roster)
    if not roster.Locked then return false end
    for _, member in pairs(roster.Members) do
        if not member.Ready or member.Eliminated then return false end
    end
    return true
end

function MatchRules.Begin(roster)
    if roster.Started then return false, "AlreadyStarted" end
    if not MatchRules.IsReady(roster) then return false, "NotReady" end
    roster.Started = true
    return true
end

function MatchRules.Eliminate(roster, id)
    local member = roster.Members[id]
    if not member then return false, "UnknownMember" end
    if member.Eliminated then return false, "AlreadyEliminated" end
    member.Eliminated = true
    return true
end

function MatchRules.CountAlive(roster)
    local alive = {}
    for _, teamId in ipairs(roster.TeamOrder) do alive[teamId] = 0 end
    for _, member in pairs(roster.Members) do
        if not member.Eliminated then alive[member.TeamId] += 1 end
    end
    return alive
end

function MatchRules.Resolve(roster)
    if not roster.Started then return false, nil end
    local alive = MatchRules.CountAlive(roster)
    local remaining, winner = 0, nil
    for _, teamId in ipairs(roster.TeamOrder) do
        if alive[teamId] > 0 then
            remaining += 1
            winner = teamId
        end
    end
    if remaining > 1 then return false, nil end
    return true, winner
end

return MatchRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ProfileRules</string>
          <string name="Source"><![CDATA[-- Portable, synchronous profile rules. Only the server supplies the catalog,
-- reward values and match IDs; no client amount can enter these functions.
local Rules = {}
local MAX_INTEGER = 2147483647
local REWARD_HISTORY = 100

local function integer(value)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then return 0 end
    return math.max(0, math.min(MAX_INTEGER, math.floor(value)))
end

local function validId(value)
    return type(value) == "string" and #value > 0 and #value <= 128
end

function Rules.New(catalog)
    return {
        Version = 1, Coins = 0, OwnedSwords = { [catalog.DefaultSword] = true },
        EquippedSword = catalog.DefaultSword, FactionId = catalog.DefaultFaction,
        Wins = 0, Losses = 0, RewardedMatches = {}, RewardOrder = {},
    }
end

function Rules.Sanitize(raw, catalog)
    local profile = Rules.New(catalog)
    if type(raw) ~= "table" then return profile end
    profile.Coins, profile.Wins, profile.Losses = integer(raw.Coins), integer(raw.Wins), integer(raw.Losses)
    if type(raw.OwnedSwords) == "table" then
        for id in pairs(catalog.Swords) do
            if raw.OwnedSwords[id] == true then profile.OwnedSwords[id] = true end
        end
    end
    if validId(raw.EquippedSword) and profile.OwnedSwords[raw.EquippedSword] then
        profile.EquippedSword = raw.EquippedSword
    end
    if validId(raw.FactionId) and catalog.Factions[raw.FactionId] then profile.FactionId = raw.FactionId end
    -- Persist a bounded, ordered replay ledger. The service also deduplicates
    -- all matches for the lifetime of its server, without evicting old IDs.
    if type(raw.RewardOrder) == "table" and type(raw.RewardedMatches) == "table" then
        local start = math.max(1, #raw.RewardOrder - REWARD_HISTORY + 1)
        for index = start, #raw.RewardOrder do
            local id = raw.RewardOrder[index]
            if validId(id) and raw.RewardedMatches[id] == true and not profile.RewardedMatches[id] then
                profile.RewardedMatches[id] = true
                table.insert(profile.RewardOrder, id)
            end
        end
    end
    return profile
end

function Rules.Buy(profile, swordId, catalog)
    if not validId(swordId) or not catalog.Swords[swordId] then return false, "UnknownSword" end
    if profile.OwnedSwords[swordId] then return false, "AlreadyOwned" end
    local price = catalog.Swords[swordId].Price
    if type(price) ~= "number" or price < 0 or price % 1 ~= 0 or price > MAX_INTEGER then return false, "InvalidPrice" end
    if profile.Coins < price then return false, "InsufficientCoins" end
    profile.Coins -= price
    profile.OwnedSwords[swordId] = true
    return true
end

function Rules.Equip(profile, swordId, catalog)
    if not validId(swordId) or not catalog.Swords[swordId] then return false, "UnknownSword" end
    if not profile.OwnedSwords[swordId] then return false, "NotOwned" end
    profile.EquippedSword = swordId
    return true
end

function Rules.ChooseFaction(profile, factionId, catalog)
    if not validId(factionId) or not catalog.Factions[factionId] then return false, "UnknownFaction" end
    profile.FactionId = factionId
    return true
end

function Rules.Reward(profile, matchId, outcome, rewards)
    if not validId(matchId) then return false, "InvalidMatch" end
    if outcome ~= "Win" and outcome ~= "Loss" and outcome ~= "Draw" then return false, "InvalidOutcome" end
    local amount = rewards[outcome]
    if type(amount) ~= "number" or amount < 0 or amount % 1 ~= 0 or amount > MAX_INTEGER then return false, "InvalidReward" end
    if profile.RewardedMatches[matchId] then return false, "AlreadyRewarded" end
    profile.Coins = math.min(MAX_INTEGER, profile.Coins + amount)
    if outcome == "Win" then profile.Wins = math.min(MAX_INTEGER, profile.Wins + 1) end
    if outcome == "Loss" then profile.Losses = math.min(MAX_INTEGER, profile.Losses + 1) end
    profile.RewardedMatches[matchId] = true
    table.insert(profile.RewardOrder, matchId)
    if #profile.RewardOrder > REWARD_HISTORY then
        local oldest = table.remove(profile.RewardOrder, 1)
        profile.RewardedMatches[oldest] = nil
    end
    return true
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
