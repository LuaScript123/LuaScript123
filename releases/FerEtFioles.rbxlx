local character = player.Character
local humanoid
local deadAt
local snapshot
local worldSnapshot
local receivedAt = 0
local shiftHeld = {}
local touchSprintInput
local sprinting = false
local lastAttack = -math.huge
local toastId = 0
local markerId = 0
local compact = false
local deathConnection
local cameraWasSpectating = false
local spectatorTarget
local watchingName
local lobbyUI
local cameraLock = CameraLock.new(player)
local lockButton = button(root, "CAMÉRA\nLIBRE", {
	AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -330),
	Size = UDim2.fromOffset(85, 49), TextSize = 10, Visible = UserInputService.TouchEnabled,
})
lockButton.Activated:Connect(function() cameraLock:Toggle() end)

local function activity()
	return player:GetAttribute("Activity") or "Lobby"
end

local function menuOpen()
	return scoreboard.Visible or (lobbyUI ~= nil and lobbyUI:IsOpen())
end

local function alive()
	return character ~= nil and character.Parent ~= nil and humanoid ~= nil and humanoid.Health > 0
end

local function canAct()
	local activeSession = worldMode and activity() == "World" and character and character:GetAttribute("Combatant") == true
		or (not worldMode and activity() == "Battle" and snapshot ~= nil and snapshot.Phase == "Battle")
	return alive() and activeSession and not menuOpen()
		and player:GetAttribute("Spectating") ~= true and player:GetAttribute("Eliminated") ~= true
end

local function potionCooldown()
	local readyAt = character and character:GetAttribute("PotionReadyAt")
	if type(readyAt) ~= "number" then return 0 end
	return math.max(0, math.ceil(readyAt - workspace:GetServerTimeNow()))
end

local function setSprint(active)
	active = active and canAct() and true or false
	if sprinting == active then return end
	sprinting = active
	Action:FireServer("Sprint", { Active = active })
	sprintButton.BackgroundColor3 = active and Color3.fromRGB(95, 79, 45) or palette.Panel
end

local function releaseSprint()
	table.clear(shiftHeld)
	touchSprintInput = nil
	setSprint(false)
end

local function showToast(message)
	if type(message) ~= "string" or message == "" then return end
	toastId += 1
	local id = toastId
	toastText.Text = message
	toast.Visible = true
	task.delay(3.2, function()
		if toastId == id then toast.Visible = false end
	end)
end

local function attack()
	if not canAct() or UserInputService:GetFocusedTextBox() then return end
	local now = os.clock()
	if now - lastAttack < Config.Combat.AttackCooldown then return end
	lastAttack = now
	local camera = workspace.CurrentCamera
	local direction = camera and camera.CFrame.LookVector or Vector3.new(0, 0, -1)
	direction = Vector3.new(direction.X, 0, direction.Z)
	if direction.Magnitude < 0.01 then
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		direction = rootPart and rootPart.CFrame.LookVector or Vector3.new(0, 0, -1)
	end
	Action:FireServer("Attack", { Aim = direction.Unit })
end

local function drink(size)
	if canAct() and potionCooldown() == 0 and not UserInputService:GetFocusedTextBox() then
		Action:FireServer("Potion", { Size = size })
	end
end

for size, entry in pairs(potionButtons) do
	entry.Button.Activated:Connect(function() drink(size) end)
end
attackButton.Activated:Connect(attack)
sprintButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		touchSprintInput = input
		setSprint(true)
	end
end)

local function statValue(subject, name)
	local stats = subject:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild(name)
	return value and value.Value or 0
end

local function refreshScoreboard()
	for _, row in ipairs(scoreRows:GetChildren()) do
		if row:IsA("Frame") then row:Destroy() end
	end
	local allPlayers = Players:GetPlayers()
	table.sort(allPlayers, function(a, b)
		local aKills, bKills = statValue(a, "Kills"), statValue(b, "Kills")
		if aKills == bKills then return a.Name < b.Name end
		return aKills > bKills
	end)
	for index, subject in ipairs(allPlayers) do
		local team = Config.Teams[subject:GetAttribute("TeamId")]
		local row = create("Frame", {
			Size = UDim2.new(1, -5, 0, 39), BorderSizePixel = 0,
			BackgroundColor3 = subject == player and Color3.fromRGB(48, 49, 45) or palette.Inset,
			BackgroundTransparency = 0.15, LayoutOrder = index, ZIndex = 32,
		}, scoreRows)
		corners(row, 5)
		create("Frame", {
			Size = UDim2.new(0, 3, 1, -12), Position = UDim2.fromOffset(0, 6),
			BackgroundColor3 = team and rgb(team.Color) or palette.Muted, BorderSizePixel = 0, ZIndex = 33,
		}, row)
		label(row, subject.DisplayName .. (subject == player and " · vous" or ""), {
			Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.68, -18, 1, 0),
			TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 33,
		})
		label(row, tostring(statValue(subject, "Kills")), {
			Position = UDim2.new(0.68, 0, 0, 0), Size = UDim2.new(0.15, 0, 1, 0),
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 33,
		})
		label(row, tostring(statValue(subject, "Deaths")), {
			Position = UDim2.new(0.83, 0, 0, 0), Size = UDim2.new(0.17, -5, 1, 0),
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 33,
		})
	end
	scoreRows.CanvasSize = UDim2.fromOffset(0, rowLayout.AbsoluteContentSize.Y)
end

local function showScoreboard(visible)
	scoreboard.Visible = visible
	cameraLock:SetMenuOpen(menuOpen())
	if visible then releaseSprint() refreshScoreboard() end
end
scoresButton.Activated:Connect(function() showScoreboard(not scoreboard.Visible) end)
closeScores.Activated:Connect(function() showScoreboard(false) end)

if worldMode then
	local WorldUI = require(script.Parent:WaitForChild("WorldUI"))
	lobbyUI = WorldUI.new(player, root, Action, Config, function(open)
		if open then releaseSprint() end
		cameraLock:SetMenuOpen(open or scoreboard.Visible)
	end)
	World.OnClientEvent:Connect(function(state)
		if type(state) ~= "table" then return end
		worldSnapshot = state
		lobbyUI:SetWorld(state)
	end)
else
	lobbyUI = LobbyUI.new(player, root, Action, Config, Catalog, function(open)
		if open then releaseSprint() end
		cameraLock:SetMenuOpen(open or scoreboard.Visible)
	end)
	Lobby.OnClientEvent:Connect(function(lobby) lobbyUI:SetLobby(lobby) end)
	Profile.OnClientEvent:Connect(function(profile) lobbyUI:SetProfile(profile) end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		attack()
	elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		if menuOpen() then return end
		shiftHeld[input.KeyCode] = true
		setSprint(true)
	elseif input.KeyCode == Enum.KeyCode.Z then drink("Small")
	elseif input.KeyCode == Enum.KeyCode.X then drink("Medium")
	elseif input.KeyCode == Enum.KeyCode.C then drink("Large")
	elseif input.KeyCode == Enum.KeyCode.Tab then showScoreboard(true)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		shiftHeld[input.KeyCode] = nil
		setSprint(next(shiftHeld) ~= nil or touchSprintInput ~= nil)
	end
	if input == touchSprintInput then
		touchSprintInput = nil
		setSprint(next(shiftHeld) ~= nil)
	end
	if input.KeyCode == Enum.KeyCode.Tab then showScoreboard(false) end
end)
UserInputService.WindowFocusReleased:Connect(function()
	releaseSprint()
	showScoreboard(false)
end)
UserInputService.TextBoxFocused:Connect(releaseSprint)

local function bindCharacter(model)
	releaseSprint()
	if deathConnection then deathConnection:Disconnect() end
	character = model
	humanoid = nil
	deadAt = nil
	deathPanel.Visible = false
	lastAttack = -math.huge
	local found = model:WaitForChild("Humanoid", 10)
	if character ~= model or not found or not found:IsA("Humanoid") then return end
	humanoid = found
	local camera = workspace.CurrentCamera
	if camera and (activity() == "Lobby" or player:GetAttribute("Spectating") ~= true) then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = found
		cameraWasSpectating = false
		spectatorTarget = nil
		watchingName = nil
	end
	deathConnection = found.Died:Connect(function()
		deadAt = os.clock()
		releaseSprint()
		showScoreboard(false)
	end)
end
player.CharacterAdded:Connect(bindCharacter)
player.CharacterRemoving:Connect(function(model)
	if character == model then
		releaseSprint()
		character = nil
		humanoid = nil
	end
end)
if character then task.spawn(bindCharacter, character) end

local function layout()
	local viewport = root.AbsoluteSize
	compact = viewport.X < 900 or (UserInputService.TouchEnabled and viewport.X < 1200)
	local touch = UserInputService.TouchEnabled
	local narrowTouch = touch and viewport.X < 560
	heading.Visible = not compact
	teamLabel.Visible = not compact
	helpLabel.Visible = not touch and not compact
	attackButton.Visible = touch and activity() == "Battle"
	sprintButton.Visible = touch and activity() == "Battle"
	lockButton.Visible = touch
	lockButton.Position = UDim2.new(1, -26, 1, narrowTouch and -326 or -263)
	if worldMode and narrowTouch then
		lockButton.AnchorPoint = Vector2.new(1, 0)
		lockButton.Position = UDim2.new(1, -16, 0, 132)
		lockButton.Size = UDim2.fromOffset(65, 49)
	else
		lockButton.AnchorPoint = Vector2.new(1, 1)
		lockButton.Size = UDim2.fromOffset(85, 49)
	end
	scorePanel.Size = UDim2.fromOffset(math.min(compact and 390 or 460, viewport.X - 30), compact and 66 or 76)
	blueScore.TextSize = compact and 15 or 20
	redScore.TextSize = compact and 15 or 20
	phaseLabel.Position = UDim2.new(0, 10, 0, compact and 43 or 47)
	phaseLabel.TextSize = compact and 10 or 11
	scoresButton.Text = worldMode and (compact and "PLAYERS" or "PLAYERS · TAB") or (compact and "JOUEURS" or "JOUEURS · TAB")
	scoresButton.Size = UDim2.fromOffset(compact and 87 or 141, 33)
	scoresButton.Position = UDim2.new(1, -16, 0, compact and 88 or 23)
	vitals.Size = UDim2.fromOffset(compact and math.min(245, math.max(150, viewport.X - 120)) or 290, compact and 92 or 118)
	if compact then
		vitals.AnchorPoint = Vector2.new(0, 0)
		vitals.Position = UDim2.fromOffset(15, 88)
		staminaBar.Title.Position = UDim2.fromOffset(15, 48)
		staminaBar.Number.Position = UDim2.fromOffset(15, 48)
		staminaBar.Fill.Parent.Position = UDim2.fromOffset(15, 71)
		protectionLabel.Position = UDim2.fromOffset(17, 184)
	else
		vitals.AnchorPoint = Vector2.new(0, 0)
		vitals.Position = UDim2.new(0, 24, 1, -145)
		staminaBar.Title.Position = UDim2.fromOffset(15, 62)
		staminaBar.Number.Position = UDim2.fromOffset(15, 62)
		staminaBar.Fill.Parent.Position = UDim2.fromOffset(15, 85)
		protectionLabel.Position = UDim2.new(0, 25, 1, -171)
	end
	local slotWidth = narrowTouch and math.min(70, math.max(42, math.floor((viewport.X - 160) / 3))) or (compact and 75 or 94)
	hotbar.Size = UDim2.fromOffset((slotWidth + 8) * 3, 89)
	hotbar.AnchorPoint = Vector2.new(narrowTouch and 0 or 0.5, 1)
	hotbar.Position = UDim2.new(0.5, 0, 1, touch and -14 or -25)
	if narrowTouch then hotbar.Position = UDim2.new(0, 15, 1, -160) end
	attackButton.Position = UDim2.new(1, -26, 1, narrowTouch and -160 or -182)
	sprintButton.Position = UDim2.new(1, narrowTouch and -26 or -128, 1, narrowTouch and -247 or -164)
	for _, entry in pairs(potionButtons) do entry.Button.Size = UDim2.fromOffset(slotWidth, 89) end
	toast.Size = UDim2.fromOffset(math.min(390, viewport.X - 30), 42)
	toast.Position = UDim2.new(0.5, 0, 0, compact and 207 or 105)
	feed.Visible = not (compact and viewport.Y < 500)
	feed.Position = UDim2.new(1, -16, 0, viewport.X < 560 and 255 or (compact and 129 or 103))
	feed.Size = UDim2.fromOffset(compact and math.max(150, math.min(230, viewport.X - 285)) or 300, compact and 72 or 180)
	scoreboard.Size = UDim2.fromOffset(math.min(540, viewport.X - 30), math.min(410, viewport.Y - 40))
	deathPanel.Size = UDim2.fromOffset(math.min(360, viewport.X - 30), 114)
end
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(layout)
layout()

State.OnClientEvent:Connect(function(newState)
	if type(newState) ~= "table" then return end
	snapshot = newState
	receivedAt = os.clock()
	if not canAct() then releaseSprint() end
end)
for _, attribute in ipairs({ "Spectating", "Eliminated", "Activity" }) do
	player:GetAttributeChangedSignal(attribute):Connect(function()
		if not canAct() then releaseSprint() end
		if attribute == "Activity" then
			if not worldMode then lobbyUI:SetActivity(activity()) end
			if activity() == "Lobby" then
				deadAt = nil
				deathPanel.Visible = false
			end
			layout()
		end
	end)
end

local function updateSpectatorCamera()
	local camera = workspace.CurrentCamera
	if not camera then return end
	-- Lobby players always keep their own physical character and camera.
	local spectator = activity() ~= "Lobby" and (player:GetAttribute("Spectating") == true
		or player:GetAttribute("Eliminated") == true or (deadAt ~= nil and not alive()))
	cameraLock:SetSpectating(spectator)
	if not spectator then
		if cameraWasSpectating and humanoid and humanoid.Health > 0 then
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = humanoid
		end
		cameraWasSpectating = false
		spectatorTarget = nil
		watchingName = nil
		return
	end
	cameraWasSpectating = true
	local allied, others = {}, {}
	local teamId = player:GetAttribute("TeamId")
	for _, model in ipairs(workspace:GetDescendants()) do
		if model:IsA("Model") and model ~= character and model:GetAttribute("Combatant") == true
			and (worldMode or (snapshot and model:GetAttribute("MatchRound") == snapshot.Round)) then
			local targetHumanoid = model:FindFirstChildOfClass("Humanoid")
			if targetHumanoid and targetHumanoid.Health > 0 and model:FindFirstChild("HumanoidRootPart") then
				local list = teamId ~= nil and model:GetAttribute("TeamId") == teamId and allied or others
				table.insert(list, model)
			end
		end
	end
	local candidates = #allied > 0 and allied or others
	if not table.find(candidates, spectatorTarget) then
		table.sort(candidates, function(a, b) return a.Name < b.Name end)
		spectatorTarget = candidates[1]
	end
	if spectatorTarget then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = spectatorTarget:FindFirstChildOfClass("Humanoid")
		local targetPlayer = Players:GetPlayerFromCharacter(spectatorTarget)
		watchingName = targetPlayer and targetPlayer.DisplayName or spectatorTarget.Name
	else
		-- With no survivors, keep a clear overview until the next characters are spawned.
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 55, 70), Vector3.new(0, 4, 0))
		watchingName = nil
	end
end

local effectFolder = Instance.new("Folder")
effectFolder.Name = "LocalBattleEffects"
effectFolder.Parent = workspace
local activeEffects = 0
local function effectPart(color, cframe, size, duration, expand)
	if activeEffects >= 70 then return end
	activeEffects += 1
	local part = create("Part", {
		Name = "BattleSpark", Anchored = true, CanCollide = false, CanTouch = false,
		CanQuery = false, CastShadow = false, Material = Enum.Material.Neon,
		Color = color, Size = size, CFrame = cframe, Transparency = 0.15,
	}, effectFolder)
	local target = { Transparency = 1 }
	if expand then target.Size = size * expand end
	TweenService:Create(part, TweenInfo.new(duration), target):Play()
	Debris:AddItem(part, duration + 0.05)
	task.delay(duration + 0.06, function() activeEffects -= 1 end)
	return part
end

local function effectPosition(data)
	if typeof(data.Position) == "Vector3" then return data.Position end
	local model = data.Target or data.Actor
	if typeof(model) == "Instance" and model:IsA("Model") then
		local part = model:FindFirstChild("HumanoidRootPart")
		if part then return part.Position end
	end
	return nil
end

Effects.OnClientEvent:Connect(function(kind, data)
	if type(data) ~= "table" then return end
	if kind == "Toast" then
		showToast(data.Text)
	elseif kind == "Killfeed" then
		if activity() == "Lobby" then return end
		feedOrder += 1
		local line = label(feed, tostring(data.Killer or "Un combattant") .. "  >  " .. tostring(data.Victim or "un adversaire"), {
			Size = UDim2.new(1, 0, 0, 23), BackgroundColor3 = palette.Inset,
			TextSize = compact and 10 or 12, TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = -feedOrder,
		})
		line.BackgroundTransparency = 0.15
		corners(line, 4)
		Debris:AddItem(line, 5)
		local lines = {}
		for _, child in ipairs(feed:GetChildren()) do
			if child:IsA("TextLabel") then table.insert(lines, child) end
		end
		table.sort(lines, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		for index = compact and 3 or 6, #lines do lines[index]:Destroy() end
	elseif kind == "Swing" then
		local actor = data.Actor
		local rootPart = typeof(actor) == "Instance" and actor:FindFirstChild("HumanoidRootPart")
		if not rootPart then return end
		local forward = typeof(data.Direction) == "Vector3" and data.Direction or rootPart.CFrame.LookVector
		forward = Vector3.new(forward.X, 0, forward.Z)
		if forward.Magnitude < 0.01 then return end
		forward = forward.Unit
		local right = forward:Cross(Vector3.yAxis)
		local center = rootPart.Position + Vector3.new(0, 0.6, 0)
		local team = Config.Teams[actor:GetAttribute("TeamId")]
		local color = team and rgb(team.Color) or palette.Gold
		for segment = 0, 5 do
			local side = data.Side == -1 and -1 or 1
			local a = math.rad((-55 + segment * 18) * side)
			local b = math.rad((-55 + (segment + 1) * 18) * side)
			local p1 = center + (forward * math.cos(a) + right * math.sin(a)) * 3.8
			local p2 = center + (forward * math.cos(b) + right * math.sin(b)) * 3.8
			task.delay(segment * 0.014, function()
				effectPart(color, CFrame.lookAt((p1 + p2) / 2, p2), Vector3.new(0.07, 0.07, (p2 - p1).Magnitude), 0.2)
			end)
		end
	elseif kind == "Hit" then
		local position = effectPosition(data)
		if position then
			local spark = effectPart(palette.Gold, CFrame.new(position + Vector3.new(0, 1, 0)), Vector3.new(0.4, 0.4, 0.4), 0.19, 2)
			if spark then spark.Shape = Enum.PartType.Ball end
		end
		if data.Actor == character then
			markerId += 1
			local id = markerId
			hitMarker.Text = tostring(data.Damage or Config.Combat.AttackDamage)
			task.delay(0.5, function() if id == markerId then hitMarker.Text = "" end end)
		end
		if data.Target == character then
			damageFlash.BackgroundTransparency = 0.86
			TweenService:Create(damageFlash, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
		end
	elseif kind == "Potion" then
		local position = effectPosition(data)
		if not position then return end
		local potion = Config.Potions[data.Size] or Config.Potions.Small
		for index = 1, 5 do
			local angle = index * math.pi * 0.4
			local p = position + Vector3.new(math.cos(angle) * 1.3, 0.4 + index * 0.25, math.sin(angle) * 1.3)
			local spark = effectPart(rgb(potion.Color), CFrame.new(p), Vector3.new(0.23, 0.23, 0.23), 0.65, 0.4)
			if spark then
				spark.Shape = Enum.PartType.Ball
				TweenService:Create(spark, TweenInfo.new(0.65), { Position = p + Vector3.new(0, 2, 0) }):Play()
			end
		end
	end
end)

local updateElapsed = 0
local scoreElapsed = 0
local cameraElapsed = 0
RunService.Heartbeat:Connect(function(dt)
	updateElapsed += dt
	scoreElapsed += dt
	cameraElapsed += dt
	if cameraElapsed >= 0.3 then
		cameraElapsed = 0
		updateSpectatorCamera()
	end
	if scoreElapsed > 1 and scoreboard.Visible then
		scoreElapsed = 0
		refreshScoreboard()
	end
	if updateElapsed < 0.08 then return end
	updateElapsed = 0
	lobbyUI:Step()
	cameraLock:SetMenuOpen(menuOpen())
	lockButton.Text = cameraLock.Enabled and "CAMÉRA\nVERROUILLÉE" or "CAMÉRA\nLIBRE"
	local inLobby = activity() == "Lobby"
	scorePanel.Visible = not inLobby and not worldMode
	vitals.Visible = not inLobby
	hotbar.Visible = not inLobby
	attackButton.Visible = UserInputService.TouchEnabled and not inLobby
	sprintButton.Visible = UserInputService.TouchEnabled and not inLobby
	helpLabel.Visible = not compact and not UserInputService.TouchEnabled and not inLobby
	feed.Visible = not inLobby and not worldMode and not (compact and root.AbsoluteSize.Y < 500)
	local maxHealth = humanoid and humanoid.MaxHealth or Config.Player.MaxHealth
	local health = humanoid and math.max(0, humanoid.Health) or 0
	local maxStamina = character and character:GetAttribute("MaxStamina") or Config.Combat.MaxStamina
	local stamina = character and character:GetAttribute("Stamina") or maxStamina
	maxStamina = math.max(1, maxStamina)
	healthBar.Number.Text = string.format("%d / %d", math.ceil(health), maxHealth)
	healthBar.Fill.Size = UDim2.fromScale(math.clamp(health / math.max(1, maxHealth), 0, 1), 1)
	healthBar.Fill.BackgroundColor3 = health <= maxHealth * 0.25 and palette.Danger or palette.Health
	staminaBar.Number.Text = string.format("%d / %d", math.floor(stamina + 0.5), maxStamina)
	staminaBar.Fill.Size = UDim2.fromScale(math.clamp(stamina / maxStamina, 0, 1), 1)
	staminaBar.Fill.BackgroundColor3 = stamina < Config.Combat.AttackCost and palette.Danger or palette.Gold
	staminaBar.Title.Text = worldMode
		and (character and character:GetAttribute("Sprinting") and "STAMINA · SPRINTING" or "STAMINA")
		or (character and character:GetAttribute("Sprinting") and "ENDURANCE · COURSE" or "ENDURANCE")
	protectionLabel.Visible = not inLobby and alive() and character:GetAttribute("SpawnProtected") == true
	local actionable = canAct()
	if worldMode then
		local serverNow = workspace:GetServerTimeNow()
		local regenAt = character and character:GetAttribute("HealthRegenReadyAt")
		healthBar.Title.Text = health < maxHealth and health > 0 and type(regenAt) == "number" and serverNow >= regenAt
			and "HEALTH · RECOVERING" or "HEALTH"
		local attackAt = character and character:GetAttribute("AttackReadyAt")
		local cooldown = type(attackAt) == "number" and math.max(0, attackAt - serverNow) or 0
		swingStatus.Visible = actionable
		swingStatus.Text = cooldown > 0 and string.format("SWING · %.1f s", cooldown) or "SWORD READY"
	end
	local remainingCooldown = potionCooldown()
	attackButton.Interactable = actionable
	sprintButton.Interactable = actionable
	attackButton.AutoButtonColor = actionable
	sprintButton.AutoButtonColor = actionable
	for size, entry in pairs(potionButtons) do
		local count = character and character:GetAttribute("Potions" .. size)
		if type(count) ~= "number" then count = Config.Potions[size].Count end
		local available = actionable and count > 0 and remainingCooldown == 0
		entry.Count.Text = "×" .. count
		entry.Button.BackgroundColor3 = available and palette.Panel or palette.Inset
		entry.Button.Interactable = available
		entry.Button.AutoButtonColor = available
		entry.Count.TextColor3 = available and palette.Text or palette.Muted
		entry.Cooldown.Visible = remainingCooldown > 0
		entry.Cooldown.Text = tostring(remainingCooldown) .. " s"
	end
	local team = Config.Teams[player:GetAttribute("TeamId")]
	teamLabel.Text = worldMode and (team and ("Kingdom · " .. team.Name) or "Choose your kingdom")
		or (inLobby and "Lobby · combats sur invitation" or (team and ("Votre équipe · " .. team.Name) or "Combat en cours"))
	teamLabel.TextColor3 = team and rgb(team.Color) or palette.Muted
	local dead = humanoid ~= nil and humanoid.Health <= 0
	if dead and not deadAt then deadAt = os.clock() end
	local eliminated = not inLobby and (player:GetAttribute("Eliminated") == true or (deadAt ~= nil and not alive()))
	local spectating = not inLobby and player:GetAttribute("Spectating") == true
	deathPanel.Visible = not worldMode and (eliminated or spectating)
	crosshair.Visible = actionable
	if eliminated or spectating then
		deathTitle.Text = eliminated and (worldMode and "FALLEN IN BATTLE" or "ÉLIMINÉ") or "SPECTATEUR"
		if worldMode then
			local readyAt = worldSnapshot and worldSnapshot.RespawnAt
			local seconds = type(readyAt) == "number" and math.max(0, math.ceil(readyAt - workspace:GetServerTimeNow())) or 0
			respawnLabel.Text = seconds > 0 and ("Returning to your kingdom in " .. seconds .. " s") or "Preparing your next life…"
		else
			respawnLabel.Text = (watchingName and ("Vous regardez " .. watchingName .. ".\n") or "")
				.. "Retour au lobby à la fin du combat."
		end
	end
	if snapshot and not inLobby then
		local scores = snapshot.Scores or {}
		local survivors = snapshot.Alive or {}
		local teamSize = snapshot.TeamSize or Config.Game.TeamSize or 2
		blueScore.Text = "BLEUS  " .. tostring(survivors.Dawn or 0) .. "/" .. teamSize
		redScore.Text = tostring(survivors.Ember or 0) .. "/" .. teamSize .. "  ROUGES"
		blueWins.Text = tostring(scores.Dawn or 0) .. ((scores.Dawn or 0) > 1 and " VICTOIRES" or " VICTOIRE")
		redWins.Text = tostring(scores.Ember or 0) .. ((scores.Ember or 0) > 1 and " VICTOIRES" or " VICTOIRE")
		local elapsedSinceState = os.clock() - receivedAt
		local seconds
		if snapshot.Phase == "Battle" then
			seconds = math.max(0, math.floor((tonumber(snapshot.Elapsed) or 0) + elapsedSinceState))
		else
			seconds = math.max(0, math.ceil((tonumber(snapshot.TimeLeft) or 0) - elapsedSinceState))
		end
		timerLabel.Text = string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
		if snapshot.Phase == "Results" then
			local winner = Config.Teams[snapshot.Winner]
			phaseLabel.Text = "COMBAT TERMINÉ · RETOUR AU LOBBY"
			deathPanel.Visible = true
			deathTitle.Text = winner and (snapshot.Winner == player:GetAttribute("TeamId") and "VICTOIRE !" or "DÉFAITE") or "FIN DU COMBAT"
			local message = type(snapshot.Message) == "string" and snapshot.Message ~= "" and snapshot.Message
				or (winner and ("Les " .. winner.Name .. " remportent le combat.") or "Le combat est terminé.")
			respawnLabel.Text = message .. "\nRetour au lobby dans " .. seconds .. " s."
		elseif snapshot.Phase == "Preparing" then
			phaseLabel.Text = "PRÉPARATION · " .. tostring(teamSize) .. " CONTRE " .. tostring(teamSize)
			deathPanel.Visible = true
			deathTitle.Text = "PRÉPAREZ-VOUS"
			respawnLabel.Text = "Chargement des combattants…\nPréparation · " .. seconds .. " s restantes."
		else
			phaseLabel.Text = tostring(teamSize) .. " CONTRE " .. tostring(teamSize) .. " · DERNIÈRE ÉQUIPE EN VIE"
		end
	end
end)

Action:FireServer("Ready", {})
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">LobbyUI</string>
            <string name="Source"><![CDATA[-- Presentation only: invitations, ownership and every purchase are validated by the server.
local UserInputService = game:GetService("UserInputService")
local LobbyUI = {}
LobbyUI.__index = LobbyUI

local colors = {
	Panel = Color3.fromRGB(25, 29, 34), Inset = Color3.fromRGB(13, 17, 21),
	Text = Color3.fromRGB(245, 236, 217), Muted = Color3.fromRGB(177, 181, 184),
	Gold = Color3.fromRGB(222, 181, 99), Stroke = Color3.fromRGB(101, 91, 72),
	Blue = Color3.fromRGB(75, 151, 222), Red = Color3.fromRGB(218, 91, 65),
}
local function create(kind, properties, parent)
	local object = Instance.new(kind)
	for key, value in pairs(properties) do object[key] = value end
	object.Parent = parent
	return object
end
local function round(object)
	create("UICorner", { CornerRadius = UDim.new(0, 8) }, object)
end
local function label(parent, text, height, color)
	return create("TextLabel", {
		Size = UDim2.new(1, -4, 0, height or 26), BackgroundTransparency = 1,
		Text = text, TextColor3 = color or colors.Text, Font = Enum.Font.GothamMedium,
		TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 42,
	}, parent)
end
local function button(parent, text, callback, properties)
	local props = {
		Size = UDim2.new(1, -4, 0, 38), BackgroundColor3 = colors.Inset,
		BorderSizePixel = 0, Text = text, TextColor3 = colors.Text, Font = Enum.Font.GothamBold,
		TextSize = 13, AutoButtonColor = true, ZIndex = 43,
	}
	for key, value in pairs(properties or {}) do props[key] = value end
	local object = create("TextButton", props, parent)
	round(object)
	object.Activated:Connect(callback)
	return object
end
local function row(parent, height)
	return create("Frame", { Size = UDim2.new(1, -4, 0, height), BackgroundTransparency = 1, ZIndex = 42 }, parent)
end
local function rgb(values)
	return Color3.fromRGB(values[1], values[2], values[3])
end
local function validId(value)
	return type(value) == "number" and value ~= 0 and value % 1 == 0
end

function LobbyUI.new(player, root, action, config, catalog, onMenuChanged)
	local self = setmetatable({
		Player = player, Root = root, Action = action, Config = config, Catalog = catalog,
		OnMenuChanged = onMenuChanged, Activity = player:GetAttribute("Activity") or "Lobby",
		Open = false, Tab = "PvP", Mode = "Duel", Role = "OpponentUserId", Selection = {},
		Lobby = { Players = {} }, Profile = {}, TimerLabels = {}, RenderKey = nil,
		PendingProfileUntil = 0, SendUntil = 0,
	}, LobbyUI)
	self.Header = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(450, 58), BackgroundColor3 = colors.Panel,
		BackgroundTransparency = 0.06, BorderSizePixel = 0, ZIndex = 35,
	}, root)
	round(self.Header)
	self.Coins = label(self.Header, "LOBBY · chargement du profil…", 44, colors.Gold)
	self.Coins.Position = UDim2.fromOffset(13, 7)
	self.Coins.Size = UDim2.new(1, -151, 0, 44)
	self.Toggle = button(self.Header, "MENU PvP", function() self:SetOpen(not self.Open) end, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(123, 36), ZIndex = 36,
	})
	self.Window = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(660, 535), BackgroundColor3 = colors.Panel,
		BackgroundTransparency = 0.025, BorderSizePixel = 0, Visible = false, ZIndex = 40,
	}, root)
	round(self.Window)
	create("UIStroke", { Color = colors.Stroke, Thickness = 1 }, self.Window)
	local title = label(self.Window, "FER & FIOLES · LE LOBBY", 28, colors.Gold)
	title.Position = UDim2.fromOffset(18, 12)
	title.Size = UDim2.new(1, -78, 0, 28)
	self.Close = button(self.Window, "×", function() self:SetOpen(false) end, {
		Position = UDim2.new(1, -48, 0, 10), Size = UDim2.fromOffset(34, 34), TextSize = 22,
	})
	self.Tabs = {}
	for i, name in ipairs({ "PvP", "Boutique", "Factions" }) do
		self.Tabs[name] = button(self.Window, name, function()
			self.Tab = name
			self:Render()
		end, { Position = UDim2.new((i - 1) / 3, 14, 0, 52), Size = UDim2.new(1 / 3, -20, 0, 35) })
	end
	self.Body = create("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 100), Size = UDim2.new(1, -32, 1, -144),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
		ScrollBarImageColor3 = colors.Gold, AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 41,
	}, self.Window)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, self.Body)
	self.Footer = label(self.Window, "Ferme le menu pour viser · Ctrl : verrouillage caméra", 30, colors.Muted)
	self.Footer.Position = UDim2.new(0, 17, 1, -37)
	self.Footer.Size = UDim2.new(1, -34, 0, 30)
	local function layout()
		local size = root.AbsoluteSize
		self.Header.Size = UDim2.fromOffset(math.min(450, math.max(270, size.X - 24)), 58)
		self.Window.Size = UDim2.fromOffset(math.min(660, size.X - 24), math.min(535, math.max(220, size.Y - 91)))
		self.Window.Position = UDim2.new(0.5, 0, 0, 79 + self.Window.Size.Y.Offset / 2)
		self.Footer.Text = UserInputService.TouchEnabled and "Ferme le menu pour explorer le lobby." or "Ferme le menu pour viser · Ctrl : caméra · Maj : courir"
	end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	layout()
	self:SetActivity(self.Activity)
	return self
end

function LobbyUI:IsOpen()
	return self.Open and self.Activity == "Lobby"
end

function LobbyUI:SetOpen(open)
	self.Open = open == true and self.Activity == "Lobby"
	self.Window.Visible = self.Open
	self.Toggle.Text = self.Open and "FERMER" or "MENU PvP"
	if self.OnMenuChanged then self.OnMenuChanged(self.Open) end
	if self.Open then self:Render() end
end

function LobbyUI:SetActivity(activity)
	local previous = self.Activity
	self.Activity = activity or "Lobby"
	self.Header.Visible = self.Activity == "Lobby"
	if self.Activity ~= "Lobby" then
		self:SetOpen(false)
	elseif previous ~= "Lobby" then
		self.Selection = {}
		self:SetOpen(false)
	end
end

function LobbyUI:SetLobby(snapshot)
	if type(snapshot) ~= "table" then return end
	local oldIncoming = self.Lobby.Incoming
	self.Lobby = snapshot
	-- Stable identity lets the countdown update without rebuilding a scrolling menu every second.
	local parts = { tostring(snapshot.ArenaBusy) }
	for _, subject in ipairs(snapshot.Players or {}) do
		table.insert(parts, tostring(subject.UserId) .. tostring(subject.Name) .. tostring(subject.Activity) .. tostring(subject.Busy) .. tostring(subject.FactionId))
	end
	for _, invite in pairs({ snapshot.Incoming or false, snapshot.Outgoing or false }) do
		if type(invite) == "table" then
			table.insert(parts, tostring(invite.Id))
			for _, member in ipairs(invite.Members or {}) do table.insert(parts, tostring(member.Name) .. tostring(member.Accepted)) end
		end
	end
	local key = table.concat(parts, "|")
	if key ~= self.RenderKey then self.RenderKey = key self:Render() end
	if snapshot.Incoming and (not oldIncoming or oldIncoming.Id ~= snapshot.Incoming.Id) and self.Activity == "Lobby" then
		self.Tab = "PvP"
		self:SetOpen(true)
	end
end

function LobbyUI:SetProfile(profile)
	if type(profile) ~= "table" then return end
	self.Profile = profile
	self.PendingProfileUntil = 0
	self:Render()
end

function LobbyUI:_profileAction(action, payload)
	if self.Activity ~= "Lobby" or self.Profile.Loaded ~= true or workspace:GetServerTimeNow() < self.PendingProfileUntil then return end
	self.PendingProfileUntil = workspace:GetServerTimeNow() + 1
	self.Action:FireServer(action, payload)
	self:Step()
end

function LobbyUI:_personName(id)
	for _, subject in ipairs(self.Lobby.Players or {}) do
		if subject.UserId == id then return subject.DisplayName or subject.Name or tostring(id) end
	end
	return "Choisir un joueur"
end

function LobbyUI:_renderInvite(invite, incoming)
	label(self.Body, incoming and ("DEMANDE DE " .. tostring(invite.HostName or "combat")) or "DEMANDE ENVOYÉE", 24, colors.Gold)
	local timer = label(self.Body, "", 22, colors.Muted)
	table.insert(self.TimerLabels, { Label = timer, ExpiresAt = invite.ExpiresAt })
	for _, member in ipairs(invite.Members or {}) do
		local team = self.Config.Teams[member.TeamId]
		label(self.Body, (member.Accepted and "✓ " or "… ") .. tostring(member.Name or "Joueur") .. " · " .. (team and team.Name or ""), 23,
			team and rgb(team.Color) or colors.Text)
	end
	if incoming then
		local accepted = false
		for _, member in ipairs(invite.Members or {}) do
			if member.UserId == self.Player.UserId or member.Name == self.Player.Name then accepted = member.Accepted == true end
		end
		local controls = row(self.Body, 38)
		local accept = button(controls, accepted and "ACCEPTÉ · EN ATTENTE" or "ACCEPTER", function()
			self.Action:FireServer("InviteRespond", { InviteId = invite.Id, Accept = true })
		end, { Size = UDim2.new(0.5, -4, 1, 0), TextColor3 = colors.Gold })
		accept.Interactable = not accepted
		button(controls, "REFUSER", function()
			self.Action:FireServer("InviteRespond", { InviteId = invite.Id, Accept = false })
		end, { Position = UDim2.new(0.5, 4, 0, 0), Size = UDim2.new(0.5, -8, 1, 0) })
	else
		button(self.Body, "ANNULER LA DEMANDE", function()
			self.Action:FireServer("InviteCancel", { InviteId = invite.Id })
		end)
	end
	label(self.Body, "Tous les joueurs doivent accepter pour lancer le combat.", 32, colors.Muted)
end

function LobbyUI:_renderPvP()
	local lobby = self.Lobby
	if lobby.Incoming or lobby.Outgoing then self:_renderInvite(lobby.Incoming or lobby.Outgoing, lobby.Incoming ~= nil) return end
	label(self.Body, "Invite des joueurs du lobby. Une vie, l'épée seule, sans parade ni coup de pied.", 38, colors.Muted)
	local modes = row(self.Body, 37)
	for index, mode in ipairs({ "Duel", "Teams" }) do
		button(modes, mode == "Duel" and "DUEL · 1 CONTRE 1" or "ÉQUIPES · 2 CONTRE 2", function()
			self.Mode = mode
			self.Role = mode == "Teams" and "AllyUserId" or "OpponentUserId"
			self.Selection = {}
			self:Render()
		end, { Position = UDim2.new((index - 1) * 0.5, index == 1 and 0 or 4, 0, 0),
			Size = UDim2.new(0.5, -5, 1, 0), TextColor3 = self.Mode == mode and colors.Gold or colors.Muted })
	end
	local roles = self.Mode == "Teams" and {
		{ "AllyUserId", "TON ALLIÉ · BLEUS", colors.Blue },
		{ "OpponentUserId", "ADVERSAIRE 1 · ROUGES", colors.Red },
		{ "OpponentAllyUserId", "ADVERSAIRE 2 · ROUGES", colors.Red },
	} or { { "OpponentUserId", "TON ADVERSAIRE", colors.Red } }
	for _, role in ipairs(roles) do
		local key, title, color = role[1], role[2], role[3]
		button(self.Body, (self.Role == key and "▶ " or "") .. title .. " : " .. self:_personName(self.Selection[key]), function()
			self.Role = key
			self:Render()
		end, { TextColor3 = color, TextTruncate = Enum.TextTruncate.AtEnd })
	end
	label(self.Body, "JOUEURS DISPONIBLES · clique pour remplir la place sélectionnée", 33, colors.Gold)
	local count = 0
	for _, subject in ipairs(lobby.Players or {}) do
		if subject.UserId ~= self.Player.UserId and subject.Activity == "Lobby" and not subject.Busy and validId(subject.UserId) then
			count += 1
			local selected
			for _, role in ipairs(roles) do if self.Selection[role[1]] == subject.UserId then selected = role[2] end end
			local displayName = subject.DisplayName or subject.Name or tostring(subject.UserId)
			local text = displayName .. (subject.Name and "  @" .. subject.Name or "") .. (selected and "  · " .. selected or "")
			button(self.Body, text, function()
				for role, id in pairs(self.Selection) do if id == subject.UserId then self.Selection[role] = nil end end
				self.Selection[self.Role] = subject.UserId
				for _, role in ipairs(roles) do if not self.Selection[role[1]] then self.Role = role[1] break end end
				self:Render()
			end, { TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = selected and colors.Gold or colors.Text })
		end
	end
	if count == 0 then label(self.Body, "Aucun autre joueur disponible. Invite tes amis à rejoindre ce serveur.", 48, colors.Muted) end
	self.Status = label(self.Body, "", 36, colors.Muted)
	self.Send = button(self.Body, "ENVOYER LA DEMANDE", function()
		if not self:_canInvite() then return end
		local payload = { Mode = self.Mode, OpponentUserId = self.Selection.OpponentUserId }
		if self.Mode == "Teams" then
			payload.AllyUserId = self.Selection.AllyUserId
			payload.OpponentAllyUserId = self.Selection.OpponentAllyUserId
		end
		self.SendUntil = workspace:GetServerTimeNow() + 1
		self.Action:FireServer("Invite", payload)
		self:Step()
	end, { TextColor3 = colors.Gold })
	label(self.Body, "Demandes : délai de " .. self.Config.Invites.CooldownSeconds .. " s · expiration après " .. self.Config.Invites.ExpiresSeconds .. " s.", 32, colors.Muted)
end

function LobbyUI:_renderShop()
	label(self.Body, "ÉPÉES COSMÉTIQUES · Toutes infligent les mêmes dégâts et ont la même portée.", 40, colors.Gold)
	label(self.Body, "Victoire : +" .. self.Config.Rewards.Win .. " pièces · défaite : +" .. self.Config.Rewards.Loss .. " · aucun gain sur abandon.", 34, colors.Muted)
	local profile = self.Profile
	for _, id in ipairs(self.Catalog.SwordOrder) do
		local sword = self.Catalog.Swords[id]
		local card = row(self.Body, 74)
		card.BackgroundColor3 = colors.Inset
		card.BackgroundTransparency = 0.1
		round(card)
		-- Original stylized blade preview; no downloaded assets are needed.
		create("Frame", { Position = UDim2.fromOffset(23, 10), Size = UDim2.fromOffset(7, 39),
			BackgroundColor3 = rgb(sword.Blade), BorderSizePixel = 0, Rotation = 14, ZIndex = 43 }, card)
		create("Frame", { Position = UDim2.fromOffset(12, 45), Size = UDim2.fromOffset(24, 5),
			BackgroundColor3 = rgb(sword.Guard), BorderSizePixel = 0, Rotation = 14, ZIndex = 43 }, card)
		create("Frame", { Position = UDim2.fromOffset(21, 49), Size = UDim2.fromOffset(6, 15),
			BackgroundColor3 = rgb(sword.Accent), BorderSizePixel = 0, Rotation = 14, ZIndex = 43 }, card)
		local title = label(card, sword.Name .. "\n" .. sword.Price .. " pièces", 58)
		title.Position = UDim2.fromOffset(51, 8)
		title.Size = UDim2.new(1, -180, 0, 58)
		local owned = profile.OwnedSwords and profile.OwnedSwords[id] == true
		local equipped = profile.EquippedSword == id
		local choice = button(card, equipped and "ÉQUIPÉE" or (owned and "ÉQUIPER" or "ACHETER"), function()
			self:_profileAction(owned and "EquipSword" or "BuySword", { SwordId = id })
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
			Size = UDim2.fromOffset(112, 39), BackgroundColor3 = colors.Panel,
			TextColor3 = equipped and colors.Gold or colors.Text })
		table.insert(self.ProfileButtons, { Button = choice, Allowed = not equipped and (owned or (tonumber(profile.Coins) or 0) >= sword.Price) })
	end
end

function LobbyUI:_renderFactions()
	label(self.Body, "CHOISIS TA FACTION · Armure visuelle gratuite, sans avantage de combat.", 42, colors.Gold)
	for _, id in ipairs(self.Catalog.FactionOrder) do
		local faction = self.Catalog.Factions[id]
		local card = row(self.Body, 82)
		card.BackgroundColor3 = colors.Inset
		card.BackgroundTransparency = 0.1
		round(card)
		local swatch = create("Frame", { Position = UDim2.fromOffset(13, 18), Size = UDim2.fromOffset(26, 43),
			BackgroundColor3 = rgb(faction.Color), BorderSizePixel = 0, ZIndex = 43 }, card)
		round(swatch)
		create("UIStroke", { Color = rgb(faction.Trim), Thickness = 2 }, swatch)
		local title = label(card, faction.Name .. "\n" .. faction.Description, 68)
		title.Position = UDim2.fromOffset(53, 7)
		title.Size = UDim2.new(1, -181, 0, 68)
		local selected = self.Profile.FactionId == id
		local choice = button(card, selected and "CHOISIE" or "CHOISIR", function()
			self:_profileAction("ChooseFaction", { FactionId = id })
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
			Size = UDim2.fromOffset(112, 39), BackgroundColor3 = colors.Panel,
			TextColor3 = selected and colors.Gold or colors.Text })
		table.insert(self.ProfileButtons, { Button = choice, Allowed = not selected })
	end
	label(self.Body, "Les clans et leur classement arriveront plus tard.", 36, colors.Muted)
end

function LobbyUI:Render()
	for _, child in ipairs(self.Body:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
	self.TimerLabels = {}
	self.ProfileButtons = {}
	self.Status, self.Send = nil, nil
	for name, tab in pairs(self.Tabs) do tab.TextColor3 = self.Tab == name and colors.Gold or colors.Muted end
	if self.Profile.Loaded ~= true then
		label(self.Body, self.Profile.SaveMode == "Unavailable" and "Profil indisponible : les achats et les invitations sont temporairement bloqués." or "Chargement du profil… Tu peux explorer le lobby en fermant ce menu.", 54, colors.Muted)
	elseif self.Profile.SaveMode == "Session" then
		label(self.Body, "Mode session : tes pièces et choix ne seront pas conservés après avoir quitté ce serveur.", 42, colors.Muted)
	end
	if self.Tab == "Boutique" then self:_renderShop()
	elseif self.Tab == "Factions" then self:_renderFactions()
	else self:_renderPvP() end
	self:Step()
end

function LobbyUI:_inviteReason()
	if self.Profile.Loaded ~= true then return "Le profil doit être chargé avant de lancer un combat." end
	if self.Lobby.ArenaBusy then return "L'arène est occupée. Attends la fin du combat en cours." end
	local cooldown = math.ceil((tonumber(self.Lobby.InviteCooldownUntil) or 0) - workspace:GetServerTimeNow())
	if cooldown > 0 then return "Nouvelle invitation dans " .. cooldown .. " s." end
	if workspace:GetServerTimeNow() < self.SendUntil then return "Envoi de la demande…" end
	local ids = { self.Player.UserId }
	for _, key in ipairs(self.Mode == "Teams" and { "AllyUserId", "OpponentUserId", "OpponentAllyUserId" } or { "OpponentUserId" }) do
		local id = self.Selection[key]
		if not validId(id) or table.find(ids, id) then return "Choisis " .. (self.Mode == "Teams" and "trois joueurs différents" or "un adversaire") .. " dans la liste." end
		local available = false
		for _, subject in ipairs(self.Lobby.Players or {}) do
			if subject.UserId == id and subject.Activity == "Lobby" and not subject.Busy then available = true break end
		end
		if not available then return "Un joueur sélectionné n'est plus disponible." end
		table.insert(ids, id)
	end
	return nil
end

function LobbyUI:_canInvite()
	return self.Activity == "Lobby" and not self.Lobby.Incoming and not self.Lobby.Outgoing and self:_inviteReason() == nil
end

function LobbyUI:Step()
	local profile = self.Profile
	local coins = tonumber(profile.Coins) or self.Player:GetAttribute("Coins") or 0
	self.Coins.Text = "LOBBY · " .. tostring(coins) .. " pièces" .. (profile.Loaded ~= true and "\nChargement du profil…" or "\nCombats sur invitation")
	for _, timer in ipairs(self.TimerLabels) do
		local remaining = math.max(0, math.ceil((tonumber(timer.ExpiresAt) or 0) - workspace:GetServerTimeNow()))
		timer.Label.Text = "Expiration dans " .. remaining .. " s · " .. ((self.Lobby.Incoming or self.Lobby.Outgoing or {}).Mode == "Teams" and "2 contre 2" or "1 contre 1")
	end
	if self.Send then
		local reason = self:_inviteReason()
		self.Status.Text = reason or "Prêt à envoyer : chaque joueur devra accepter."
		self.Send.Interactable = reason == nil
		self.Send.AutoButtonColor = reason == nil
		self.Send.TextTransparency = reason and 0.45 or 0
	end
	local profileReady = profile.Loaded == true and workspace:GetServerTimeNow() >= self.PendingProfileUntil and self.Activity == "Lobby"
	for _, entry in ipairs(self.ProfileButtons or {}) do
		entry.Button.Interactable = profileReady and entry.Allowed
		entry.Button.AutoButtonColor = entry.Button.Interactable
		entry.Button.TextTransparency = entry.Button.Interactable and 0 or 0.4
	end
	if not self.Open and self.Lobby.Incoming then self.Toggle.Text = "INVITATION !" end
end

return LobbyUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">WorldUI</string>
            <string name="Source"><![CDATA[-- Local presentation and input only; the server validates allegiance, range, costs and ownership.
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local WorldUI = {}
WorldUI.__index = WorldUI

local colors = {
	Panel = Color3.fromRGB(24, 29, 34), Inset = Color3.fromRGB(13, 18, 22),
	Text = Color3.fromRGB(245, 237, 219), Muted = Color3.fromRGB(173, 182, 188),
	Gold = Color3.fromRGB(224, 183, 103), Border = Color3.fromRGB(106, 93, 67),
	Danger = Color3.fromRGB(230, 117, 96), Green = Color3.fromRGB(133, 190, 151),
}

local function create(kind, properties, parent)
	local object = Instance.new(kind)
	for key, value in pairs(properties) do object[key] = value end
	object.Parent = parent
	return object
end

local function round(object, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, object)
end

local function panel(parent, properties)
	properties.BackgroundColor3 = properties.BackgroundColor3 or colors.Panel
	properties.BorderSizePixel = 0
	properties.Active = true
	local object = create("Frame", properties, parent)
	round(object)
	create("UIStroke", { Color = colors.Border, Thickness = 1, Transparency = 0.2 }, object)
	return object
end

local function label(parent, text, properties)
	local props = {
		BackgroundTransparency = 1, BorderSizePixel = 0, Text = text,
		TextColor3 = colors.Text, TextSize = 13, Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = (parent.ZIndex or 1) + 1,
	}
	for key, value in pairs(properties or {}) do props[key] = value end
	return create("TextLabel", props, parent)
end

local function button(parent, text, callback, properties)
	local props = {
		BackgroundColor3 = colors.Inset, BorderSizePixel = 0, Text = text,
		TextColor3 = colors.Text, Font = Enum.Font.GothamBold, TextSize = 12,
		AutoButtonColor = true, Active = true, ZIndex = (parent.ZIndex or 1) + 2,
	}
	for key, value in pairs(properties or {}) do props[key] = value end
	local object = create("TextButton", props, parent)
	round(object, 6)
	object.Activated:Connect(callback)
	return object
end

local function enabled(object, allowed)
	object.Interactable = allowed
	object.AutoButtonColor = allowed
	object.TextTransparency = allowed and 0 or 0.5
end

local function rgb(value)
	if type(value) ~= "table" then return colors.Muted end
	return Color3.fromRGB(value[1] or 173, value[2] or 182, value[3] or 188)
end

local function amount(value)
	return math.max(0, math.floor(tonumber(value) or 0))
end

local function remaining(deadline, now)
	return math.max(0, math.ceil((tonumber(deadline) or 0) - now))
end

function WorldUI.new(player, root, action, config, onMenuChanged)
	local self = setmetatable({
		Player = player, Root = root, Action = action, Config = config,
		OnMenuChanged = onMenuChanged, Open = false, HasSnapshot = false,
		Snapshot = { Inventory = {}, Kingdoms = {}, Outposts = {}, Nodes = {} },
		Connections = {}, KingdomRows = {}, OutpostRows = {}, SummaryRows = {},
		SendUntil = 0, HarvestReadyAt = 0, NearestNode = nil, NearbyOutpost = nil,
	}, WorldUI)

	self.Header = panel(root, {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(452, 68), ZIndex = 34,
	})
	self.Allegiance = label(self.Header, "KINGDOMS", {
		Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -132, 0, 23),
		TextColor3 = colors.Gold, TextSize = 16, Font = Enum.Font.GothamBold,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	self.Resources = label(self.Header, "WOOD  0     ORE  0", {
		Position = UDim2.fromOffset(14, 37), Size = UDim2.new(1, -132, 0, 20), TextSize = 12,
	})
	self.Toggle = button(self.Header, "KINGDOMS · M", function() self:SetOpen(not self.Open) end, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(111, 42),
	})

	self.FlagPanel = panel(root, {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 96),
		Size = UDim2.fromOffset(244, 142), ZIndex = 32,
	})
	label(self.FlagPanel, "THE FRONTIER", {
		Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 20),
		Font = Enum.Font.GothamBold, TextColor3 = colors.Gold, TextSize = 12,
	})

	self.HarvestPanel = panel(root, {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -148),
		Size = UDim2.fromOffset(340, 66), Visible = false, ZIndex = 33,
	})
	self.HarvestTitle = label(self.HarvestPanel, "", {
		Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -116, 0, 22),
		Font = Enum.Font.GothamBold, TextSize = 13,
	})
	self.HarvestInfo = label(self.HarvestPanel, "", {
		Position = UDim2.fromOffset(12, 33), Size = UDim2.new(1, -116, 0, 23),
		TextSize = 11, TextColor3 = colors.Muted, TextWrapped = true,
	})
	self.HarvestButton = button(self.HarvestPanel, "HARVEST · E", function() self:_harvest() end, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
		Size = UDim2.fromOffset(98, 46), TextSize = 11,
	})
	self.BuildPanel = panel(root, {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -222),
		Size = UDim2.fromOffset(340, 64), Visible = false, ZIndex = 33,
	})
	self.BuildTitle = label(self.BuildPanel, "", {
		Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -116, 0, 23),
		Font = Enum.Font.GothamBold, TextTruncate = Enum.TextTruncate.AtEnd,
	})
	self.BuildInfo = label(self.BuildPanel, "", {
		Position = UDim2.fromOffset(12, 33), Size = UDim2.new(1, -116, 0, 20),
		TextSize = 11, TextColor3 = colors.Muted,
	})
	self.BuildButton = button(self.BuildPanel, "BUILD", function()
		local point = self.NearbyOutpost
		if point then self:_send("BuildOutpost", { OutpostId = point.Id }) end
	end, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
		Size = UDim2.fromOffset(98, 44), TextColor3 = colors.Gold,
	})

	self.DeathPanel = panel(root, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.43),
		Size = UDim2.fromOffset(330, 76), Visible = false, ZIndex = 39,
	})
	self.DeathTitle = label(self.DeathPanel, "", {
		Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 24),
		TextSize = 17, Font = Enum.Font.GothamBold, TextColor3 = colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	self.DeathInfo = label(self.DeathPanel, "", {
		Position = UDim2.fromOffset(12, 41), Size = UDim2.new(1, -24, 0, 20),
		TextColor3 = colors.Muted, TextXAlignment = Enum.TextXAlignment.Center,
	})

	self.Scrim = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(5, 8, 11),
		BackgroundTransparency = 0.26, BorderSizePixel = 0, Active = true,
		Visible = false, ZIndex = 40,
	}, root)
	self.Window = panel(self.Scrim, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(590, 570), ZIndex = 41,
	})
	self.Title = label(self.Window, "PLEDGE YOUR ALLEGIANCE", {
		Position = UDim2.fromOffset(18, 12), Size = UDim2.new(1, -75, 0, 28),
		TextColor3 = colors.Gold, TextSize = 18, Font = Enum.Font.GothamBold,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	self.Close = button(self.Window, "×", function() self:SetOpen(false) end, {
		Position = UDim2.new(1, -49, 0, 10), Size = UDim2.fromOffset(35, 35), TextSize = 23,
	})
	self.Subtitle = label(self.Window, "", {
		Position = UDim2.fromOffset(18, 45), Size = UDim2.new(1, -36, 0, 40),
		TextColor3 = colors.Muted, TextSize = 12, TextWrapped = true,
	})
	self.Body = create("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 94), Size = UDim2.new(1, -32, 1, -138),
		BackgroundTransparency = 1, BorderSizePixel = 0, Active = true,
		ScrollBarThickness = 4, ScrollBarImageColor3 = colors.Gold,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 42,
	}, self.Window)
	create("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }, self.Body)
	self.Footer = label(self.Window, "", {
		Position = UDim2.new(0, 18, 1, -37), Size = UDim2.new(1, -36, 0, 29),
		TextColor3 = colors.Muted, TextSize = 11, TextWrapped = true,
	})
	self:_createKingdomRows()
	self.CaptureHeading = label(self.Body, "FLAGS & OUTPOSTS", {
		Size = UDim2.new(1, -8, 0, 26), TextColor3 = colors.Gold,
		Font = Enum.Font.GothamBold, LayoutOrder = 20,
	})
	self.BaseButton = button(self.Body, "RESPAWN AT KINGDOM BASE", function()
		self:_send("SetOutpostSpawn", { OutpostId = "" })
	end, { Size = UDim2.new(1, -8, 0, 40), LayoutOrder = 21 })
	label(self.Body, "Stand alone with your kingdom at a flag to capture it. Enemy kingdoms contest the claim. Build an owned outpost to unlock a forward respawn.", {
		Size = UDim2.new(1, -8, 0, 64), LayoutOrder = 90, TextWrapped = true,
		TextColor3 = colors.Muted, TextSize = 12,
	})
	label(self.Body, "Wood, ore, flag ownership and outposts belong to this server session.", {
		Size = UDim2.new(1, -8, 0, 35), LayoutOrder = 91,
		TextColor3 = colors.Muted, TextWrapped = true, TextSize = 11,
	})

	local function layout()
		local size = root.AbsoluteSize
		local width = math.max(240, size.X - 24)
		self.Header.Size = UDim2.fromOffset(math.min(452, width), 68)
		self.Window.Size = UDim2.fromOffset(math.min(590, width), math.max(190, math.min(620, size.Y - 24)))
		self.HarvestPanel.Size = UDim2.fromOffset(math.min(340, width), 66)
		self.BuildPanel.Size = UDim2.fromOffset(math.min(340, width), 64)
		self.DeathPanel.Size = UDim2.fromOffset(math.min(330, width), 76)
		local compact = size.X < 900 or (UserInputService.TouchEnabled and size.X < 1200)
		self.Compact = compact
		self.NarrowTouch = UserInputService.TouchEnabled and size.X < 560
		self.ShortViewport = size.Y < 500
		self.HarvestPanel.AnchorPoint = self.ShortViewport and not self.NarrowTouch and Vector2.new(0, 1) or Vector2.new(0.5, 1)
		if self.ShortViewport and not self.NarrowTouch then
			self.HarvestPanel.Size = UDim2.fromOffset(math.min(300, width), 66)
		end
		self.FlagPanel.Position = compact and UDim2.new(1, -12, 0, 94) or UDim2.new(1, -24, 0, 96)
		self.FlagPanel.Size = UDim2.fromOffset(compact and math.min(215, width) or 244, 142)
		self.HarvestPanel.Position = self.NarrowTouch and UDim2.new(0.5, 0, 0, 264)
			or (self.ShortViewport and UDim2.new(0, 15, 1, -116))
			or UDim2.new(0.5, 0, 1, size.Y < 480 and -116 or -148)
		self.BuildPanel.Position = UDim2.new(0.5, 0, 1, size.Y < 480 and -190 or -222)
	end
	table.insert(self.Connections, root:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout))
	table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode == Enum.KeyCode.M then self:SetOpen(not self.Open)
		elseif input.KeyCode == Enum.KeyCode.E and not self.Open then self:_harvest() end
	end))
	local elapsed = 0
	table.insert(self.Connections, RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed < 0.1 then return end
		elapsed = 0
		self:Step()
	end))
	layout()
	self:SetOpen(true)
	self:Step()
	return self
end

function WorldUI:_kingdom(id)
	for _, kingdom in ipairs(self.Snapshot.Kingdoms or {}) do
		if kingdom.Id == id then return kingdom end
	end
	return self.Config.Kingdoms[id]
end

function WorldUI:_kingdomName(id)
	local kingdom = id and self:_kingdom(id)
	return kingdom and kingdom.Name or "Neutral"
end

function WorldUI:_kingdomColor(id)
	local kingdom = id and self:_kingdom(id)
	return kingdom and rgb(kingdom.Color) or colors.Muted
end

function WorldUI:_createKingdomRows()
	for index, id in ipairs(self.Config.KingdomOrder) do
		local kingdom = self.Config.Kingdoms[id]
		local card = panel(self.Body, {
			Size = UDim2.new(1, -8, 0, 66), BackgroundColor3 = colors.Inset,
			LayoutOrder = index, ZIndex = 43,
		})
		create("Frame", {
			Position = UDim2.fromOffset(0, 10), Size = UDim2.new(0, 3, 1, -20),
			BackgroundColor3 = rgb(kingdom.Color), BorderSizePixel = 0, ZIndex = 44,
		}, card)
		local name = label(card, kingdom.Name, {
			Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -142, 0, 23),
			TextColor3 = rgb(kingdom.Color), Font = Enum.Font.GothamBold,
			TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local population = label(card, "", {
			Position = UDim2.fromOffset(14, 35), Size = UDim2.new(1, -142, 0, 20),
			TextColor3 = colors.Muted, TextSize = 12,
		})
		local choose = button(card, "JOIN KINGDOM", function()
			self:_send("ChooseKingdom", { KingdomId = id })
		end, {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(114, 40), BackgroundColor3 = colors.Panel,
		})
		self.KingdomRows[id] = { Name = name, Population = population, Button = choose }
	end
end

function WorldUI:_createOutpostRows(points)
	for _, row in pairs(self.OutpostRows) do row.Card:Destroy() end
	for _, row in ipairs(self.SummaryRows) do row.Card:Destroy() end
	self.OutpostRows, self.SummaryRows = {}, {}
	for index, point in ipairs(points) do
		local id = point.Id
		local card = panel(self.Body, {
			Size = UDim2.new(1, -8, 0, 137), BackgroundColor3 = colors.Inset,
			LayoutOrder = 30 + index, ZIndex = 43,
		})
		local title = label(card, point.Name or id, {
			Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 22),
			Font = Enum.Font.GothamBold, TextSize = 14,
		})
		local status = label(card, "", {
			Position = UDim2.fromOffset(12, 34), Size = UDim2.new(1, -24, 0, 20), TextSize = 12,
		})
		local track = create("Frame", {
			Position = UDim2.fromOffset(12, 61), Size = UDim2.new(1, -24, 0, 4),
			BackgroundColor3 = colors.Panel, BorderSizePixel = 0, ZIndex = 44,
		}, card)
		local fill = create("Frame", {
			Size = UDim2.fromScale(0, 1), BackgroundColor3 = colors.Gold,
			BorderSizePixel = 0, ZIndex = 45,
		}, track)
		local info = label(card, "", {
			Position = UDim2.fromOffset(12, 76), Size = UDim2.new(1, -150, 0, 48),
			TextWrapped = true, TextColor3 = colors.Muted, TextSize = 11,
		})
		local choice = button(card, "", function()
			local current = self:_outpost(id)
			if not current or current.Owner ~= self.Snapshot.KingdomId then return end
			self:_send(current.Built and "SetOutpostSpawn" or "BuildOutpost", { OutpostId = id })
		end, {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, 102),
			Size = UDim2.fromOffset(127, 42), BackgroundColor3 = colors.Panel,
		})
		self.OutpostRows[id] = { Card = card, Name = title, Status = status, Fill = fill, Info = info, Button = choice }
		local summary = create("Frame", {
			Position = UDim2.fromOffset(12, 33 + (index - 1) * 33),
			Size = UDim2.new(1, -24, 0, 29), BackgroundTransparency = 1, ZIndex = 33,
		}, self.FlagPanel)
		local name = label(summary, "", { Size = UDim2.new(1, 0, 0, 17), TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd })
		local meter = create("Frame", {
			Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = colors.Inset, BorderSizePixel = 0, ZIndex = 34,
		}, summary)
		local meterFill = create("Frame", {
			Size = UDim2.fromScale(0, 1), BackgroundColor3 = colors.Gold, BorderSizePixel = 0, ZIndex = 35,
		}, meter)
		table.insert(self.SummaryRows, { Card = summary, Id = id, Name = name, Fill = meterFill })
	end
	self.FlagPanel.Size = UDim2.new(self.FlagPanel.Size.X.Scale, self.FlagPanel.Size.X.Offset, 0, 40 + #points * 33)
end

function WorldUI:_outpost(id)
	for _, point in ipairs(self.Snapshot.Outposts or {}) do if point.Id == id then return point end end
	return nil
end

function WorldUI:_send(action, payload)
	local now = workspace:GetServerTimeNow()
	if not self.HasSnapshot or now < self.SendUntil then return false end
	self.SendUntil = now + 0.25
	self.Action:FireServer(action, payload)
	self:Step()
	return true
end

function WorldUI:_livingRoot()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid and humanoid.Health > 0 and root or nil
end

function WorldUI:_harvest()
	if self.Open or not self.Snapshot.KingdomId or not self:_livingRoot() then return end
	local now = workspace:GetServerTimeNow()
	if not self.NearestNode or now < self.HarvestReadyAt then return end
	local nodeId = self.NearestNode.Id
	-- Use the latest local position for the prompt. Server positions and sightlines decide acceptance.
	self:Step()
	if not self.NearestNode or self.NearestNode.Id ~= nodeId then return end
	if self:_send("Harvest", { NodeId = nodeId }) then
		self.HarvestReadyAt = now + self.Config.World.HarvestCooldown
		self:Step()
	end
end

function WorldUI:IsOpen()
	return self.Open
end

function WorldUI:SetOpen(open)
	open = open == true or not self.Snapshot.KingdomId
	local changed = self.Open ~= open
	self.Open = open
	self.Scrim.Visible = open
	self.Toggle.Text = open and "CLOSE · M" or "KINGDOMS · M"
	if changed and self.OnMenuChanged then self.OnMenuChanged(open) end
	self:Step()
end

function WorldUI:SetWorld(snapshot)
	if type(snapshot) ~= "table" then return end
	local previousKingdom = self.Snapshot.KingdomId
	self.Snapshot = snapshot
	self.HasSnapshot = true
	local ids = {}
	for _, point in ipairs(snapshot.Outposts or {}) do table.insert(ids, point.Id) end
	local key = table.concat(ids, "|")
	if key ~= self.OutpostKey then
		self.OutpostKey = key
		self:_createOutpostRows(snapshot.Outposts or {})
	end
	if not snapshot.KingdomId then self:SetOpen(true)
	elseif not previousKingdom then self:SetOpen(false) end
	self:Step()
end

function WorldUI:Step()
	local now = workspace:GetServerTimeNow()
	local state, world = self.Snapshot, self.Config.World
	local kingdomId = state.KingdomId
	local inventory = state.Inventory or {}
	local wood, ore = amount(inventory.Wood), amount(inventory.Ore)
	local root = self:_livingRoot()
	local ready = self.HasSnapshot and now >= self.SendUntil
	local kingdomWait = remaining(state.KingdomChangeReadyAt, now)
	local respawnWait = remaining(state.RespawnAt, now)
	local dead = kingdomId ~= nil and (respawnWait > 0 or not root)
	local affordable = wood >= world.OutpostWoodCost and ore >= world.OutpostOreCost
	self.Allegiance.Text = kingdomId and string.upper(self:_kingdomName(kingdomId)) or "CHOOSE A KINGDOM"
	self.Allegiance.TextColor3 = kingdomId and self:_kingdomColor(kingdomId) or colors.Gold
	self.Toggle.Text = not kingdomId and "CHOOSE" or (self.Open and "CLOSE · M" or "KINGDOMS · M")
	self.Resources.Text = "WOOD  " .. wood .. "     ORE  " .. ore
	self.Title.Text = kingdomId and "KINGDOMS & THE FRONTIER" or "PLEDGE YOUR ALLEGIANCE"
	self.Subtitle.Text = not self.HasSnapshot and "Connecting to the world…"
		or (not kingdomId and "Choose your kingdom, gather resources and claim the frontier. Your kingdom determines your allies and base."
		or (kingdomWait > 0 and "Kingdom change available in " .. kingdomWait .. "s. Leave combat before changing allegiance."
		or "Changing allegiance returns you to your new base. Leave combat before changing kingdoms."))
	self.Close.Visible = kingdomId ~= nil
	self.Footer.Text = kingdomId and (UserInputService.TouchEnabled and "Tap HARVEST near a tree or mine. Close this menu to wield your sword."
		or "M: close menu   ·   E: harvest nearby resources   ·   Stand at flags to capture")
		or "Select a kingdom to enter the world."
	for id, row in pairs(self.KingdomRows) do
		local kingdom = self:_kingdom(id)
		local selected = id == kingdomId
		local count = amount(kingdom and kingdom.Players)
		row.Population.Text = count .. (count == 1 and " player" or " players") .. (selected and " · your kingdom" or "")
		row.Button.Text = selected and "ALLEGIANCE" or (kingdomWait > 0 and kingdomWait .. "s" or "JOIN KINGDOM")
		row.Button.TextColor3 = selected and colors.Gold or colors.Text
		enabled(row.Button, ready and not selected and kingdomWait == 0 and not dead)
	end

	local selectedSpawn = state.SpawnOutpostId and self:_outpost(state.SpawnOutpostId)
	local spawnName = selectedSpawn and selectedSpawn.Owner == kingdomId and selectedSpawn.Built and selectedSpawn.Name or "kingdom base"
	local forwardSpawn = type(state.SpawnOutpostId) == "string" and state.SpawnOutpostId ~= ""
	self.BaseButton.Text = forwardSpawn and "RESET RESPAWN TO KINGDOM BASE" or "RESPAWN: KINGDOM BASE"
	self.BaseButton.TextColor3 = forwardSpawn and colors.Text or colors.Gold
	enabled(self.BaseButton, ready and kingdomId ~= nil and not dead and state.SpawnOutpostId ~= nil and state.SpawnOutpostId ~= "")
	self.DeathPanel.Visible = dead and not self.Open
	self.DeathTitle.Text = respawnWait > 0 and "RETURNING IN " .. respawnWait .. "s" or "RETURNING TO BATTLE…"
	self.DeathInfo.Text = "Respawn: " .. tostring(spawnName)
	-- The complete flag list remains in the menu; keep small viewports clear for vitals and touch controls.
	self.FlagPanel.Visible = kingdomId ~= nil and not self.Open and not self.Compact

	local nearestBuild, buildDistance = nil, math.huge
	for _, point in ipairs(state.Outposts or {}) do
		local row = self.OutpostRows[point.Id]
		local owned = kingdomId ~= nil and point.Owner == kingdomId
		local distance = root and typeof(point.Position) == "Vector3" and (point.Position - root.Position).Magnitude or math.huge
		local progress = math.clamp(tonumber(point.Progress) or 0, 0, 1)
		local color = point.Contested and colors.Danger or self:_kingdomColor(point.Claimant or point.Owner)
		local status = point.Contested and "CONTESTED — capture paused"
			or (point.Claimant and (self:_kingdomName(point.Claimant) .. " claiming · " .. math.floor(progress * 100) .. "%")
			or (self:_kingdomName(point.Owner) .. (point.Built and " · fortified" or " · flag")))
		if row then
			row.Name.Text = point.Name or point.Id
			row.Status.Text, row.Status.TextColor3 = status, color
			row.Fill.Size = UDim2.fromScale(point.Claimant and progress or (point.Owner and 1 or 0), 1)
			row.Fill.BackgroundColor3 = color
			row.Info.Text = owned and (point.Built and "An allied outpost. Select it as your next respawn."
				or ("Build: " .. world.OutpostWoodCost .. " wood + " .. world.OutpostOreCost .. " ore\n" .. (distance <= world.BuildRange and "Within building range" or "Move within " .. world.BuildRange .. " studs")))
				or (point.Owner and "Capture the flag for your kingdom to use this outpost." or "Stand at this flag to claim it for your kingdom.")
			local selected = state.SpawnOutpostId == point.Id
			row.Button.Text = not owned and "CAPTURE FLAG" or (point.Built and (selected and "RESPAWN SET" or "SET RESPAWN") or "BUILD OUTPOST")
			row.Button.TextColor3 = selected and colors.Gold or colors.Text
			enabled(row.Button, ready and owned and not dead and not selected and (point.Built or (not point.Contested and distance <= world.BuildRange and affordable)))
		end
		if owned and not point.Built and distance <= world.BuildRange and distance < buildDistance then
			nearestBuild, buildDistance = point, distance
		end
	end
	for _, row in ipairs(self.SummaryRows) do
		local point = self:_outpost(row.Id)
		if point then
			local progress = math.clamp(tonumber(point.Progress) or 0, 0, 1)
			row.Name.Text = (point.Name or point.Id) .. " · " .. (point.Contested and "CONTESTED" or self:_kingdomName(point.Owner))
			row.Name.TextColor3 = point.Contested and colors.Danger or self:_kingdomColor(point.Owner)
			row.Fill.Size = UDim2.fromScale(point.Claimant and progress or (point.Owner and 1 or 0), 1)
			row.Fill.BackgroundColor3 = point.Contested and colors.Danger or self:_kingdomColor(point.Claimant or point.Owner)
		end
	end
	self.NearbyOutpost = nearestBuild
	self.BuildPanel.Visible = nearestBuild ~= nil and not self.Open and not dead and not self.NarrowTouch and not self.ShortViewport
	if nearestBuild then
		self.BuildTitle.Text = nearestBuild.Name or nearestBuild.Id
		self.BuildInfo.Text = nearestBuild.Contested and "Contested: clear enemy claimants"
			or (world.OutpostWoodCost .. " wood + " .. world.OutpostOreCost .. " ore")
		self.BuildInfo.TextColor3 = affordable and colors.Green or colors.Muted
		enabled(self.BuildButton, ready and affordable and not dead and not nearestBuild.Contested)
	end

	local closest, closestDistance, live, liveDistance = nil, math.huge, nil, math.huge
	if kingdomId and root then
		for _, node in ipairs(state.Nodes or {}) do
			if typeof(node.Position) == "Vector3" then
				local distance = (node.Position - root.Position).Magnitude
				if distance < closestDistance then closest, closestDistance = node, distance end
				if amount(node.HitsRemaining) > 0 and distance <= world.HarvestRange and distance < liveDistance then
					live, liveDistance = node, distance
				end
			end
		end
	end
	self.NearestNode = live
	local shown = live or closest
	local distance = live and liveDistance or closestDistance
	self.HarvestPanel.Visible = shown ~= nil and distance <= world.HarvestRange + 10 and not self.Open and not dead
	if shown then
		local hits = amount(shown.HitsRemaining)
		local tree = shown.Kind == "Tree"
		local nodeConfig = tree and world.Tree or world.Mine
		self.HarvestTitle.Text = (tree and "CHOP TREE" or "MINE ORE") .. " · " .. math.floor(distance) .. " studs"
		self.HarvestInfo.Text = hits == 0 and ("Returns in " .. remaining(shown.RespawnAt, now) .. "s")
			or (not live and "Move closer to harvest" or (hits .. " hits left · +" .. nodeConfig.Yield .. (tree and " wood" or " ore") .. " on depletion"))
		local wait = remaining(self.HarvestReadyAt, now)
		self.HarvestButton.Text = wait > 0 and "READY IN " .. wait .. "s" or (UserInputService.TouchEnabled and "HARVEST" or "HARVEST · E")
		enabled(self.HarvestButton, live ~= nil and ready and wait == 0 and not dead)
	end
end

function WorldUI:Destroy()
	for _, connection in ipairs(self.Connections) do connection:Disconnect() end
	for _, object in ipairs({ self.Header, self.FlagPanel, self.HarvestPanel, self.BuildPanel, self.DeathPanel, self.Scrim }) do object:Destroy() end
	if self.Open and self.OnMenuChanged then self.OnMenuChanged(false) end
end

return WorldUI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
